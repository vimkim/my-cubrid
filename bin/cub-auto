#!/usr/bin/env sh
set -eu

# Wrapper: auto-add -S for `cubrid <command> <db>` only when that DB server isn't running.

dbname="${2:-}"

for argument in "$@"; do
  case "$argument" in
    -S|-C|--SA-mode|--CS-mode) exec cubrid "$@" ;;
  esac
done

# Correct running check: status lists all servers; look for "Server <dbname> (...)".
out="$(cubrid server status)"

if printf '%s\n' "$out" | awk -v name="$dbname" \
    '($1 == "Server" || $1 == "HA-Server") && $2 == name { found=1 } END { exit !found }'; then
  exec cubrid "$@"
else
  exec cubrid "$@" -S
fi
