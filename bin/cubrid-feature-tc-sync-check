#!/usr/bin/env bash

set -euo pipefail

usage ()
{
  cat <<'EOF_USAGE'
Usage: cubrid-feature-tc-sync-check [--pr N] [--check] <feature/NAME>

Find the open CUBRID/cubrid pull request that merges feature/NAME into
develop, then check that its tc/pr-N branch matches feature/NAME in both
CUBRID testcase repositories. If tc/pr-N is strictly behind, offer to
fast-forward and push it without force.

  --pr N   use PR N instead of looking it up with gh
  --check  report only; never prompt or push. Exit 0 only when both
           repositories are synced.

This is a wrapper for:
  cubrid-pr-tc-sync-check feature/NAME tc/pr-N

Environment overrides (primarily useful for testing):
  CUBRID_TESTCASES_DIR
  CUBRID_TESTCASES_PRIVATE_EX_DIR
EOF_USAGE
}

die ()
{
  printf 'error: %s\n' "$*" >&2
  exit 1
}

feature_pr_number ()
{
  local feature="$1"
  local numbers

  # Restrict to heads in CUBRID/cubrid so a fork branch of the same name
  # cannot select another pull request.
  numbers="$(gh pr list --repo CUBRID/cubrid --head "$feature" --base develop \
    --state open --json number,headRepositoryOwner \
    --jq '[.[] | select(.headRepositoryOwner.login == "CUBRID") | .number] | join(" ")')" \
    || die "cannot list CUBRID/cubrid pull requests with gh"

  case "$numbers" in
    "") die "no open CUBRID/cubrid PR merges $feature into develop; use --pr N" ;;
    *" "*) die "several open PRs merge $feature into develop ($numbers); use --pr N" ;;
  esac
  printf '%s\n' "$numbers"
}

main ()
{
  local pr=""
  local -a sync_args=()

  while [[ $# -gt 0 ]]
  do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --pr)
        [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] \
          || { printf 'error: --pr needs a positive integer\n' >&2; exit 2; }
        pr="$2"
        shift 2
        ;;
      --check) sync_args+=(--check); shift ;;
      -*) usage >&2; exit 2 ;;
      *) break ;;
    esac
  done

  [[ $# -eq 1 && "$1" =~ ^feature/[^[:space:]]+$ ]] || {
    usage >&2
    exit 2
  }

  local feature="$1"
  [[ -n "$pr" ]] || pr="$(feature_pr_number "$feature")"
  printf 'PR #%s: develop <- %s; tc/pr-%s must match %s.\n' \
    "$pr" "$feature" "$pr" "$feature"

  local script_dir
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  exec "$script_dir/cubrid-pr-tc-sync-check" "${sync_args[@]}" "$feature" "tc/pr-$pr"
}

main "$@"
