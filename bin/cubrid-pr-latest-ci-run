#!/usr/bin/env python3
"""Print the latest current-head gha-ci run ID for a GitHub pull request."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from datetime import datetime, timezone
import json
import re
import subprocess
import sys
from urllib.parse import urlsplit


PR_PATH_RE = re.compile(r"^/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/pull/([1-9][0-9]*)/?$")


class UserError(RuntimeError):
    """An error that can be shown without a traceback."""


@dataclass(frozen=True)
class PullRequest:
    owner: str
    repository: str
    number: int

    @property
    def repository_name(self) -> str:
        return f"{self.owner}/{self.repository}"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Print the numeric ID of the most recent gha-ci run attached to "
            "the pull request's current head."
        )
    )
    parser.add_argument(
        "pr_url",
        help="GitHub PR URL, for example https://github.com/CUBRID/cubrid/pull/7927",
    )
    return parser.parse_args()


def parse_pr_url(value: str) -> PullRequest:
    parsed = urlsplit(value)
    match = PR_PATH_RE.fullmatch(parsed.path)
    if (
        parsed.scheme != "https"
        or parsed.hostname != "github.com"
        or parsed.username is not None
        or parsed.password is not None
        or parsed.port is not None
        or parsed.query
        or parsed.fragment
        or match is None
    ):
        raise UserError(
            "expected a GitHub PR URL like "
            "https://github.com/CUBRID/cubrid/pull/7927"
        )

    owner, repository, number = match.groups()
    return PullRequest(owner, repository, int(number))


def run_gh_json(arguments: list[str]) -> object:
    try:
        result = subprocess.run(
            ["gh", *arguments],
            check=True,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as exc:
        raise UserError("GitHub CLI ('gh') is not installed or not in PATH") from exc
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout).strip()
        raise UserError(f"gh failed: {detail or f'exit status {exc.returncode}'}") from exc

    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise UserError("gh returned invalid JSON") from exc


def get_head_sha(pr: PullRequest) -> str:
    response = run_gh_json(
        ["api", f"repos/{pr.repository_name}/pulls/{pr.number}"]
    )
    try:
        head_sha = response["head"]["sha"]  # type: ignore[index]
    except (KeyError, TypeError) as exc:
        raise UserError("could not determine the pull request head SHA") from exc

    if not isinstance(head_sha, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", head_sha):
        raise UserError("GitHub returned an invalid pull request head SHA")
    return head_sha


def get_status_pages(pr: PullRequest, head_sha: str) -> list[list[object]]:
    response = run_gh_json(
        [
            "api",
            "--paginate",
            "--slurp",
            f"repos/{pr.repository_name}/commits/{head_sha}/statuses?per_page=100",
        ]
    )
    if not isinstance(response, list) or not all(isinstance(page, list) for page in response):
        raise UserError("GitHub returned an invalid commit-status response")
    return response


def parse_timestamp(value: object) -> datetime:
    if not isinstance(value, str):
        return datetime.min.replace(tzinfo=timezone.utc)
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return datetime.min.replace(tzinfo=timezone.utc)
    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=timezone.utc)
    return parsed


def run_id_from_url(pr: PullRequest, value: object) -> int | None:
    if not isinstance(value, str):
        return None

    parsed = urlsplit(value)
    expected_prefix = f"/{pr.owner}/{pr.repository}/actions/runs/"
    if parsed.scheme != "https" or parsed.hostname != "github.com":
        return None
    if not parsed.path.casefold().startswith(expected_prefix.casefold()):
        return None

    remainder = parsed.path[len(expected_prefix):]
    match = re.fullmatch(r"([1-9][0-9]*)(?:/job/[1-9][0-9]*)?/?", remainder)
    return int(match.group(1)) if match else None


def find_latest_run_id(pr: PullRequest, pages: list[list[object]]) -> int:
    candidates: dict[int, datetime] = {}
    for page in pages:
        for raw_status in page:
            if not isinstance(raw_status, dict):
                continue
            context = raw_status.get("context")
            if not isinstance(context, str) or not context.startswith("gha-ci:"):
                continue

            run_id = run_id_from_url(pr, raw_status.get("target_url"))
            if run_id is None:
                continue
            updated_at = parse_timestamp(raw_status.get("updated_at"))
            candidates[run_id] = max(candidates.get(run_id, updated_at), updated_at)

    if not candidates:
        raise UserError("no gha-ci run is attached to the pull request's current head")

    return max(candidates, key=lambda run_id: (candidates[run_id], run_id))


def main() -> int:
    args = parse_args()
    try:
        pr = parse_pr_url(args.pr_url)
        head_sha = get_head_sha(pr)
        pages = get_status_pages(pr, head_sha)
        print(find_latest_run_id(pr, pages))
        return 0
    except UserError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
