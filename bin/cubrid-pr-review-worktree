#!/usr/bin/env python3
"""Compatibility wrapper delegating PR review worktree creation to cubrid-worktree."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Create a ~/gh/cb review worktree for a CUBRID pull request via cubrid-worktree."
    )
    parser.add_argument(
        "pr_url",
        nargs="?",
        help="CUBRID pull-request number or URL, for example https://github.com/CUBRID/cubrid/pull/7887",
    )
    parser.add_argument(
        "--interactive",
        action="store_true",
        help="Fuzzily select a PR that directly requests review from the configured reviewer",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Create every requested-review worktree that does not already exist",
    )
    parser.add_argument(
        "--prepare",
        action="store_true",
        help="Prepare the new worktree with the default debug GCC build environment",
    )
    parser.add_argument("--herdr", action="store_true", help="Require Herdr placement")
    parser.add_argument("--no-herdr", action="store_true", help="Skip Herdr placement")
    parser.add_argument("--no-focus", action="store_true", help="Do not switch Herdr UI focus")
    parser.add_argument("--reuse", action="store_true", help="Reuse an existing review worktree")
    parser.add_argument("--dry-run", "-n", action="store_true", help="Preview without mutations")
    parser.add_argument("--json", action="store_true", help="Emit structured JSON output")
    parser.add_argument("--plain", action="store_true", help="Emit tab-separated plain output")
    args = parser.parse_args(argv)
    mode_count = sum((args.pr_url is not None, args.interactive, args.all))
    if mode_count != 1:
        parser.error("provide exactly one of PR_URL, --interactive, or --all")
    if args.herdr and args.no_herdr:
        parser.error("--herdr and --no-herdr cannot be combined")
    return args


def build_delegate_command(args: argparse.Namespace) -> list[str]:
    cmd = ["cubrid-worktree", "review"]
    if args.interactive:
        cmd.append("--interactive")
    elif args.all:
        cmd.append("--all")
    else:
        cmd.append(args.pr_url)

    if not args.prepare:
        cmd.append("--no-prepare")
    if args.herdr:
        cmd.append("--herdr")
    if args.no_herdr:
        cmd.append("--no-herdr")
    if args.no_focus:
        cmd.append("--no-focus")
    if args.reuse:
        cmd.append("--reuse")
    if args.dry_run:
        cmd.append("--dry-run")
    if args.json:
        cmd.append("--json")
    if args.plain:
        cmd.append("--plain")
    return cmd


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    binary = shutil.which("cubrid-worktree")
    if binary is None:
        print(
            "error: cubrid-worktree is not installed on PATH; run 'just install' in ~/gh/cubrid-worktree",
            file=sys.stderr,
        )
        return 1
    command = [binary, *build_delegate_command(args)[1:]]
    result = subprocess.run(command, env=os.environ, check=False)
    return int(result.returncode)


if __name__ == "__main__":
    raise SystemExit(main())
