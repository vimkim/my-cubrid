#!/usr/bin/env python3
"""Read-only CUBRID PR and CI summary. Requires Python 3.9+ and authenticated gh."""
import argparse
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import time

REPO = 'CUBRID/cubrid'
PREFIX = 'repos/' + REPO
FIELDS = 'number,title,url,headRefOid,state,isDraft,reviewDecision,mergeable'


def gh(*args):
    try:
        result = subprocess.run(['gh', *args], capture_output=True, text=True, timeout=45)
    except FileNotFoundError as exc:
        raise RuntimeError('gh is missing; install GitHub CLI and run gh auth login.') from exc
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError('GitHub request timed out after 45 seconds.') from exc
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'GitHub request failed.')
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError('gh returned invalid JSON.') from exc


def api(path):
    return gh('api', PREFIX + '/' + path, '--paginate', '--slurp')


def read_pr(target):
    args = [target] if target else []
    pr = gh('pr', 'view', *args, '--json', FIELDS)
    if not re.fullmatch(r'https://github\.com/CUBRID/cubrid/pull/[0-9]+', pr['url'], re.I):
        raise RuntimeError('This command supports CUBRID/cubrid PRs only.')
    return pr


def check_results(sha):
    with ThreadPoolExecutor(max_workers=2) as pool:
        statuses = pool.submit(api, f'commits/{sha}/statuses?per_page=100')
        checks = pool.submit(api, f'commits/{sha}/check-runs?per_page=100')
        entries = []
        for page in statuses.result():
            for item in page:
                entries.append(dict(name=item['context'], state=item['state'].upper(),
                                    url=item.get('target_url') or '', time=item.get('updated_at') or '',
                                    id=item.get('id', 0), sha=sha))
        for page in checks.result():
            for item in page['check_runs']:
                app = (item.get('app') or {}).get('slug', 'check')
                entries.append(dict(name=f"{app}: {item['name']}",
                                    state=(item.get('conclusion') or item['status']).upper(),
                                    url=item.get('details_url') or '',
                                    time=item.get('completed_at') or item.get('started_at') or '',
                                    id=item.get('id', 0), sha=sha))
    latest = {}
    for item in sorted(entries, key=lambda x: x['id']):
        latest[item['name']] = item
    return latest


def clean(value):
    return ''.join(c if c.isprintable() else ' ' for c in str(value))


def age(timestamp):
    if not timestamp:
        return 'time unknown'
    try:
        seconds = max(0, int((datetime.now(timezone.utc) - datetime.fromisoformat(
            timestamp.replace('Z', '+00:00'))).total_seconds()))
    except (ValueError, TypeError):
        return 'time unknown'
    return f'{seconds // 86400}d ago' if seconds >= 86400 else f'{seconds // 3600}h {(seconds % 3600) // 60}m ago'


def provider(name):
    if name.startswith('ci/circleci:'):
        return 'CircleCI'
    if name.startswith(('gha-ci:', 'github-actions:')):
        return 'GitHub Actions'
    return 'Other checks'


def priority(state):
    if state in ('FAILURE', 'ERROR', 'TIMED_OUT', 'CANCELLED', 'ACTION_REQUIRED', 'STARTUP_FAILURE'):
        return 0
    if state in ('SUCCESS', 'NEUTRAL', 'SKIPPED'):
        return 2
    return 1


def previous_results(pr, limit):
    if limit == 0:
        return {}, dict(status='disabled', limit=0, searched=0, available=None, truncated=None)
    commits = [item['sha'] for page in api(f"pulls/{pr['number']}/commits?per_page=100") for item in page]
    if pr['headRefOid'] not in commits:
        raise RuntimeError('PR head absent from history (head changed or GitHub history limit reached); retry.')
    commits = commits[:commits.index(pr['headRefOid'])]
    selected = list(reversed(commits))[:limit]
    previous: dict[str, dict] = {}
    with ThreadPoolExecutor(max_workers=4) as pool:
        for results in pool.map(check_results, selected):
            for name, item in results.items():
                previous.setdefault(name, item)
    return previous, dict(status='complete', limit=limit, searched=len(selected),
                          available=len(commits), truncated=len(selected) < len(commits))


def history_note(history):
    if history['status'] == 'disabled':
        return 'History: disabled (--history 0).'
    if history['status'] == 'incomplete':
        return 'INCOMPLETE history: previous results unavailable.'
    return (f"History: searched {history['searched']} of {history['available']} previous PR commits; "
            f"limit {history['limit']}. Force-pushed-away commits are unavailable.")


def result_record(item):
    if item is None:
        return None
    return dict(state=item['state'], reported_for_sha=item['sha'],
                detail_url=item['url'] or None, reported_at=item['time'] or None)


def snapshot(pr, current, expected, previous, history, errors):
    rows = []
    names = set(current) | set(expected) | set(previous)
    for name in sorted(names, key=lambda n: (provider(n), priority(current.get(n, {}).get('state', 'NOT OBSERVED')), n)):
        item = current.get(name)
        rows.append(dict(name=name, provider=provider(name), expected=name in expected,
                         freshness='current' if item else 'not_observed',
                         current=result_record(item), previous=result_record(previous.get(name)) if not item else None))
    return dict(schema_version=1, repository=REPO,
                fetched_at=datetime.now(timezone.utc).isoformat(timespec='seconds'),
                complete=not errors,
                pr=dict(number=pr['number'], title=pr['title'], url=pr['url'], head_sha=pr['headRefOid'],
                        state=pr['state'], draft=pr['isDraft'], review_decision=pr['reviewDecision'] or None,
                        mergeability=pr['mergeable']) if pr else None,
                checks=rows, history=history, errors=errors)


def color_enabled():
    return sys.stdout.isatty() and os.environ.get('TERM') != 'dumb' and not os.environ.get('NO_COLOR')


def paint(text, color):
    return f'\033[{color}m{text}\033[0m' if color_enabled() else text


def badge(state):
    if priority(state) == 0:
        return '[!]', '31'
    if state == 'SUCCESS':
        return '[+]', '32'
    if state in ('NEUTRAL', 'SKIPPED'):
        return '[-]', '90'
    return ('[?]' if state == 'NOT OBSERVED' else '[~]'), '33'


def render(data):
    pr = data['pr']
    line = '+' + '-' * 86 + '+'
    print(paint(line, '36'))
    print(paint(f"PR #{pr['number']} {clean(pr['title'])}", '1'))
    print(f"{pr['state']} | {'draft' if pr['draft'] else 'ready'} | review: {pr['review_decision'] or 'none'} | mergeability: {pr['mergeability']}")
    print(clean(pr['url']))
    print(f"PR head: {pr['head_sha']} | fetched {data['fetched_at']}")
    counts = {'failed': 0, 'pending': 0, 'passed': 0, 'missing': 0, 'other': 0}
    for row in data['checks']:
        item = row['current']
        key = ('missing' if item is None else 'failed' if priority(item['state']) == 0 else
               'passed' if item['state'] == 'SUCCESS' else 'other' if priority(item['state']) == 2 else 'pending')
        counts[key] += 1
    print(' | '.join(f"{key}: {count}" for key, count in counts.items()))
    print(paint(line, '36'))
    for group in ('GitHub Actions', 'CircleCI', 'Other checks'):
        rows = [row for row in data['checks'] if row['provider'] == group]
        if not rows:
            continue
        print('\n' + paint(group, '1;36'))
        width = max(len(clean(row['name'])) for row in rows)
        state_width = max(14, max(len(row['current']['state']) if row['current'] else len('NOT OBSERVED')
                                  for row in rows))
        for row in rows:
            item = row['current']
            state = item['state'] if item else 'NOT OBSERVED'
            marker, color = badge(state)
            label = paint(f'{marker} {state:<{state_width}}', color)
            print(f"  {label} {clean(row['name']):<{width}} | current {pr['head_sha'][:12]}")
            if item:
                print(f"      {age(item['reported_at'])} | reported: {clean(item['reported_at'] or 'unknown')}")
                print('      ' + (clean(item['detail_url']) if item['detail_url'] else 'detail URL unavailable'))
            elif row['previous']:
                old = row['previous']
                print('      ' + paint(f"STALE previous: {old['state']}", '33') +
                      f" | {old['reported_for_sha'][:12]} | {age(old['reported_at'])} | {clean(old['reported_at'] or 'unknown')}")
                print('      ' + (clean(old['detail_url']) if old['detail_url'] else 'detail URL unavailable'))
            else:
                print('      Previous result unavailable.' if data['history']['status'] == 'incomplete'
                      else '      No previous result in searched history.')
    print('\n' + history_note(data['history']))
    for error in data['errors']:
        print(paint(f"INCOMPLETE {clean(error['stage'])}: {clean(error['message'])}", '31'))
    print('Freshness = reported for PR head, not CI workflow revision. NOT OBSERVED is not queued or passed.')


class Arguments(argparse.ArgumentParser):
    def error(self, message):
        raise ValueError(message)


def report_error(stage, error, json_mode, watch=False):
    data = snapshot(None, {}, [], {}, None, [dict(stage=stage, message=str(error))])
    if json_mode:
        print(json.dumps(data, indent=None if watch else 2), flush=True)
    else:
        print('cubrid-pr-status: INCOMPLETE: ' + clean(error), file=sys.stderr, flush=True)
    return 2


def main():
    # Recognize the requested output even when argument validation fails.
    tokens = sys.argv[1:]
    options = tokens[:tokens.index('--')] if '--' in tokens else tokens
    json_mode = '--json' in options
    watch = '--watch' in options
    parser = Arguments(description=__doc__, allow_abbrev=False,
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       epilog='''AI agents:
  Fetch once: cubrid-pr-status --json [CUBRID_PR_URL]
  Omit the URL only when the current checkout selects the intended PR.
  Parse stdout as JSON, including on exit 2. Check schema_version == 1,
  complete, and errors before interpreting checks. Exit 0 means fetched,
  not CI passed; complete means collection succeeded, not CI finished.
  Use pr.head_sha for freshness and pr.url for the PR link. Report each
  check's provider, name, current.state, and current.detail_url when present.
  current == null means not observed after successful collection; previous
  is stale and cannot establish current CI status. Consult history coverage.
  Use --history 0 for current-only queries; increase it for older CI results.
  Use --json --watch only for ongoing monitoring; parse one object per line
  and check complete/errors on every snapshot. Stop when monitoring is done.
  This tool is read-only. Failure details require following detail_url.

Exit status: 0 = fetched or Ctrl-C; 2 = invalid input or incomplete data.

JSON v1 field layout (all keys present; ? means value may be null):
  schema_version: 1, repository: string, fetched_at: UTC timestamp,
  complete: boolean, errors: [{stage: string, message: string}],
  pr: {number: integer, title: string, url: string, head_sha: full SHA,
       state: string, draft: boolean, review_decision: string?,
       mergeability: string}?,
  checks: [{name: string, provider: string, expected: boolean,
            freshness: "current" | "not_observed",
            current: result?, previous: result?}],
  history: {status: "disabled" | "complete" | "incomplete", limit: integer,
            searched: integer?, available: integer?, truncated: boolean?}?
  result = {state: string, reported_for_sha: full SHA,
            detail_url: string?, reported_at: string?}
  Fatal errors: complete=false, pr=null, history=null, checks=[].
  Provider states are open strings; unfamiliar states do not imply success.

jq examples (save one snapshot, including structured errors on exit 2):
  cubrid-pr-status --json > snapshot.json
  # Check collection before extracting; exit 0 from jq -e means true:
  jq -e '.schema_version == 1 and .complete == true and .errors == []
         and .pr != null' snapshot.json
  # PR identity, status, and errors:
  jq '{pr, fetched_at, complete, errors}' snapshot.json
  # Current failure states and links:
  jq '[.checks[] | select(.current != null)
       | select(.current.state as $s | ["FAILURE", "ERROR", "TIMED_OUT",
           "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"] | index($s) != null)
       | {provider, name, current}]' snapshot.json
  # Expected checks missing on the published head:
  jq '[.checks[] | select(.expected and .current == null)
       | {provider, name}]' snapshot.json
  # Stale results with coverage and their own commit/URL:
  jq '{history, stale: [.checks[]
       | select(.current == null and .previous != null)
       | {provider, name, previous}]}' snapshot.json

Agent workflow and schema: ~/my-cubrid/docs/cubrid-pr-status/README.md
JSON Schema: ~/my-cubrid/docs/cubrid-pr-status/schema-v1.json
jq recipes: ~/my-cubrid/docs/cubrid-pr-status/jq-recipes.md
''')
    parser.add_argument('pr', nargs='?', help='CUBRID PR URL; otherwise detect from current directory')
    parser.add_argument('--history', type=int, default=5, help='previous PR commits to search (default: 5)')
    parser.add_argument('--config', type=Path, default=Path(__file__).resolve().with_name('cubrid-pr-status.json'))
    parser.add_argument('--watch', action='store_true', help='refresh until Ctrl-C')
    parser.add_argument('--interval', type=float, default=30, help='seconds between watch refreshes (default: 30)')
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument('--json', action='store_true', help='AI agents: versioned JSON; one object per line in watch mode')
    modes.add_argument('--human', action='store_true', help='human-readable terminal output (default)')
    try:
        args = parser.parse_args()
        if args.history < 0 or args.history > 250:
            parser.error('--history must be between 0 and 250')
        if not math.isfinite(args.interval) or args.interval <= 0:
            parser.error('--interval must be a positive finite number')
        if args.pr and not re.fullmatch(r'https://github\.com/CUBRID/cubrid/pull/[0-9]+/?', args.pr, re.I):
            parser.error('expected a https://github.com/CUBRID/cubrid/pull/NUMBER URL')
    except ValueError as exc:
        return report_error('arguments', exc, json_mode, watch)
    try:
        config = json.loads(args.config.read_text())
        if not isinstance(config, dict) or 'expected_checks' not in config:
            raise ValueError('configuration must be a JSON object containing expected_checks.')
        expected = config['expected_checks']
        if not isinstance(expected, list) or any(not isinstance(name, str) or not name.strip() for name in expected):
            raise ValueError('expected_checks must be a JSON array of nonempty check names.')
    except (RuntimeError, OSError, ValueError, KeyError) as exc:
        return report_error('configuration', exc, args.json, args.watch)
    target = args.pr
    try:
        while True:
            stage = 'pr'
            try:
                pr = read_pr(target)
                target = pr['url']
                stage = 'current_checks'
                current = check_results(pr['headRefOid'])
                errors = []
                try:
                    previous, history = previous_results(pr, args.history)
                except (RuntimeError, ValueError, KeyError, TypeError) as exc:
                    previous = {}
                    history = dict(status='incomplete', limit=args.history, searched=None, available=None, truncated=None)
                    errors.append(dict(stage='history', message=str(exc)))
                stage = 'head_check'
                if read_pr(target)['headRefOid'] != pr['headRefOid']:
                    raise RuntimeError('PR head changed during fetch; retry for a consistent snapshot.')
                if args.watch and color_enabled() and not args.json:
                    print('\033[2J\033[H', end='')
                data = snapshot(pr, current, expected, previous, history, errors)
                if args.json:
                    print(json.dumps(data, indent=None if args.watch else 2))
                else:
                    render(data)
                code = 2 if errors else 0
            except (RuntimeError, OSError, ValueError, KeyError, TypeError) as exc:
                code = report_error(stage, exc, args.json, args.watch)
            sys.stdout.flush()
            if not args.watch:
                return code
            time.sleep(args.interval)
    except KeyboardInterrupt:
        return 0


if __name__ == '__main__':
    sys.exit(main())
