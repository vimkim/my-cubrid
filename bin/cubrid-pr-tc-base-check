#!/usr/bin/env python3
"""Check that a feature-branch PR's testcase branches contain the feature baseline."""

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def command(*args, cwd=None, allowed=(0,)):
    result = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=120)
    if result.returncode not in allowed:
        raise RuntimeError(result.stderr.strip() or f"{' '.join(args)} exited {result.returncode}")
    return result


def pr_metadata(pr=None):
    args = ["gh", "pr", "view"]
    if pr is not None:
        args += [str(pr), "--repo", "CUBRID/cubrid"]
    pr = json.loads(command(*args, "--json", "number,url,baseRefName").stdout)
    if not re.fullmatch(r"https://github\.com/CUBRID/cubrid/pull/[1-9][0-9]*", pr["url"], re.I):
        raise RuntimeError("Current PR must belong to CUBRID/cubrid; use --pr N explicitly.")
    return positive_number(str(pr["number"])), pr["baseRefName"]


def positive_number(value):
    if not re.fullmatch(r"[1-9][0-9]*", value):
        raise argparse.ArgumentTypeError("PR number must be a positive integer")
    return int(value)


def feature_branch(value):
    if not re.fullmatch(r"feature/[^\s]+", value):
        raise argparse.ArgumentTypeError("base must be a feature/<name> branch")
    return value


def inspect(label, directory, base, target):
    def git(*args, allowed=(0,)):
        return command("git", "-C", str(directory), *args, allowed=allowed)

    print(f"\n{label} ({directory})", flush=True)
    # Fetch all heads explicitly so narrow origin fetch configurations cannot
    # leave either inspected ref stale. Prune also removes deleted TC branches.
    git("fetch", "--prune", "--no-tags", "origin",
        "+refs/heads/*:refs/remotes/origin/*")
    refs = [f"refs/remotes/origin/{branch}" for branch in (base, target)]
    tips = []
    for branch, ref in zip((base, target), refs):
        result = git("rev-parse", "--verify", f"{ref}^{{commit}}", allowed=(0, 128))
        if result.returncode:
            raise RuntimeError(f"missing published branch origin/{branch}")
        tips.append(result.stdout.strip())
    source, tc = tips
    print(f"  origin/{base}: {source}\n  origin/{target}: {tc}")
    # A shallow boundary can conceal ancestry; never report that as divergence.
    if git("rev-parse", "--is-shallow-repository").stdout.strip() == "true":
        raise RuntimeError("shallow history: fetch full history before checking ancestry")
    contains = git("merge-base", "--is-ancestor", source, tc, allowed=(0, 1)).returncode == 0
    tc_only, base_only = map(int, git("rev-list", "--left-right", "--count", f"{tc}...{source}").stdout.split())
    bases = git("merge-base", "--all", source, tc, allowed=(0, 1)).stdout.split()
    if contains:
        state = f"PASS: contains latest {base} tip"
    elif not bases:
        state = "FAIL: unrelated histories"
    else:
        state = f"FAIL: latest {base} tip is not an ancestor"
    print(f"  {state}; TC-only={tc_only}, base-only={base_only}")
    print("  Common ancestors: " + (", ".join(bases) or "none"))
    args = ["log", "--graph", "--no-color", "--decorate=short", "--date-order",
            "--abbrev=12", "--format=%h %as%d %s"]
    args += [f"--decorate-refs={ref}" for ref in refs]
    args += tips
    if bases:
        args += ["--not"] + [f"{base}^@" for base in bases]
    graph = git(*args).stdout.rstrip()
    for merge_base in bases:
        short = git("rev-parse", "--short=12", merge_base).stdout.strip()
        graph = graph.replace(short, f"{short} [common ancestor]", 1)
    print("  Branch relationship:")
    for line in graph.splitlines():
        print(f"    {line}")
    return contains


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        "A PR targeting feature/<name> passes when origin/feature/<name> is an ancestor "
        "of origin/tc/pr-N in both testcase repositories; other PR bases are skipped. "
        "Fetches origin refs only; never merges, rebases, checks out, or pushes. "
        "Exit 0: both pass or skipped; 1: ancestry failure or missing branch; "
        "2: setup/check error. "
        "Paths: CUBRID_TESTCASES_DIR and CUBRID_TESTCASES_PRIVATE_EX_DIR."))
    parser.add_argument("--pr", type=positive_number, help="CUBRID PR number (default: current worktree PR)")
    parser.add_argument("--base", type=feature_branch, help=(
        "expected feature/<name> PR base; with --pr, GitHub is not queried "
        "(default: the PR's base branch)"))
    args = parser.parse_args()
    if args.pr is not None and args.base is not None:
        pr, base = args.pr, args.base
    else:
        pr, base = pr_metadata(args.pr)
        if args.base is not None and base != args.base:
            raise RuntimeError(f"PR #{pr} targets {base}, not {args.base}")
    if not base.startswith("feature/"):
        print(f"PR #{pr} targets {base}: SKIP, testcase baseline check applies only to feature/* bases.")
        return 0
    target = f"tc/pr-{pr}"
    print(f"PR #{pr}: published {target} must contain latest {base} (fetched snapshot).")
    repositories = (
        ("CUBRID/cubrid-testcases", "CUBRID_TESTCASES_DIR", "/home/vimkim/gh/cubrid-testcases/develop"),
        ("CUBRID/cubrid-testcases-private-ex", "CUBRID_TESTCASES_PRIVATE_EX_DIR",
         "/home/vimkim/gh/cubrid-testcases-private-ex/develop"),
    )
    exit_code = 0
    for label, variable, default in repositories:
        try:
            if not inspect(label, Path(os.environ.get(variable, default)), base, target):
                exit_code = max(exit_code, 1)
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
            print(f"  FAIL: {exc}", flush=True)
            code = 1 if str(exc).startswith("missing published branch ") else 2
            exit_code = max(exit_code, code)
    return exit_code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, OSError, subprocess.TimeoutExpired, ValueError, KeyError,
            argparse.ArgumentTypeError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(2)
