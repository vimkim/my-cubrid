#!/usr/bin/env bash

set -euo pipefail

readonly FEATURE_BRANCH="feature/oos-merge"
readonly PR_BRANCH="tc/pr-7990"
readonly -a DEFAULT_PUBLIC_TC_DIRS=(
  "/home/vimkim/gh/cubrid-testcases/develop"
)
readonly -a DEFAULT_PRIVATE_TC_DIRS=(
  "/home/vimkim/gh/cubrid-testcases-private-ex/develop"
)

usage ()
{
  cat <<'EOF'
Usage: cubrid-pr-tc-sync-check-oos

Check that tc/pr-7990 matches feature/oos-merge in both CUBRID testcase
repositories. feature/oos-merge is authoritative: all testcase edits must land
there first. If tc/pr-7990 is strictly behind, ask for confirmation, then
fast-forward and push tc/pr-7990 without force.

The command refuses to update anything when tc/pr-7990 is ahead of
feature/oos-merge or the two branches have diverged.

Environment overrides (primarily useful for testing):
  CUBRID_TESTCASES_DIR
  CUBRID_TESTCASES_PRIVATE_EX_DIR
EOF
}

die ()
{
  printf 'error: %s\n' "$*" >&2
  exit 1
}

resolve_repository_directory ()
{
  local override="$1"
  shift
  local directory

  if [[ -n "$override" ]]
  then
    printf '%s\n' "$override"
    return
  fi

  for directory in "$@"
  do
    if git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1
    then
      printf '%s\n' "$directory"
      return
    fi
  done

  printf '%s\n' "$1"
}

ensure_repository ()
{
  local directory="$1"

  [[ -d "$directory" ]] || die "repository directory does not exist: $directory"
  git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "not a Git worktree: $directory"
  git -C "$directory" remote get-url origin >/dev/null 2>&1 \
    || die "Git remote 'origin' is missing: $directory"
}

fetch_repository ()
{
  local label="$1"
  local directory="$2"

  printf '\n==> Fetching %s\n' "$label"
  git -C "$directory" fetch origin --prune
}

remote_tracking_sha ()
{
  local directory="$1"
  local branch="$2"

  git -C "$directory" rev-parse --verify "refs/remotes/origin/${branch}^{commit}" 2>/dev/null
}

live_remote_sha ()
{
  local directory="$1"
  local branch="$2"
  local output

  output="$(git -C "$directory" ls-remote --exit-code --refs origin "refs/heads/$branch" 2>/dev/null)" \
    || return 1
  printf '%s\n' "${output%%$'\t'*}"
}

check_repository ()
{
  local label="$1"
  local directory="$2"
  local feature_sha
  local pr_sha

  feature_sha="$(remote_tracking_sha "$directory" "$FEATURE_BRANCH")" \
    || die "origin/$FEATURE_BRANCH does not exist in $label"
  pr_sha="$(remote_tracking_sha "$directory" "$PR_BRANCH")" \
    || die "origin/$PR_BRANCH does not exist in $label"

  CHECK_FEATURE_SHA="$feature_sha"
  CHECK_PR_SHA="$pr_sha"

  if [[ "$feature_sha" == "$pr_sha" ]]
  then
    CHECK_STATE="synced"
    return
  fi

  if git -C "$directory" merge-base --is-ancestor "$pr_sha" "$feature_sha"
  then
    CHECK_STATE="needs-sync"
    return
  fi

  if git -C "$directory" merge-base --is-ancestor "$feature_sha" "$pr_sha"
  then
    die "$label: $PR_BRANCH is ahead of $FEATURE_BRANCH; move those edits to $FEATURE_BRANCH first"
  fi

  die "$label: $FEATURE_BRANCH and $PR_BRANCH have diverged; cannot fast-forward"
}

confirm_sync ()
{
  local answer

  printf '\nFast-forward and push %s in the repositories listed above? [y/N] ' "$PR_BRANCH"
  IFS= read -r answer || answer=""
  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

main ()
{
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]
  then
    usage
    exit 0
  fi

  [[ $# -eq 0 ]] || {
    usage >&2
    exit 2
  }

  command -v git >/dev/null 2>&1 || die "git is required"

  local public_tc_dir
  local private_tc_dir
  public_tc_dir="$(resolve_repository_directory \
    "${CUBRID_TESTCASES_DIR:-}" "${DEFAULT_PUBLIC_TC_DIRS[@]}")"
  private_tc_dir="$(resolve_repository_directory \
    "${CUBRID_TESTCASES_PRIVATE_EX_DIR:-}" "${DEFAULT_PRIVATE_TC_DIRS[@]}")"

  local -a labels=(
    "CUBRID/cubrid-testcases"
    "CUBRID/cubrid-testcases-private-ex"
  )
  local -a directories=("$public_tc_dir" "$private_tc_dir")
  local -a states=()
  local -a feature_shas=()
  local -a pr_shas=()
  local index
  local needs_sync=0

  for directory in "${directories[@]}"
  do
    ensure_repository "$directory"
  done

  # Fetch and validate both repositories before offering or performing writes.
  for index in "${!directories[@]}"
  do
    fetch_repository "${labels[index]}" "${directories[index]}"
  done

  printf '\nOOS testcase branch status:\n'
  for index in "${!directories[@]}"
  do
    check_repository "${labels[index]}" "${directories[index]}"
    states+=("$CHECK_STATE")
    feature_shas+=("$CHECK_FEATURE_SHA")
    pr_shas+=("$CHECK_PR_SHA")

    if [[ "$CHECK_STATE" == "synced" ]]
    then
      printf '  %-43s synced at %s\n' "${labels[index]}" "${CHECK_FEATURE_SHA:0:12}"
    else
      printf '  %-43s %s %s -> %s %s\n' "${labels[index]}" \
        "$PR_BRANCH" "${CHECK_PR_SHA:0:12}" "$FEATURE_BRANCH" "${CHECK_FEATURE_SHA:0:12}"
      needs_sync=1
    fi
  done

  if ((needs_sync == 0))
  then
    printf '\nBoth testcase repositories are already synchronized.\n'
    exit 0
  fi

  if ! confirm_sync
  then
    printf '\nCancelled; no branches were changed.\n'
    exit 0
  fi

  # Recheck all live tips after confirmation so no repository is written when
  # either branch changed during the prompt.
  for index in "${!directories[@]}"
  do
    local live_feature_sha
    local live_pr_sha
    live_feature_sha="$(live_remote_sha "${directories[index]}" "$FEATURE_BRANCH")" \
      || die "cannot resolve live ${labels[index]}:$FEATURE_BRANCH"
    live_pr_sha="$(live_remote_sha "${directories[index]}" "$PR_BRANCH")" \
      || die "cannot resolve live ${labels[index]}:$PR_BRANCH"
    [[ "$live_feature_sha" == "${feature_shas[index]}" && "$live_pr_sha" == "${pr_shas[index]}" ]] \
      || die "${labels[index]} branches changed during confirmation; rerun the command"
  done

  for index in "${!directories[@]}"
  do
    [[ "${states[index]}" == "needs-sync" ]] || continue
    printf '\n==> Fast-forwarding %s:%s to %s\n' "${labels[index]}" "$PR_BRANCH" \
      "${feature_shas[index]:0:12}"
    git -C "${directories[index]}" push origin \
      "${feature_shas[index]}:refs/heads/$PR_BRANCH"
  done

  for index in "${!directories[@]}"
  do
    local verified_feature_sha
    local verified_pr_sha
    verified_feature_sha="$(live_remote_sha "${directories[index]}" "$FEATURE_BRANCH")" \
      || die "cannot verify ${labels[index]}:$FEATURE_BRANCH"
    verified_pr_sha="$(live_remote_sha "${directories[index]}" "$PR_BRANCH")" \
      || die "cannot verify ${labels[index]}:$PR_BRANCH"
    [[ "$verified_feature_sha" == "$verified_pr_sha" ]] \
      || die "verification failed for ${labels[index]}"
    printf 'Verified %-34s %s\n' "${labels[index]}" "${verified_feature_sha:0:12}"
  done

  printf '\nSynchronized %s to %s in both testcase repositories.\n' "$PR_BRANCH" "$FEATURE_BRANCH"
}

main "$@"
