#!/usr/bin/env bash

set -euo pipefail

readonly SOURCE_BRANCH="feature/oos-merge"
readonly TARGET_BRANCH="tc/pr-7990"

usage ()
{
  cat <<'EOF'
Usage: cubrid-pr-tc-sync-check-oos

Check that tc/pr-7990 matches feature/oos-merge in both CUBRID testcase
repositories. If tc/pr-7990 is strictly behind, offer to fast-forward and
push it without force.

This is the OOS wrapper for:
  cubrid-pr-tc-sync-check feature/oos-merge tc/pr-7990

Environment overrides (primarily useful for testing):
  CUBRID_TESTCASES_DIR
  CUBRID_TESTCASES_PRIVATE_EX_DIR
EOF
}

main ()
{
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]
  then
    usage
    exit 0
  fi

  [[ $# -eq 0 ]] || {
    usage >&2
    exit 2
  }

  local script_dir
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  exec "$script_dir/cubrid-pr-tc-sync-check" "$SOURCE_BRANCH" "$TARGET_BRANCH"
}

main "$@"
