#!/usr/bin/env bash
set -uo pipefail

readonly program_name="${0##*/}"
readonly script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly picker="$script_dir/cubrid-dir-picker.sh"
declare -a repos=()
declare -A clone_urls=()

usage()
{
  cat <<EOF
Usage: $program_name <command>

Keep the repositories configured in cubrid-dir-picker.sh synchronized.

Commands:
  list    List configured directories
  status  Check cleanliness and sync with each branch's upstream (fetches)
  pull    Pull existing repositories, then offer to clone missing ones
  help    Show this help

Status uses ANSI colors in terminals; set NO_COLOR to disable them.
Status exits 1 if any repository needs attention or cannot be checked.
EOF
}

load_repos()
{
  local output repo clone_url

  if [[ ! -x "$picker" ]]; then
    printf '%s: directory picker is not executable: %s\n' "$program_name" "$picker" >&2
    return 1
  fi

  if ! output=$("$picker" --list-with-clone-urls); then
    printf '%s: failed to read directories from %s\n' "$program_name" "$picker" >&2
    return 1
  fi
  if [[ -z "$output" ]]; then
    printf '%s: no directories are configured in %s\n' "$program_name" "$picker" >&2
    return 1
  fi

  while IFS=$'\t' read -r repo clone_url; do
    if [[ -z "$repo" || -z "$clone_url" ]]; then
      printf '%s: invalid repository configuration from %s\n' \
        "$program_name" "$picker" >&2
      return 1
    fi
    repos+=("$repo")
    clone_urls["$repo"]=$clone_url
  done <<<"$output"
}

list_repos()
{
  printf '%s\n' "${repos[@]}"
}

status_repos()
{
  local repo branch changes remote merge_ref counts ahead behind
  local work_label sync_label work_color sync_color
  local green='' yellow='' red='' reset=''
  local attention=0

  if [[ -t 1 && "${TERM:-}" != dumb && -z "${NO_COLOR:-}" ]]; then
    green=$'\033[32m'
    yellow=$'\033[33m'
    red=$'\033[31m'
    reset=$'\033[0m'
  fi

  printf 'Checking working trees and fetching upstream branches...\n'
  for repo in "${repos[@]}"; do
    if [[ ! -d "$repo" ]]; then
      printf '%s | %smissing directory%s\n' "$repo" "$red" "$reset"
      attention=$((attention + 1))
      continue
    fi
    if [[ "$(git -C "$repo" rev-parse --is-inside-work-tree 2>/dev/null)" != true ]]; then
      printf '%s | %snot a working-tree repository%s\n' "$repo" "$red" "$reset"
      attention=$((attention + 1))
      continue
    fi

    work_color=$green
    work_label=clean
    if ! changes=$(git -C "$repo" status --porcelain --untracked-files=normal --ignore-submodules=none 2>/dev/null); then
      work_color=$red
      work_label='working tree unknown (status failed)'
    elif [[ -n "$changes" ]]; then
      work_color=$yellow
      work_label='dirty (uncommitted changes)'
    fi

    sync_color=$yellow
    if ! branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD); then
      branch='detached HEAD'
      sync_label='sync unknown (detached HEAD)'
    elif ! git -C "$repo" rev-parse --verify HEAD >/dev/null 2>&1; then
      sync_label='sync unknown (no commits yet)'
    else
      remote=$(git -C "$repo" config --get "branch.$branch.remote")
      merge_ref=$(git -C "$repo" config --get "branch.$branch.merge")
      if [[ -z "$remote" || -z "$merge_ref" ]]; then
        sync_label='sync unknown (no upstream configured)'
      elif ! GIT_TERMINAL_PROMPT=0 git -C "$repo" fetch --quiet --no-tags -- "$remote" "$merge_ref" 2>/dev/null; then
        sync_color=$red
        sync_label="sync unknown (fetch failed: $remote/${merge_ref#refs/heads/})"
      elif ! counts=$(git -C "$repo" rev-list --left-right --count HEAD...FETCH_HEAD 2>/dev/null); then
        sync_color=$red
        sync_label='sync unknown (comparison failed)'
      else
        read -r ahead behind <<<"$counts"
        if ((ahead == 0 && behind == 0)); then
          sync_color=$green
          sync_label='synced'
        elif ((ahead > 0 && behind > 0)); then
          sync_color=$red
          sync_label="diverged (ahead $ahead, behind $behind)"
        elif ((ahead > 0)); then
          sync_label="ahead $ahead (push needed)"
        else
          sync_label="behind $behind (pull needed)"
        fi
        sync_label+=" [$remote/${merge_ref#refs/heads/}]"
      fi
    fi

    printf '%s (%s) | %s%s%s | %s%s%s\n' \
      "$repo" "$branch" "$work_color" "$work_label" "$reset" \
      "$sync_color" "$sync_label" "$reset"
    if [[ "$work_label" != clean || "$sync_label" != synced\ * ]]; then
      attention=$((attention + 1))
    fi
  done

  if ((attention == 0)); then
    printf '\n%sAll %d repositories are clean and synced.%s\n' "$green" "${#repos[@]}" "$reset"
    return 0
  fi
  printf '\n%s%d of %d repositories need attention.%s\n' "$yellow" "$attention" "${#repos[@]}" "$reset"
  return 1
}

pull_repos()
{
  local repo parent reply
  local -a missing_repos=()
  local failures=0

  for repo in "${repos[@]}"; do
    printf '\n==> %s\n' "$repo"

    if [[ ! -d "$repo" ]]; then
      printf '%s: missing directory: %s\n' "$program_name" "$repo" >&2
      missing_repos+=("$repo")
      continue
    fi

    if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      printf '%s: not a git repository: %s\n' "$program_name" "$repo" >&2
      failures=$((failures + 1))
      continue
    fi

    if ! git -C "$repo" pull --ff-only; then
      printf '%s: pull failed: %s\n' "$program_name" "$repo" >&2
      failures=$((failures + 1))
    fi
  done

  if ((${#missing_repos[@]} > 0)); then
    printf '\nMissing repositories:\n' >&2
    printf '  %s\n' "${missing_repos[@]}" >&2
    printf '\nClone %d missing repositories? [y/N] ' \
      "${#missing_repos[@]}" >&2
    reply=''
    IFS= read -r reply || true

    case "$reply" in
      y|Y|yes|YES)
        for repo in "${missing_repos[@]}"; do
          parent=${repo%/*}
          printf '\n==> Cloning %s\n' "$repo"
          if ! mkdir -p -- "$parent"; then
            printf '%s: failed to create parent directory: %s\n' \
              "$program_name" "$parent" >&2
            failures=$((failures + 1))
          elif ! git clone "${clone_urls[$repo]}" "$repo"; then
            printf '%s: clone failed: %s\n' "$program_name" "$repo" >&2
            failures=$((failures + 1))
          fi
        done
        ;;
      *)
        failures=$((failures + ${#missing_repos[@]}))
        ;;
    esac
  fi

  printf '\n'
  if ((failures == 0)); then
    printf '%s: all %d repositories are synchronized\n' "$program_name" "${#repos[@]}"
    return 0
  fi

  printf '%s: %d of %d repositories failed\n' \
    "$program_name" "$failures" "${#repos[@]}" >&2
  return 1
}

main()
{
  case "${1:-}" in
    list)
      [[ $# -eq 1 ]] || {
        usage >&2
        return 2
      }
      load_repos || return
      list_repos
      ;;
    status|pull)
      [[ $# -eq 1 ]] || {
        usage >&2
        return 2
      }
      load_repos || return
      "${1}_repos"
      ;;
    help|-h|--help)
      [[ $# -eq 1 ]] || {
        usage >&2
        return 2
      }
      usage
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
