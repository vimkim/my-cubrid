#!/usr/bin/env python3
"""Select a live process that belongs to the coordinated CUBRID runtime."""

import argparse
import os
from pathlib import Path
import subprocess
import sys


ROLES = {
    "server": "cub_server",
    "unloaddb": "cubrid",
}


def role_matches(role: str, command_line: tuple[str, ...], database: str = "testdb") -> bool:
    if role == "server":
        return len(command_line) >= 2 and command_line[1] == database
    if role == "unloaddb":
        return (
            len(command_line) >= 3
            and command_line[1] == "unloaddb"
            and database in command_line[2:]
        )
    return False


def process_observation(pid: int, executable: Path, role: str, database: str):
    process = Path("/proc") / str(pid)
    try:
        if process.stat().st_uid != os.geteuid():
            return None
        if (process / "exe").resolve(strict=True) != executable:
            return None
        environment = dict(item.split(b'=', 1) for item in
                           (process / 'environ').read_bytes().split(b'\0') if b'=' in item)
        keys = ('CUBRID', 'CUBRID_CONF_FILE', 'CUBRID_DATABASES', 'CUBRID_TMP', 'CUBRID_CUBRID_PORT_ID')
        if any(not os.environ.get(key) or environment.get(key.encode()) != os.environ[key].encode()
               for key in keys):
            return None
        command_line = (process / "cmdline").read_bytes().split(b"\0")
        decoded = tuple(value.decode(errors="replace") for value in command_line if value)
        if not role_matches(role, decoded, database):
            return None
        fields = (process / "stat").read_text().rsplit(')', 1)[1].split()
        if len(fields) < 20:
            return None
        return fields[19], decoded
    except (FileNotFoundError, OSError, PermissionError):
        return None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("role", choices=tuple(ROLES))
    parser.add_argument("--interactive", action="store_true")
    parser.add_argument("--database", default="testdb")
    arguments = parser.parse_args()

    cubrid = os.environ.get("CUBRID")
    if not cubrid:
        parser.error("CUBRID is required")
    executable_name = ROLES[arguments.role]
    executable = (Path(cubrid) / "bin" / executable_name).resolve(strict=True)

    candidates = []
    for process in Path("/proc").glob("[0-9]*"):
        pid = int(process.name)
        observation = process_observation(pid, executable, arguments.role, arguments.database)
        if observation is not None:
            start_time, command_line = observation
            candidates.append((pid, start_time, command_line))
    candidates.sort()
    if not candidates:
        print(f"No {arguments.role} process belongs to this runtime.", file=sys.stderr)
        return 1

    if arguments.interactive:
        lines = [
            f"{pid}\t{' '.join(command_line)}"
            for pid, _start_time, command_line in candidates
        ]
        selected = subprocess.run(
            ["fzf"],
            input="\n".join(lines) + "\n",
            text=True,
            capture_output=True,
        )
        if selected.returncode != 0 or not selected.stdout.strip():
            return selected.returncode or 1
        selected_pid = int(selected.stdout.split("\t", 1)[0])
        candidate = next(item for item in candidates if item[0] == selected_pid)
    else:
        candidate = candidates[0]

    pid, start_time, _command_line = candidate
    current = process_observation(pid, executable, arguments.role, arguments.database)
    if current is None or current[0] != start_time:
        print("The selected process identity changed; retry selection.", file=sys.stderr)
        return 1
    print(pid)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
