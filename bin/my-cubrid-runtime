@dataclass(frozen=True)
class FileObservation:
    exists: bool
    accessible: bool = True
    kind: str | None = None
    owner: int | None = None
    mode: int | None = None
    content: str | None = None
    canonical: bool | None = None
    device: int | None = None
    inode: int | None = None


@dataclass(frozen=True)
class RuntimeObservationSnapshot:
    complete: bool
    processes: tuple[dict[str, object], ...]
    sockets: tuple[dict[str, object], ...]
    listeners: tuple[dict[str, object], ...]
    system_v_ipc: tuple[dict[str, object], ...]
    source: str
    scope: dict[str, object]


@dataclass(frozen=True)
class RuntimeSelection:
    worktree: Path
    git_common_dir: Path
    preset: str


@dataclass(frozen=True)
class AllocationRanges:
    master_ports: tuple[int, int]
    broker_ports: tuple[int, int]
    system_v_keys: tuple[int, int]


@dataclass(frozen=True)
class InstallationLayout:
    root: Path
    engine_configuration: Path
    broker_configuration: Path
    executable_directory: Path
    library_directory: Path


def require_string(document: dict[str, object], field: str) -> str:
    value = document.get(field)
    if not isinstance(value, str):
        raise ValueError(f"{field} must be a string")
    return value


def require_integer(document: dict[str, object], field: str) -> int:
    value = document.get(field)
    if type(value) is not int:
        raise ValueError(f"{field} must be an integer")
    return value


@dataclass(frozen=True)
class BrokerSpec:
    section: str
    name: str
    max_appl_servers: int


@dataclass(frozen=True)
class BrokerAllocation:
    section: str
    name: str
    max_appl_servers: int
    port: int
    appl_server_shm_key: int
    query_replacement_shm_key: int
    socket_paths: tuple[Path, ...]

    @classmethod
    def from_dict(cls, document: object) -> "BrokerAllocation":
        if not isinstance(document, dict):
            raise ValueError("broker allocation must be an object")
        sockets = document.get("socket_paths")
        if not isinstance(sockets, list) or any(not isinstance(path, str) for path in sockets):
            raise ValueError("broker socket_paths must be strings")
        return cls(
            section=require_string(document, "section"),
            name=require_string(document, "name"),
            max_appl_servers=require_integer(document, "max_appl_servers"),
            port=require_integer(document, "port"),
            appl_server_shm_key=require_integer(document, "appl_server_shm_key"),
            query_replacement_shm_key=require_integer(
                document, "query_replacement_shm_key"
            ),
            socket_paths=tuple(Path(path) for path in sockets),
        )

    def to_dict(self) -> dict[str, object]:
        return {
            "section": self.section,
            "name": self.name,
            "max_appl_servers": self.max_appl_servers,
            "port": self.port,
            "appl_server_shm_key": self.appl_server_shm_key,
            "query_replacement_shm_key": self.query_replacement_shm_key,
            "socket_paths": [os.fspath(path) for path in self.socket_paths],
        }


@dataclass(frozen=True)
class Claims:
    tcp_ports: tuple[int, ...]
    system_v_keys: tuple[int, ...]
    paths: tuple[Path, ...]

    def to_dict(self) -> dict[str, object]:
        return {
            "tcp_ports": list(self.tcp_ports),
            "system_v_keys": list(self.system_v_keys),
            "paths": [os.fspath(path) for path in self.paths],
        }


@dataclass(frozen=True)
class ResourceBundle:
    database_name: str
    cubrid_tmp: Path
    database_registry: Path
    data_root: Path
    log_root: Path
    lob_root: Path
    master_port: int
    master_shm_key: int
    brokers: tuple[BrokerAllocation, ...]
    socket_paths: tuple[Path, ...]
    pl_socket_path: Path
    pl_mutable_paths: tuple[tuple[str, Path], ...]
    installation_root: Path
    executable_directory: Path
    library_directory: Path
    engine_configuration: Path
    broker_configuration: Path

    @classmethod
    def from_dict(cls, document: object) -> "ResourceBundle":
        if not isinstance(document, dict):
            raise ValueError("resource bundle must be an object")
        brokers = document.get("brokers")
        sockets = document.get("socket_paths")
        mutable = document.get("pl_mutable_paths")
        if not isinstance(brokers, list):
            raise ValueError("brokers must be a list")
        if not isinstance(sockets, list) or any(not isinstance(path, str) for path in sockets):
            raise ValueError("socket_paths must be strings")
        if not isinstance(mutable, dict) or any(
            not isinstance(key, str) or not isinstance(value, str)
            for key, value in mutable.items()
        ):
            raise ValueError("pl_mutable_paths must map strings to strings")
        return cls(
            database_name=require_string(document, "database_name"),
            cubrid_tmp=Path(require_string(document, "cubrid_tmp")),
            database_registry=Path(require_string(document, "database_registry")),
            data_root=Path(require_string(document, "data_root")),
            log_root=Path(require_string(document, "log_root")),
            lob_root=Path(require_string(document, "lob_root")),
            master_port=require_integer(document, "master_port"),
            master_shm_key=require_integer(document, "master_shm_key"),
            brokers=tuple(BrokerAllocation.from_dict(broker) for broker in brokers),
            socket_paths=tuple(Path(path) for path in sockets),
            pl_socket_path=Path(require_string(document, "pl_socket_path")),
            pl_mutable_paths=tuple(
                (key, Path(value)) for key, value in sorted(mutable.items())
            ),
            installation_root=Path(require_string(document, "installation_root")),
            executable_directory=Path(
                require_string(document, "executable_directory")
            ),
            library_directory=Path(require_string(document, "library_directory")),
            engine_configuration=Path(
                require_string(document, "engine_configuration")
            ),
            broker_configuration=Path(
                require_string(document, "broker_configuration")
            ),
        )

    def claims(self) -> Claims:
        return Claims(
            tcp_ports=(self.master_port, *(broker.port for broker in self.brokers)),
            system_v_keys=(
                self.master_shm_key,
                *(broker.appl_server_shm_key for broker in self.brokers),
                *(broker.query_replacement_shm_key for broker in self.brokers),
            ),
            paths=(
                self.cubrid_tmp,
                self.database_registry,
                self.data_root,
                self.log_root,
                self.lob_root,
                *self.socket_paths,
                *(path for _, path in self.pl_mutable_paths),
            ),
        )

    def installation_layout(self) -> InstallationLayout:
        return InstallationLayout(
            self.installation_root,
            self.engine_configuration,
            self.broker_configuration,
            self.executable_directory,
            self.library_directory,
        )

    def for_installation(self, layout: InstallationLayout) -> "ResourceBundle":
        return replace(
            self,
            pl_mutable_paths=(
                (
                    "info",
                    layout.root / "var" / "pl" / f"pl_{self.database_name}.info",
                ),
                ("installation_tmp", layout.root / "tmp"),
                ("log_root", layout.root / "log"),
            ),
            installation_root=layout.root,
            executable_directory=layout.executable_directory,
            library_directory=layout.library_directory,
            engine_configuration=layout.engine_configuration,
            broker_configuration=layout.broker_configuration,
        )

    def to_dict(self) -> dict[str, object]:
        return {
            "database_name": self.database_name,
            "cubrid_tmp": os.fspath(self.cubrid_tmp),
            "database_registry": os.fspath(self.database_registry),
            "data_root": os.fspath(self.data_root),
            "log_root": os.fspath(self.log_root),
            "lob_root": os.fspath(self.lob_root),
            "master_port": self.master_port,
            "master_shm_key": self.master_shm_key,
            "brokers": [broker.to_dict() for broker in self.brokers],
            "socket_paths": [os.fspath(path) for path in self.socket_paths],
            "pl_socket_path": os.fspath(self.pl_socket_path),
            "pl_mutable_paths": {
                key: os.fspath(path) for key, path in self.pl_mutable_paths
            },
            "installation_root": os.fspath(self.installation_root),
            "executable_directory": os.fspath(self.executable_directory),
            "library_directory": os.fspath(self.library_directory),
            "engine_configuration": os.fspath(self.engine_configuration),
            "broker_configuration": os.fspath(self.broker_configuration),
        }


@dataclass(frozen=True)
class AffectedObject:
    kind: str
    value: str


@dataclass(frozen=True)
class Diagnostic:
    code: str
    affected_object: AffectedObject
    normalized_value: str
    source: str
    evidence_quality: Literal["definitive", "unknown"]
    message: str
    next_action: str
    expected_owner: int | str | None = None
    observed_owner: int | str | None = None
    expected_value: str | None = None
    observed_value: str | None = None
    evidence: tuple[str, ...] = ()
    missing_evidence: tuple[str, ...] = ()
    observation_scope: dict[str, object] | None = None

    def to_dict(self) -> dict[str, object]:
        return {
            "code": self.code,
            "affected_object": {
                "kind": self.affected_object.kind,
                "value": self.affected_object.value,
            },
            "normalized_value": self.normalized_value,
            "source": self.source,
            "expected_owner": self.expected_owner,
            "observed_owner": self.observed_owner,
            "expected_value": self.expected_value,
            "observed_value": self.observed_value,
            "evidence_quality": self.evidence_quality,
            "evidence": list(self.evidence),
            "missing_evidence": list(self.missing_evidence),
            "observation_scope": self.observation_scope,
            "message": self.message,
            "next_action": self.next_action,
        }


@dataclass(frozen=True)
class ValidationResult:
    outcome: Literal["uninitialized", "invalid", "ready"]
    selection: RuntimeSelection
    diagnostic: Diagnostic | None = None
    command: Literal["init", "validate"] = "validate"
    worktree_id: str | None = None
    manifest_path: str | None = None
    environment_path: str | None = None
    live_ownership: dict[str, object] | None = None

    def to_dict(self) -> dict[str, object]:
        result: dict[str, object] = {
            "schema_version": 1,
            "command": self.command,
            "outcome": self.outcome,
            "ready": self.outcome == "ready",
            "worktree": os.fspath(self.selection.worktree),
            "preset": self.selection.preset,
        }
        if self.worktree_id is not None:
            result["worktree_id"] = self.worktree_id
        if self.manifest_path is not None:
            result["manifest_path"] = self.manifest_path
        if self.environment_path is not None:
            result["environment_path"] = self.environment_path
        if self.outcome == "ready":
            result["kernel_resources_reserved"] = False
            result["kernel_acquisition_can_race"] = True
        if self.diagnostic is not None:
            result["diagnostic"] = self.diagnostic.to_dict()
        if self.live_ownership is not None:
            result["live_ownership"] = self.live_ownership
        return result


class ObservationAdapter(Protocol):
    def inspect_file(self, path: Path) -> FileObservation:
        pass

    def inspect_runtime(self) -> RuntimeObservationSnapshot:
        pass


class LinuxObservationAdapter:
    """Read the filesystem without changing it."""

    def inspect_file(self, path: Path) -> FileObservation:
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            return FileObservation(exists=False)
        except OSError:
            return FileObservation(exists=True, accessible=False)
        if stat.S_ISREG(metadata.st_mode):
            kind = "file"
        elif stat.S_ISDIR(metadata.st_mode):
            kind = "directory"
        elif stat.S_ISLNK(metadata.st_mode):
            kind = "symlink"
        elif stat.S_ISSOCK(metadata.st_mode):
            kind = "socket"
        else:
            kind = "other"
        content = None
        if kind == "file":
            try:
                content = path.read_text()
            except (OSError, UnicodeError):
                content = None
        return FileObservation(
            exists=True,
            kind=kind,
            owner=metadata.st_uid,
            mode=stat.S_IMODE(metadata.st_mode),
            content=content,
            canonical=is_canonical_existing_path(path),
            device=metadata.st_dev,
            inode=metadata.st_ino,
        )

    def inspect_runtime(self) -> RuntimeObservationSnapshot:
        namespace_files = {
            "pid": "pid",
            "network": "net",
            "ipc": "ipc",
            "mount": "mnt",
        }
        namespaces: dict[str, str] = {}
        sources: dict[str, str] = {}
        for label, filename in namespace_files.items():
            try:
                namespaces[label] = os.readlink(f"/proc/self/ns/{filename}")
                sources[f"namespace:{label}"] = "complete"
            except OSError:
                sources[f"namespace:{label}"] = "inaccessible"
        try:
            boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
            sources["boot_id"] = "complete"
        except (OSError, UnicodeError):
            boot_id = None
            sources["boot_id"] = "inaccessible"
        processes, inaccessible = self._inspect_processes()
        process_complete = inaccessible != [-1]
        sources["processes"] = "complete" if process_complete else "inaccessible"
        listeners, tcp_complete = self._inspect_tcp(
            namespaces.get("network"), processes
        )
        sockets, unix_complete = self._inspect_unix(namespaces, processes)
        segments, ipc_complete = self._inspect_ipc(
            namespaces.get("ipc"), processes
        )
        sources.update({
            "listeners": "complete" if tcp_complete else "inaccessible",
            "sockets": "complete" if unix_complete else "inaccessible",
            "system_v_ipc": "complete" if ipc_complete else "inaccessible",
            "filesystem": "complete",
            "configuration": "per-process when readable",
        })
        scope: dict[str, object] = {
            "observer": "linux-procfs",
            "captured_at_ns": time.time_ns(),
            "uid": os.geteuid(),
            "boot_id": boot_id,
            "namespaces": namespaces,
            "sources": sources,
            "inaccessible_processes": inaccessible,
        }
        return RuntimeObservationSnapshot(
            complete=(
                len(namespaces) == len(namespace_files)
                and boot_id is not None
                and process_complete
                and tcp_complete
                and unix_complete
                and ipc_complete
            ),
            processes=tuple(processes),
            sockets=tuple(sockets),
            listeners=tuple(listeners),
            system_v_ipc=tuple(segments),
            source="Linux /proc read-only observation",
            scope=scope,
        )

    @staticmethod
    def _start_time(content: str) -> int:
        closing = content.rfind(")")
        return int(content[closing + 2 :].split()[19])

    @staticmethod
    def _configuration(
        environment: dict[str, str],
        process_start_wall_ns: int,
        command_line: list[str],
    ) -> dict[str, object]:
        installation = environment.get("CUBRID")
        if not installation:
            return {}
        root = Path(installation)
        engine = Path(environment.get("CUBRID_CONF_FILE", root / "conf" / "cubrid.conf"))
        broker = Path(environment.get("CUBRID_BROKER_CONF_FILE", root / "conf" / "cubrid_broker.conf"))
        result: dict[str, object] = {
            "installation_root": installation,
            "cubrid_tmp": environment.get("CUBRID_TMP"),
            "database_registry": environment.get("CUBRID_DATABASES"),
            "active_preset": environment.get("PRESET_MODE"),
            "engine_configuration": os.fspath(engine),
            "broker_configuration": os.fspath(broker),
            "process_start_wall_ns": process_start_wall_ns,
            "command_line": command_line,
        }
        unchanged_since_launch = True
        for field, path in (
            ("engine_configuration_sha256", engine),
            ("broker_configuration_sha256", broker),
        ):
            try:
                result[field] = file_hash(path)
                if path.stat().st_mtime_ns > process_start_wall_ns:
                    unchanged_since_launch = False
            except OSError:
                result[field] = None
                unchanged_since_launch = False
        selected_configuration_paths = {os.fspath(engine), os.fspath(broker)}
        explicit_configuration_paths = {
            argument
            for argument in command_line
            if argument.endswith(".conf")
        }
        if explicit_configuration_paths - selected_configuration_paths:
            unchanged_since_launch = False
        result["evidence"] = (
            "launch-correlated"
            if unchanged_since_launch
            else "current-files-only"
        )
        return result

    def _inspect_processes(self) -> tuple[list[dict[str, object]], list[int]]:
        processes: list[dict[str, object]] = []
        inaccessible: list[int] = []
        try:
            entries = list(Path("/proc").iterdir())
            boot_time_seconds = int(next(
                line.split()[1]
                for line in Path("/proc/stat").read_text().splitlines()
                if line.startswith("btime ")
            ))
            clock_ticks = os.sysconf("SC_CLK_TCK")
        except (OSError, StopIteration, ValueError):
            return processes, [-1]
        for entry in entries:
            if not entry.name.isdigit():
                continue
            pid = int(entry.name)
            try:
                status = (entry / "status").read_text()
                uid = int(next(
                    line for line in status.splitlines() if line.startswith("Uid:")
                ).split()[1])
                if uid != os.geteuid():
                    continue
            except (OSError, UnicodeError, StopIteration, ValueError):
                inaccessible.append(pid)
                continue
            record: dict[str, object] = {"pid": pid, "accessible": True}
            try:
                record["name"] = (entry / "comm").read_text().strip()
                start_time = self._start_time((entry / "stat").read_text())
                record["start_time"] = start_time
                record["executable"] = os.readlink(entry / "exe")
                command_line = [
                    os.fsdecode(argument)
                    for argument in (entry / "cmdline").read_bytes().split(b"\0")
                    if argument
                ]
                environment: dict[str, str] = {}
                for assignment in (entry / "environ").read_bytes().split(b"\0"):
                    if b"=" in assignment:
                        key, value = assignment.split(b"=", 1)
                        environment[os.fsdecode(key)] = os.fsdecode(value)
                process_start_wall_ns = (
                    boot_time_seconds * 1_000_000_000
                    + start_time * 1_000_000_000 // clock_ticks
                )
                record["start_wall_ns"] = process_start_wall_ns
                record["configuration"] = self._configuration(
                    environment, process_start_wall_ns, command_line
                )
                if environment.get("CUBRID_WORKTREE_ID"):
                    record["managed_runtime_id"] = environment["CUBRID_WORKTREE_ID"]
                library_root = (
                    Path(environment["CUBRID"]) / "lib"
                    if environment.get("CUBRID")
                    else None
                )
                libraries: set[str] = set()
                loaded_files: set[str] = set()
                deleted_libraries: set[str] = set()
                system_v_keys: set[int] = set()
                for line in (entry / "maps").read_text().splitlines():
                    fields = line.split()
                    mapped_text = " ".join(fields[5:]) if len(fields) > 5 else ""
                    system_v_match = re.fullmatch(
                        r"/SYSV([0-9a-fA-F]{8})(?: \(deleted\))?",
                        mapped_text,
                    )
                    if system_v_match:
                        system_v_keys.add(int(system_v_match.group(1), 16))
                    if mapped_text.startswith("/") and not system_v_match:
                        deleted = mapped_text.endswith(" (deleted)")
                        mapped = Path(mapped_text.removesuffix(" (deleted)"))
                        loaded_files.add(os.fspath(mapped))
                        if library_root is not None and (
                            mapped == library_root or library_root in mapped.parents
                        ):
                            libraries.add(os.fspath(mapped))
                            if deleted:
                                deleted_libraries.add(os.fspath(mapped))
                record["libraries"] = sorted(libraries)
                record["loaded_files"] = sorted(loaded_files)
                record["deleted_libraries"] = sorted(deleted_libraries)
                record["system_v_keys"] = sorted(system_v_keys)
                record["namespaces"] = {
                    label: os.readlink(entry / "ns" / filename)
                    for label, filename in (
                        ("pid", "pid"), ("network", "net"),
                        ("ipc", "ipc"), ("mount", "mnt"),
                    )
                }
                descriptors: list[dict[str, object]] = []
                for descriptor in (entry / "fd").iterdir():
                    try:
                        target = os.readlink(descriptor)
                    except OSError:
                        continue
                    match = re.fullmatch(r"socket:\[(\d+)\]", target)
                    if match:
                        descriptors.append({
                            "fd": int(descriptor.name),
                            "socket_inode": int(match.group(1)),
                        })
                record["fds"] = descriptors
            except (OSError, UnicodeError, ValueError):
                record["accessible"] = False
                inaccessible.append(pid)
            processes.append(record)
        return processes, sorted(set(inaccessible))

    @staticmethod
    def _owners(inode: int, processes: list[dict[str, object]]) -> list[dict[str, object]]:
        return [process for process in processes if process_owns_socket_inode(process, inode)]

    def _inspect_tcp(
        self, namespace: str | None, processes: list[dict[str, object]]
    ) -> tuple[list[dict[str, object]], bool]:
        listeners: list[dict[str, object]] = []
        complete = True
        for path, family in ((Path("/proc/net/tcp"), socket.AF_INET), (Path("/proc/net/tcp6"), socket.AF_INET6)):
            try:
                lines = path.read_text().splitlines()[1:]
            except (OSError, UnicodeError):
                complete = False
                continue
            for line in lines:
                fields = line.split()
                if len(fields) < 10 or fields[3] != "0A":
                    continue
                encoded_address, encoded_port = fields[1].split(":")
                if family == socket.AF_INET:
                    packed = bytes.fromhex(encoded_address)[::-1]
                else:
                    packed = b"".join(
                        bytes.fromhex(encoded_address[index:index + 8])[::-1]
                        for index in range(0, 32, 8)
                    )
                inode = int(fields[9])
                owners = self._owners(inode, processes)
                record: dict[str, object] = {
                    "protocol": "tcp",
                    "address": socket.inet_ntop(family, packed),
                    "port": int(encoded_port, 16),
                    "inode": inode,
                    "namespace": namespace,
                }
                if len(owners) == 1:
                    record["owner_pid"] = owners[0].get("pid")
                    record["owner_start_time"] = owners[0].get("start_time")
                listeners.append(record)
        return listeners, complete

    @staticmethod
    def _unix_table() -> tuple[list[tuple[int, Path]], bool]:
        try:
            lines = Path("/proc/net/unix").read_text().splitlines()[1:]
        except (OSError, UnicodeError):
            return [], False
        rows: list[tuple[int, Path]] = []
        complete = True
        for line in lines:
            fields = line.split(maxsplit=7)
            if len(fields) < 8 or not fields[7].startswith("/"):
                continue
            try:
                rows.append((int(fields[6]), Path(fields[7])))
            except ValueError:
                complete = False
        return rows, complete

    @staticmethod
    def _unix_vfs_identities() -> tuple[dict[int, tuple[str, int, int]], bool]:
        sequence = time.time_ns() & 0xFFFFFFFF
        request_body = struct.pack(
            "=BBHIIIII",
            socket.AF_UNIX,
            0,
            0,
            0xFFFFFFFF,
            0,
            UNIX_DIAG_SHOW_NAME_AND_VFS,
            0xFFFFFFFF,
            0xFFFFFFFF,
        )
        request = struct.pack(
            "=IHHII",
            16 + len(request_body),
            SOCK_DIAG_BY_FAMILY,
            NETLINK_REQUEST_DUMP,
            sequence,
            0,
        ) + request_body
        identities: dict[int, tuple[str, int, int]] = {}
        try:
            with socket.socket(
                socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_SOCK_DIAG
            ) as diagnostic_socket:
                diagnostic_socket.settimeout(1.0)
                diagnostic_socket.sendto(request, (0, 0))
                while True:
                    packet = diagnostic_socket.recv(1024 * 1024)
                    offset = 0
                    while offset + 16 <= len(packet):
                        length, message_type, _, response_sequence, _ = struct.unpack_from(
                            "=IHHII", packet, offset
                        )
                        if length < 16 or offset + length > len(packet):
                            return {}, False
                        if response_sequence != sequence:
                            offset += (length + 3) & ~3
                            continue
                        if message_type == NETLINK_DONE:
                            return identities, True
                        if message_type == NETLINK_ERROR:
                            return {}, False
                        if message_type != SOCK_DIAG_BY_FAMILY or length < 32:
                            offset += (length + 3) & ~3
                            continue
                        _, _, _, _, inode, _, _ = struct.unpack_from(
                            "=BBBBIII", packet, offset + 16
                        )
                        name: str | None = None
                        vfs_identity: tuple[int, int] | None = None
                        attribute_offset = offset + 32
                        while attribute_offset + 4 <= offset + length:
                            attribute_length, attribute_type = struct.unpack_from(
                                "=HH", packet, attribute_offset
                            )
                            if (
                                attribute_length < 4
                                or attribute_offset + attribute_length > offset + length
                            ):
                                return {}, False
                            payload_offset = attribute_offset + 4
                            payload_length = attribute_length - 4
                            if attribute_type == UNIX_DIAG_NAME:
                                raw_name = packet[
                                    payload_offset : payload_offset + payload_length
                                ].rstrip(b"\0")
                                if raw_name.startswith(b"/"):
                                    name = os.fsdecode(raw_name)
                            elif attribute_type == UNIX_DIAG_VFS and payload_length >= 8:
                                vfs_inode, encoded_device = struct.unpack_from(
                                    "=II", packet, payload_offset
                                )
                                device_major = encoded_device >> 20
                                device_minor = encoded_device & ((1 << 20) - 1)
                                vfs_identity = (
                                    os.makedev(device_major, device_minor),
                                    vfs_inode,
                                )
                            attribute_offset += (attribute_length + 3) & ~3
                        if name is not None and vfs_identity is not None:
                            identities[inode] = (name, *vfs_identity)
                        offset += (length + 3) & ~3
        except (OSError, TimeoutError, struct.error, UnicodeError, ValueError):
            return {}, False

    def _inspect_unix(
        self, namespaces: dict[str, str], processes: list[dict[str, object]]
    ) -> tuple[list[dict[str, object]], bool]:
        rows, initial_complete = self._unix_table()
        if not initial_complete and not rows:
            return [], False
        initial_vfs, initial_vfs_complete = self._unix_vfs_identities()
        observations = [
            (inode, path, self._owners(inode, processes), self.inspect_file(path))
            for inode, path in rows
        ]
        refreshed_vfs, refreshed_vfs_complete = self._unix_vfs_identities()
        sockets: list[dict[str, object]] = []
        for inode, path, owners, filesystem in observations:
            owner_namespaces = (
                owners[0].get("namespaces")
                if len(owners) == 1
                and isinstance(owners[0].get("namespaces"), dict)
                else {}
            )
            filesystem_identity = (
                filesystem.accessible
                and filesystem.exists
                and filesystem.kind == "socket"
                and filesystem.canonical is True
                and filesystem.device is not None
                and filesystem.inode is not None
                and initial_vfs.get(inode) == (
                    os.fspath(path), filesystem.device, filesystem.inode
                )
                and refreshed_vfs.get(inode) == initial_vfs.get(inode)
            )
            filesystem_identity_correlated = (
                len(owners) == 1
                and owner_namespaces.get("network") == namespaces.get("network")
                and owner_namespaces.get("mount") == namespaces.get("mount")
                and filesystem_identity
            )
            record: dict[str, object] = {
                "path": os.fspath(path),
                "inode": inode,
                "namespace": namespaces.get("network"),
                "device": filesystem.device,
                "path_inode": filesystem.inode,
                "filesystem_identity_correlated": filesystem_identity_correlated,
            }
            if len(owners) == 1:
                record["owner_pid"] = owners[0].get("pid")
                record["owner_start_time"] = owners[0].get("start_time")
            sockets.append(record)
        return (
            sockets,
            initial_complete and initial_vfs_complete and refreshed_vfs_complete,
        )

    def _inspect_ipc(
        self, namespace: str | None, processes: list[dict[str, object]]
    ) -> tuple[list[dict[str, object]], bool]:
        try:
            lines = Path("/proc/sysvipc/shm").read_text().splitlines()
        except (OSError, UnicodeError):
            return [], False
        if not lines:
            return [], True
        headings = lines[0].split()
        segments: list[dict[str, object]] = []
        complete = True
        for line in lines[1:]:
            values = line.split()
            if len(values) != len(headings):
                complete = False
                continue
            raw = dict(zip(headings, values))
            try:
                segment: dict[str, object] = {
                    "key": int(raw["key"], 0), "shmid": int(raw["shmid"]),
                    "uid": int(raw["uid"]), "cpid": int(raw["cpid"]),
                    "ctime": int(raw["ctime"]), "nattch": int(raw["nattch"]),
                    "namespace": namespace,
                }
            except (KeyError, ValueError):
                complete = False
                continue
            if segment["uid"] != os.geteuid():
                segment["owner_classification"] = "unmanaged"
            creators = [
                process
                for process in processes
                if process.get("pid") == segment["cpid"]
            ]
            if len(creators) == 1:
                creator = creators[0]
                start_wall_ns = creator.get("start_wall_ns")
                if type(start_wall_ns) is int:
                    creator_start_second = start_wall_ns // 1_000_000_000
                    if creator_start_second > segment["ctime"]:
                        segment["creator_pid_reused"] = True
                    elif creator_start_second == segment["ctime"]:
                        segment["creator_generation_ambiguous"] = True
                    else:
                        segment["process_start_time"] = creator.get("start_time")
            segments.append(segment)
        return segments, complete


class FakeObservationAdapter:
    """Supply deterministic test observations at the same internal seam."""

    def __init__(self, fixture_path: Path):
        self.files = LinuxObservationAdapter()
        self.fixture_path = fixture_path
        fixture = json.loads(fixture_path.read_text())
        self.filesystem = fixture["filesystem"]
        self._validate_observations(fixture["observations"])

    @staticmethod
    def _validate_observations(observations: object) -> dict[str, object]:
        if not isinstance(observations, dict):
            raise ValueError("fake runtime observations must be an object")
        if type(observations["complete"]) is not bool:
            raise ValueError("fake observation completeness must be Boolean")
        observation_lists = (
            observations["processes"],
            observations["sockets"],
            observations["listeners"],
            observations["system_v_ipc"],
        )
        if any(not isinstance(items, list) for items in observation_lists):
            raise ValueError("fake runtime observations must be lists")
        return observations

    def inspect_runtime(self) -> RuntimeObservationSnapshot:
        fixture = json.loads(self.fixture_path.read_text())
        observations = self._validate_observations(fixture["observations"])
        return RuntimeObservationSnapshot(
            complete=observations["complete"],
            processes=tuple(observations["processes"]),
            sockets=tuple(observations["sockets"]),
            listeners=tuple(observations["listeners"]),
            system_v_ipc=tuple(observations["system_v_ipc"]),
            source="fake observation fixture",
            scope=(
                observations["scope"]
                if isinstance(observations.get("scope"), dict)
                else {}
            ),
        )

    def inspect_file(self, path: Path) -> FileObservation:
        record = self.filesystem.get(os.fspath(path))
        if record is None:
            return self.files.inspect_file(path)
        if record.get("type") == "missing":
            return FileObservation(exists=False)
        return FileObservation(
            exists=True,
            accessible=record.get("accessible", True),
            kind=record["type"],
            owner=record.get("owner"),
            mode=int(record["mode"], 8),
            content=record.get("content"),
            canonical=record.get("canonical", True),
            device=record.get("device"),
            inode=record.get("inode"),
        )

def observation_adapter() -> ObservationAdapter:
    fixture = os.environ.get("MY_CUBRID_RUNTIME_TEST_OBSERVATIONS")
    if fixture:
        return FakeObservationAdapter(Path(fixture))
    if not sys.platform.startswith("linux"):
        raise ValueError("runtime validation is supported only on Linux")
    return LinuxObservationAdapter()


class WorktreeIdentityError(ValueError):
    pass


class OperationError(ValueError):
    def __init__(
        self,
        code: str,
        kind: str,
        value: str | Path,
        source: str,
        message: str,
        next_action: str,
        evidence_quality: Literal["definitive", "unknown"] = "definitive",
        *,
        normalized_value: str | None = None,
        expected_owner: int | str | None = None,
        observed_owner: int | str | None = None,
        expected_value: str | None = None,
        observed_value: str | None = None,
        evidence: tuple[str, ...] = (),
        missing_evidence: tuple[str, ...] = (),
        observation_scope: dict[str, object] | None = None,
    ):
        super().__init__(message)
        affected_value = os.fspath(value)
        self.diagnostic = Diagnostic(
            code=code,
            affected_object=AffectedObject(kind, affected_value),
            normalized_value=(
                affected_value if normalized_value is None else normalized_value
            ),
            source=source,
            expected_owner=expected_owner,
            observed_owner=observed_owner,
            expected_value=expected_value,
            observed_value=observed_value,
            evidence=evidence,
            missing_evidence=missing_evidence,
            observation_scope=observation_scope,
            evidence_quality=evidence_quality,
            message=message,
            next_action=next_action,
        )


def resolve_worktree(selected: str | None) -> Path:
    candidate = Path(selected or os.getcwd())
    try:
        result = subprocess.run(
            ["git", "-C", os.fspath(candidate), "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise ValueError(f"not a CUBRID Git worktree: {candidate}") from error
    worktree = Path(result.stdout.strip()).resolve(strict=True)
    required_files = ("CMakeLists.txt", "VERSION")
    required_directories = ("src", "broker", "pl_engine")
    if (
        any(not (worktree / name).is_file() for name in required_files)
        or any(not (worktree / name).is_dir() for name in required_directories)
    ):
        raise ValueError(f"not a CUBRID Git worktree: {candidate}")
    return worktree


def resolve_git_common_dir(worktree: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", os.fspath(worktree), "rev-parse", "--git-common-dir"],
        check=True,
        capture_output=True,
        text=True,
    )
    common_directory = Path(result.stdout.strip())
    if not common_directory.is_absolute():
        common_directory = worktree / common_directory
    return common_directory.resolve(strict=True)


def uninitialized_result(selection: RuntimeSelection) -> ValidationResult:
    worktree = os.fspath(selection.worktree)
    return ValidationResult(
        outcome="uninitialized",
        selection=selection,
        diagnostic=Diagnostic(
            code="runtime_uninitialized",
            affected_object=AffectedObject("worktree runtime", worktree),
            normalized_value=worktree,
            source="selected Git worktree",
            evidence_quality="definitive",
            message="No worktree runtime manifest exists.",
            next_action=(
                "Keep this worktree build-only; do not run CUBRID services until its "
                "runtime guard has been initialized."
            ),
        ),
    )


def invalid_result(
    selection: RuntimeSelection,
    affected_path: str | Path,
    code: str,
    message: str,
    evidence_quality: Literal["definitive", "unknown"] = "definitive",
    affected_kind: str = "worktree manifest",
    source: str = "guard state",
    next_action: str = "inspect or restore the manifest, then retry validation",
    normalized_value: str | None = None,
    expected_owner: int | str | None = None,
    observed_owner: int | str | None = None,
    expected_value: str | None = None,
    observed_value: str | None = None,
    evidence: tuple[str, ...] = (),
    missing_evidence: tuple[str, ...] = (),
    observation_scope: dict[str, object] | None = None,
) -> ValidationResult:
    affected_value = os.fspath(affected_path)
    return ValidationResult(
        outcome="invalid",
        selection=selection,
        diagnostic=Diagnostic(
            code=code,
            affected_object=AffectedObject(affected_kind, affected_value),
            normalized_value=(
                affected_value if normalized_value is None else normalized_value
            ),
            source=source,
            expected_owner=expected_owner,
            observed_owner=observed_owner,
            expected_value=expected_value,
            observed_value=observed_value,
            evidence=evidence,
            missing_evidence=missing_evidence,
            observation_scope=observation_scope,
            evidence_quality=evidence_quality,
            message=message,
            next_action=next_action,
        ),
    )


def runtime_id(adapter: ObservationAdapter, worktree: Path) -> str | None:
    environment_path = worktree / ".env"
    environment_file = adapter.inspect_file(environment_path)
    if not environment_file.exists:
        return None
    if environment_file.kind != "file" or environment_file.content is None:
        raise WorktreeIdentityError("Worktree environment is not a readable regular file.")
    if environment_file.owner != os.geteuid():
        raise WorktreeIdentityError("Worktree environment is not owned by the current user.")
    if environment_file.mode is None or environment_file.mode & 0o022:
        raise WorktreeIdentityError(
            "Worktree environment must not be writable by group or other users."
        )
    values = []
    for line in environment_file.content.splitlines():
        if not re.match(r"\s*(?:export\s+)?CUBRID_WORKTREE_ID\b", line):
            continue
        match = re.fullmatch(r"\s*(?:export\s+)?CUBRID_WORKTREE_ID\s*=\s*([^\s#]+)\s*", line)
        if not match:
            raise WorktreeIdentityError("CUBRID_WORKTREE_ID has invalid assignment syntax.")
        encoded_value = match.group(1)
        if encoded_value[:1] in ("'", '"'):
            if encoded_value[-1:] != encoded_value[0] or len(encoded_value) < 2:
                raise WorktreeIdentityError("CUBRID_WORKTREE_ID has invalid quoting.")
            encoded_value = encoded_value[1:-1]
        values.append(encoded_value)
    if not values:
        return None
    if len(values) != 1:
        raise WorktreeIdentityError("CUBRID_WORKTREE_ID must appear exactly once.")
    if not RUNTIME_ID_PATTERN.fullmatch(values[0]):
        raise WorktreeIdentityError("CUBRID_WORKTREE_ID has an invalid value.")
    return values[0]


def state_root() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    if not root.is_absolute():
        raise OperationError(
            "state_path_unsafe", "state root", root, "XDG_STATE_HOME",
            "The state root must be an absolute path.",
            "Set XDG_STATE_HOME to an absolute owner-controlled directory.",
        )
    return root / "cubrid-worktree-guard"


def ensure_safe_root(path: Path, source: str) -> Path:
    if not path.is_absolute():
        raise OperationError(
            "path_unsafe", "path", path, source,
            "The selected path is not absolute.",
            f"Set {source} to an absolute owner-controlled path.",
        )
    lexical = Path(os.path.abspath(path))
    resolved = path.resolve(strict=False)
    if resolved != lexical:
        raise OperationError(
            "path_unsafe", "path", path, source,
            "The selected path contains a symbolic-link alias.",
            f"Use the canonical non-symlink path for {source}.",
        )
    existing = path
    while not existing.exists():
        if existing.parent == existing:
            break
        existing = existing.parent
    if existing.exists():
        metadata = existing.stat()
        if metadata.st_uid != os.geteuid():
            raise OperationError(
                "path_wrong_owner", "path", existing, source,
                f"The nearest existing path owner is {metadata.st_uid}; expected {os.geteuid()}.",
                f"Choose an owner-controlled location for {source}.",
                expected_owner=os.geteuid(),
                observed_value=str(metadata.st_uid),
            )
        if stat.S_IMODE(metadata.st_mode) & 0o022:
            raise OperationError(
                "path_unsafe", "path", existing, source,
                "The nearest existing path is writable by group or other users.",
                f"Remove group/other write permission from {source}.",
            )
    return lexical


def require_private_directory_chain(root: Path, target: Path, source: str) -> None:
    lexical_root = Path(os.path.abspath(root))
    lexical_target = Path(os.path.abspath(target))
    try:
        relative = lexical_target.relative_to(lexical_root)
    except ValueError as error:
        raise OperationError(
            "path_unsafe",
            "private path",
            target,
            source,
            "The private path is outside its selected trusted root.",
            "Use the guard-managed private root for this runtime path.",
            expected_value=os.fspath(lexical_root),
            observed_value=os.fspath(lexical_target),
        ) from error
    components = [lexical_root]
    current = lexical_root
    for part in relative.parts:
        current /= part
        components.append(current)
    for current in components:
        try:
            metadata = current.lstat()
        except FileNotFoundError:
            break
        mode = stat.S_IMODE(metadata.st_mode)
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or mode & 0o022
            or not is_canonical_existing_path(current)
        ):
            raise OperationError(
                "path_unsafe",
                "private directory ancestor",
                current,
                source,
                "Every existing private-path component must be a canonical owner-controlled directory.",
                "Restore owner-controlled non-aliased directories without group/other write permission.",
                expected_owner=os.geteuid(),
                expected_value="directory without group/other write permission",
                observed_value=f"owner={metadata.st_uid},mode={mode:04o}",
            )


def is_canonical_existing_path(path: Path) -> bool:
    try:
        return path.resolve(strict=True) == Path(os.path.abspath(path))
    except OSError:
        return False


def is_owner_only_canonical_regular_file(
    path: Path, metadata: os.stat_result
) -> bool:
    return (
        stat.S_ISREG(metadata.st_mode)
        and metadata.st_uid == os.geteuid()
        and stat.S_IMODE(metadata.st_mode) == 0o600
        and is_canonical_existing_path(path)
    )


def make_private_directory(path: Path) -> None:
    missing: list[Path] = []
    cursor = path
    while True:
        try:
            cursor.lstat()
            break
        except FileNotFoundError:
            missing.append(cursor)
            if cursor.parent == cursor:
                break
            cursor = cursor.parent
    ancestor_metadata = cursor.lstat()
    if (
        not stat.S_ISDIR(ancestor_metadata.st_mode)
        or ancestor_metadata.st_uid != os.geteuid()
        or stat.S_IMODE(ancestor_metadata.st_mode) & 0o022
        or not is_canonical_existing_path(cursor)
    ):
        raise OperationError(
            "path_unsafe", "private directory ancestor", cursor,
            "guard-managed path",
            "A private directory ancestor must be canonical and owner-controlled.",
            "Choose an owner-controlled non-aliased parent directory.",
        )
    for directory in reversed(missing):
        try:
            directory.mkdir(mode=0o700)
        except FileExistsError:
            pass
        else:
            fsync_directory(directory.parent)
            fsync_directory(directory)
    metadata = path.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or not is_canonical_existing_path(path)
    ):
        raise OperationError(
            "path_unsafe", "private directory", path, "guard-managed path",
            "A guard-managed directory must be canonical, owner-controlled, and not a symlink.",
            "Replace the unsafe path with an owner-controlled directory.",
        )
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        path.chmod(0o700)
        fsync_directory(path)


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def open_private_lock(path: Path) -> int:
    no_follow = getattr(os, "O_NOFOLLOW", 0)
    close_on_exec = getattr(os, "O_CLOEXEC", 0)
    try:
        descriptor = os.open(
            path,
            os.O_RDWR | os.O_CREAT | os.O_EXCL | no_follow | close_on_exec,
            0o600,
        )
    except FileExistsError:
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            return open_private_lock(path)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or not is_canonical_existing_path(path)
        ):
            raise OperationError(
                "path_unsafe", "allocation lock", path, "guard state",
                "The allocation lock must be a canonical owner-only regular file.",
                "Restore a regular owner-owned lock with mode 0600 before retrying.",
            )
        try:
            descriptor = os.open(path, os.O_RDWR | no_follow | close_on_exec)
        except OSError as error:
            raise OperationError(
                "path_unsafe", "allocation lock", path, "guard state",
                "The allocation lock cannot be opened without following aliases.",
                "Restore the allocation lock before retrying.",
            ) from error
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        os.close(descriptor)
        raise OperationError(
            "path_unsafe", "allocation lock", path, "guard state",
            "The opened allocation lock is not an owner-only regular file.",
            "Restore the allocation lock before retrying.",
        )
    return descriptor


def atomic_write(path: Path, content: str, mode: int) -> None:
    if not path.parent.exists():
        path.parent.mkdir(mode=0o700, parents=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, path)
        fsync_directory(path.parent)
    except BaseException:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass
        raise


def atomic_json(path: Path, document: dict[str, object]) -> None:
    atomic_write(path, json.dumps(document, indent=2, sort_keys=True) + "\n", 0o600)


def file_hash(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def text_hash(content: str) -> str:
    return hashlib.sha256(content.encode()).hexdigest()


def file_identity(path: Path, kind: str) -> dict[str, str]:
    require_owned_installation_path(path, "file", kind)
    return {"path": os.fspath(path), "sha256": file_hash(path)}


def library_file_identity(
    path: Path, layout: InstallationLayout
) -> dict[str, str]:
    metadata = path.lstat()
    if stat.S_ISLNK(metadata.st_mode):
        if metadata.st_uid != os.geteuid():
            raise OperationError(
                "path_wrong_owner",
                "library symlink",
                path,
                "CUBRID installation",
                "A runtime-library symlink must be owned by the current user.",
                "Restore the private installation's library ownership.",
                expected_owner=os.geteuid(),
                observed_value=str(metadata.st_uid),
            )
        try:
            resolved = path.resolve(strict=True)
            resolved.relative_to(layout.root)
        except (OSError, ValueError) as error:
            raise OperationError(
                "path_unsafe",
                "library symlink",
                path,
                "CUBRID installation",
                "A runtime-library symlink must resolve inside the private installation.",
                "Restore an owner-controlled in-installation SONAME symlink.",
            ) from error
        require_owned_installation_path(resolved, "file", "library target")
        return {
            "path": os.fspath(path),
            "resolved_path": os.fspath(resolved),
            "sha256": file_hash(resolved),
        }
    identity = file_identity(path, "library")
    identity["resolved_path"] = os.fspath(path)
    return identity


def require_owned_installation_path(path: Path, expected_kind: str, label: str) -> None:
    try:
        metadata = path.lstat()
    except FileNotFoundError as error:
        raise OperationError(
            "installation_incomplete", label, path, "CUBRID installation",
            f"The selected installation is missing required {label} {path.name}.",
            "Complete the selected preset installation before initialization.",
        ) from error
    kind_matches = (
        expected_kind == "file" and stat.S_ISREG(metadata.st_mode)
    ) or (
        expected_kind == "directory" and stat.S_ISDIR(metadata.st_mode)
    )
    if not kind_matches or path.resolve(strict=True) != Path(os.path.abspath(path)):
        raise OperationError(
            "path_unsafe", label, path, "CUBRID installation",
            f"The required {label} must be a canonical non-symlink {expected_kind}.",
            "Replace aliases with an owner-controlled private installation path.",
        )
    if metadata.st_uid != os.geteuid():
        raise OperationError(
            "path_wrong_owner", label, path, "CUBRID installation",
            f"The required {label} owner is {metadata.st_uid}; expected {os.geteuid()}.",
            "Use an installation owned by the current user.",
            expected_owner=os.geteuid(),
            observed_value=str(metadata.st_uid),
        )
    if stat.S_IMODE(metadata.st_mode) & 0o022:
        raise OperationError(
            "path_unsafe", label, path, "CUBRID installation",
            f"The required {label} is writable by group or other users.",
            "Remove group/other write permission before initialization.",
        )


def parse_range(environment_name: str, default: tuple[int, int], maximum: int) -> tuple[int, int]:
    raw = os.environ.get(environment_name)
    if raw is None:
        return default
    match = re.fullmatch(r"\s*(0[xX][0-9a-fA-F]+|[0-9]+)\s*-\s*(0[xX][0-9a-fA-F]+|[0-9]+)\s*", raw)
    if not match:
        raise OperationError(
            "allocation_range_invalid", "allocation range", raw, environment_name,
            "The allocation range must be START-END using decimal or hexadecimal integers.",
            f"Correct or unset {environment_name}.",
        )
    start, end = (int(value, 0) for value in match.groups())
    if not 1 <= start <= end <= maximum:
        raise OperationError(
            "allocation_range_invalid", "allocation range", raw, environment_name,
            f"The allocation range must be ordered and lie between 1 and {maximum}.",
            f"Correct or unset {environment_name}.",
        )
    return start, end


def allocation_ranges() -> AllocationRanges:
    return AllocationRanges(
        master_ports=parse_range(
            "MY_CUBRID_RUNTIME_MASTER_PORT_RANGE",
            DEFAULT_MASTER_PORT_RANGE,
            65535,
        ),
        broker_ports=parse_range(
            "MY_CUBRID_RUNTIME_BROKER_PORT_RANGE",
            DEFAULT_BROKER_PORT_RANGE,
            65535,
        ),
        system_v_keys=parse_range(
            "MY_CUBRID_RUNTIME_SHM_KEY_RANGE",
            DEFAULT_SHM_KEY_RANGE,
            0x7FFFFFFF,
        ),
    )


def normalize_section_name(name: str) -> str:
    """Match CUBRID's INI section-name normalization."""
    return name if name.startswith("@") else name.casefold()


def parse_ini(content: str) -> dict[str, dict[str, str]]:
    sections: dict[str, dict[str, str]] = {}
    current = ""
    for line in content.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith(("#", ";")):
            continue
        section = re.fullmatch(r"\[([^]]+)\]", stripped)
        if section:
            current = normalize_section_name(section.group(1))
            sections.setdefault(current, {})
            continue
        assignment = re.match(r"\s*([^=#;\s]+)\s*=\s*([^#;]*?)\s*$", line)
        if assignment:
            sections.setdefault(current, {})[assignment.group(1).lower()] = assignment.group(2).strip()
    return sections


def normalize_decimal(value: str) -> str:
    try:
        return str(int(value.strip(), 10))
    except ValueError:
        return value.strip()


def normalize_boolean(value: str) -> str:
    normalized = value.strip().lower()
    if normalized in ("yes", "on", "true", "1"):
        return "yes"
    if normalized in ("no", "off", "false", "0"):
        return "no"
    return normalized


def normalize_ha_mode(value: str) -> str:
    normalized = value.strip().lower()
    return "off" if normalized in ("off", "no", "none", "false", "0") else normalized


def effective_engine_setting(
    content: str,
    database_name: str,
    names: tuple[str, ...],
    environment_names: tuple[str, ...],
    normalizer: Callable[[str], str],
    default: str,
) -> tuple[str, str]:
    """Resolve common, database, and environment precedence for one setting."""
    sections = parse_ini(content)
    selected_value = normalizer(default)
    selected_source = "CUBRID engine default"
    for section in ("common", f"@{database_name}"):
        declarations = [
            (name, normalizer(sections.get(section, {}).get(name, "")))
            for name in names
            if name in sections.get(section, {})
        ]
        distinct_values = {value for _, value in declarations}
        if len(distinct_values) > 1:
            rendered = ", ".join(f"{name}={value}" for name, value in declarations)
            raise OperationError(
                "configuration_contradictory",
                "engine setting",
                names[0],
                f"cubrid.conf [{section}]",
                f"Contradictory aliases declare {rendered}.",
                "Make aliases agree or keep only the canonical declaration, then rerun initialization while idle.",
                expected_value="one effective value",
                observed_value=rendered,
            )
        if declarations:
            selected_name, selected_value = declarations[-1]
            selected_source = f"cubrid.conf [{section}] {selected_name}"

    environment_declarations = [
        (name, normalizer(os.environ[name]))
        for name in environment_names
        if os.environ.get(name)
    ]
    environment_values = {value for _, value in environment_declarations}
    if len(environment_values) > 1:
        rendered = ", ".join(
            f"{name}={value}" for name, value in environment_declarations
        )
        raise OperationError(
            "configuration_contradictory",
            "environment override",
            names[0],
            "process environment",
            f"Contradictory environment aliases declare {rendered}.",
            "Remove contradictory inherited overrides before using the runtime.",
            expected_value="one effective value",
            observed_value=rendered,
        )
    if environment_declarations:
        environment_name, selected_value = environment_declarations[-1]
        selected_source = environment_name
    return selected_value, selected_source


def patch_ini(content: str, managed: dict[str, dict[str, str]]) -> str:
    lines = content.splitlines(keepends=True)
    found: set[tuple[str, str]] = set()
    managed_by_name = {
        normalize_section_name(section): section for section in managed
    }
    current_managed: str | None = managed_by_name.get("")
    output: list[str] = []
    for line in lines:
        section = re.fullmatch(r"\s*\[([^]]+)\]\s*(?:\r?\n)?", line)
        if section:
            if current_managed is not None:
                for key, value in managed[current_managed].items():
                    if (current_managed, key.lower()) not in found:
                        output.append(f"{key}={value}\n")
            current_managed = managed_by_name.get(
                normalize_section_name(section.group(1))
            )
            output.append(line)
            continue
        assignment = re.match(
            r"(\s*)([^=#;\s]+)(\s*)=(\s*)([^#;\r\n]*?)(\s*(?:[#;].*)?)(\r?\n)?$",
            line,
        )
        if assignment and current_managed is not None:
            key = assignment.group(2)
            selected = next(
                (
                    name
                    for name in managed[current_managed]
                    if name.lower() == key.lower()
                ),
                None,
            )
            if selected is not None:
                output.append(
                    f"{assignment.group(1)}{key}{assignment.group(3)}={assignment.group(4)}"
                    f"{managed[current_managed][selected]}{assignment.group(6)}"
                    f"{assignment.group(7) or ''}"
                )
                found.add((current_managed, selected.lower()))
                continue
        output.append(line)
    if current_managed is not None:
        for key, value in managed[current_managed].items():
            if (current_managed, key.lower()) not in found:
                output.append(f"{key}={value}\n")
    existing_sections = set(parse_ini(content))
    for section, values in managed.items():
        if normalize_section_name(section) not in existing_sections:
            if output and not output[-1].endswith("\n"):
                output[-1] += "\n"
            output.append(f"\n[{section}]\n")
            output.extend(f"{key}={value}\n" for key, value in values.items())
    return "".join(output)


def validate_database_name(name: str) -> None:
    if not DATABASE_NAME_PATTERN.fullmatch(name) or len(name.encode("ascii", "ignore")) != len(name):
        raise OperationError(
            "database_name_invalid", "database name", name, "init --db-name",
            "A database name must be 1-17 ASCII characters, start with a letter, and contain only letters, digits, or underscore.",
            "Choose a legal CUBRID database name before retrying initialization.",
        )


def default_database_name(worktree: Path, runtime_identifier: str) -> str:
    readable = re.sub(r"[^A-Za-z0-9_]", "_", worktree.name)
    readable = re.sub(r"_+", "_", readable).strip("_") or "runtime"
    if not readable[0].isalpha():
        readable = "db_" + readable
    suffix = runtime_identifier[:6]
    return f"{readable[:10]}_{suffix}"[:17]


def validate_socket_path(path: Path, source: str) -> None:
    try:
        size = len(os.fsencode(path))
    except UnicodeEncodeError as error:
        raise OperationError(
            "socket_path_invalid", "Unix socket path", path, source,
            "The Unix-socket pathname cannot be encoded for this filesystem.",
            "Choose an encodable shorter owner-controlled runtime path.",
        ) from error
    if size > UNIX_SOCKET_PATH_BYTES:
        raise OperationError(
            "socket_path_too_long", "Unix socket path", path, source,
            f"The encoded Unix-socket pathname is {size} bytes; the Linux limit is {UNIX_SOCKET_PATH_BYTES} bytes plus NUL.",
            "Choose a shorter HOME/runtime root or database name, then retry.",
        )


def hexadecimal_key(value: int) -> str:
    return f"0x{value:08x}"


def parse_broker_shm_key(value: str, field: str, section: str) -> int:
    if not re.fullmatch(r"(?:0[xX])?[0-9a-fA-F]+", value):
        raise OperationError(
            "broker_configuration_invalid",
            "broker shared-memory key",
            value,
            f"cubrid_broker.conf [{section}] {field}",
            f"{field} must be a System V key in CUBRID's hexadecimal grammar, not a kernel-assigned shmid.",
            "Correct the configured shared-memory key before retrying initialization.",
        )
    key = int(value, 16)
    if not 1 <= key <= 0x7FFFFFFF:
        raise OperationError(
            "broker_configuration_invalid",
            "broker shared-memory key",
            hexadecimal_key(key),
            f"cubrid_broker.conf [{section}] {field}",
            f"{field} is outside the supported positive System V key range.",
            "Correct the configured shared-memory key before retrying initialization.",
        )
    return key


def environment_assignment(name: str, value: str) -> str:
    return f"export {name}={shlex.quote(value)}\n"


def generated_environment_content(
    selection: RuntimeSelection,
    runtime_identifier: str,
    build_directory: str,
    bundle: ResourceBundle,
) -> str:
    installation = bundle.installation_root
    content = "# Generated by my-cubrid-runtime; source this file, do not eval command output.\n"
    content += "unset " + " ".join(
        (*HA_OVERRIDE_NAMES, *MANAGED_PARAMETER_OVERRIDE_NAMES)
    ) + "\n"
    content += environment_assignment("PRESET_MODE", selection.preset)
    content += environment_assignment("CUBRID_WORKTREE_ID", runtime_identifier)
    content += environment_assignment("CUBRID", os.fspath(installation))
    if bundle.engine_configuration != installation / "conf" / "cubrid.conf":
        content += environment_assignment(
            "CUBRID_CONF_FILE", os.fspath(bundle.engine_configuration)
        )
    else:
        content += "unset CUBRID_CONF_FILE\n"
    if bundle.broker_configuration != installation / "conf" / "cubrid_broker.conf":
        content += environment_assignment(
            "CUBRID_BROKER_CONF_FILE", os.fspath(bundle.broker_configuration)
        )
    else:
        content += "unset CUBRID_BROKER_CONF_FILE\n"
    content += environment_assignment("CUBRID_BUILD_DIR", build_directory)
    content += environment_assignment(
        "CUBRID_DATABASES", os.fspath(bundle.database_registry)
    )
    content += environment_assignment("CUBRID_TMP", os.fspath(bundle.cubrid_tmp))
    content += environment_assignment("CUBRID_RUNTIME_READY", "1")
    content += (
        f"export PATH={shlex.quote(os.fspath(bundle.executable_directory))}"
        "${PATH:+:$PATH}\n"
    )
    content += (
        "export LD_LIBRARY_PATH="
        f"{shlex.quote(os.fspath(bundle.library_directory))}"
        "${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\n"
    )
    return content


def read_json_file(path: Path, description: str) -> dict[str, object]:
    try:
        document = json.loads(path.read_text())
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise OperationError(
            f"{description}_malformed", description.replace("_", " "), path,
            "guard state", f"The {description.replace('_', ' ')} is not readable valid JSON.",
            "Inspect or restore guard state before retrying initialization.",
        ) from error
    if not isinstance(document, dict):
        raise OperationError(
            f"{description}_malformed", description.replace("_", " "), path,
            "guard state", f"The {description.replace('_', ' ')} root must be a JSON object.",
            "Inspect or restore guard state before retrying initialization.",
        )
    return document


def load_registry(path: Path) -> dict[str, object]:
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        return {"schema_version": STATE_SCHEMA_VERSION, "generation": 0, "allocations": {}}
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or not is_canonical_existing_path(path)
    ):
        raise OperationError(
            "allocation_registry_unsafe", "allocation registry", path, "guard state",
            "The allocation registry must be an owner-only regular file.",
            "Restore the registry owner and mode 0600 before retrying.",
        )
    registry = read_json_file(path, "allocation_registry")
    if (
        registry.get("schema_version") != STATE_SCHEMA_VERSION
        or type(registry.get("generation")) is not int
        or not isinstance(registry.get("allocations"), dict)
    ):
        raise OperationError(
            "allocation_registry_malformed", "allocation registry", path, "guard state",
            "The allocation registry schema is incomplete or unsupported.",
            "Inspect or restore the allocation registry before retrying.",
        )
    return registry


def selected_configuration_path(
    installation: Path,
    environment_name: str,
    default_name: str,
    label: str,
) -> Path:
    raw = os.environ.get(environment_name)
    path = Path(raw) if raw else installation / "conf" / default_name
    if not path.is_absolute():
        raise OperationError(
            "configuration_selection_invalid",
            label,
            path,
            environment_name if raw else "CUBRID installation",
            f"The selected {label} path must be absolute.",
            "Select a canonical configuration file in the private installation.",
            expected_value="absolute canonical path",
            observed_value=os.fspath(path),
        )
    require_owned_installation_path(path, "file", label)
    try:
        path.relative_to(installation / "conf")
    except ValueError as error:
        raise OperationError(
            "configuration_selection_invalid",
            label,
            path,
            environment_name if raw else "CUBRID installation",
            f"The selected {label} is outside the private installation configuration directory.",
            "Select an owner-controlled file under the private installation's conf directory.",
            expected_value=os.fspath(installation / "conf"),
            observed_value=os.fspath(path),
        ) from error
    return path


def installation_paths() -> InstallationLayout:
    raw = os.environ.get("CUBRID")
    if not raw:
        raise OperationError(
            "installation_missing", "installation", "CUBRID", "environment selection",
            "CUBRID must select the private installed prefix.",
            "Set CUBRID to the selected preset's private installation.",
        )
    installation = ensure_safe_root(Path(raw), "CUBRID")
    if os.pathsep in os.fspath(installation):
        raise OperationError(
            "path_list_ambiguous",
            "installation",
            installation,
            "CUBRID",
            "The selected installation contains the PATH list separator.",
            "Choose a private installation path without the PATH list separator.",
            expected_value=f"path without {os.pathsep!r}",
            observed_value=os.fspath(installation),
        )
    if not installation.is_dir():
        raise OperationError(
            "installation_missing", "installation", installation, "CUBRID",
            "The selected CUBRID installation directory does not exist.",
            "Complete the selected preset installation before initialization.",
        )
    engine = selected_configuration_path(
        installation, "CUBRID_CONF_FILE", "cubrid.conf", "engine configuration"
    )
    broker = selected_configuration_path(
        installation,
        "CUBRID_BROKER_CONF_FILE",
        "cubrid_broker.conf",
        "broker configuration",
    )
    binary = installation / "bin"
    library = installation / "lib"
    for path, expected_kind, label in (
        (binary, "directory", "executable directory"),
        (library, "directory", "library directory"),
    ):
        require_owned_installation_path(path, expected_kind, label)
    return InstallationLayout(installation, engine, broker, binary, library)


def capture_installation_identity(
    layout: InstallationLayout,
) -> dict[str, object]:
    executables = [
        file_identity(layout.executable_directory / name, "executable")
        for name in REQUIRED_EXECUTABLE_NAMES
    ]
    library_files = runtime_library_paths(layout.library_directory)
    if not library_files:
        raise OperationError(
            "installation_incomplete", "library directory", layout.library_directory,
            "CUBRID installation", "The selected installation contains no runtime libraries.",
            "Complete the selected preset installation before initialization.",
        )
    return {
        "root": os.fspath(layout.root),
        "bin": os.fspath(layout.executable_directory),
        "lib": os.fspath(layout.library_directory),
        "executables": executables,
        "libraries": [
            library_file_identity(path, layout)
            for path in library_files
        ],
    }


def runtime_library_paths(library_path: Path) -> list[Path]:
    return sorted(path for path in library_path.iterdir() if path.is_file())


def broker_inventory(content: str) -> list[BrokerSpec]:
    sections = parse_ini(content)
    broker_values = sections.get("broker", {})
    if "master_shm_id" in broker_values:
        parse_broker_shm_key(
            broker_values["master_shm_id"], "MASTER_SHM_ID", "broker"
        )
    enabled: list[BrokerSpec] = []
    for section, values in sections.items():
        if not section.startswith("%"):
            continue
        service = values.get("service", "ON").upper()
        if service not in ("ON", "OFF"):
            raise OperationError(
                "broker_configuration_invalid",
                "broker setting",
                "SERVICE",
                f"cubrid_broker.conf [{section}] SERVICE",
                "SERVICE must use CUBRID's ON or OFF broker grammar.",
                "Correct the broker configuration before initialization.",
                expected_value="ON or OFF",
                observed_value=service,
            )
        if service == "OFF":
            continue
        name = section[1:]
        if not re.fullmatch(r"[A-Za-z0-9_]+", name):
            raise OperationError(
                "broker_name_unsupported", "broker", section, "cubrid_broker.conf",
                "The enabled broker name cannot be represented safely in socket paths.",
                "Use a broker name containing only letters, digits, and underscore.",
            )
        try:
            maximum = int(values.get("max_num_appl_server", "40"), 10)
        except ValueError as error:
            raise OperationError(
                "broker_configuration_invalid", "broker", section, "cubrid_broker.conf",
                "MAX_NUM_APPL_SERVER must be a positive decimal integer.",
                "Correct the broker configuration before retrying initialization.",
            ) from error
        if maximum < 1:
            raise OperationError(
                "broker_configuration_invalid", "broker", section, "cubrid_broker.conf",
                "MAX_NUM_APPL_SERVER must be positive.",
                "Correct the broker configuration before retrying initialization.",
            )
        if "appl_server_shm_id" in values:
            parse_broker_shm_key(
                values["appl_server_shm_id"], "APPL_SERVER_SHM_ID", section
            )
        enabled.append(BrokerSpec(section, name, maximum))
    if not enabled:
        raise OperationError(
            "broker_scope_unsupported", "enabled brokers", str(len(enabled)), "cubrid_broker.conf",
            "At least one supported broker must be enabled.",
            "Enable a supported broker before retrying initialization.",
        )
    return enabled


def broker_spawn_environment_selections(
    broker_content: str,
    installation: Path,
    brokers: list[BrokerSpec] | tuple[BrokerAllocation, ...],
) -> list[tuple[str, Path]]:
    sections = parse_ini(broker_content)
    selections: list[tuple[str, Path]] = []
    for broker in brokers:
        raw = sections.get(broker.section, {}).get("source_env", "").strip()
        if not raw:
            continue
        path = Path(raw)
        if not path.is_absolute():
            path = installation / path
        require_owned_installation_path(
            path, "file", "broker spawn environment"
        )
        try:
            path.relative_to(installation)
        except ValueError as error:
            raise OperationError(
                "configuration_selection_invalid",
                "broker spawn environment",
                path,
                f"cubrid_broker.conf [{broker.section}] SOURCE_ENV",
                "The broker spawn environment is outside the private installation.",
                "Select an owner-controlled spawn environment in the private installation.",
                expected_value=os.fspath(installation),
                observed_value=os.fspath(path),
            ) from error
        selections.append((broker.section, path))
    return selections


def parse_broker_spawn_environment(content: str) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in content.splitlines():
        if not line or line.startswith("#"):
            continue
        columns = line.split()
        if len(columns) >= 2:
            values[columns[0]] = columns[1]
    return values


def validate_broker_spawn_environment_values(
    content: str,
    source: str,
    layout: InstallationLayout,
    bundle: ResourceBundle | None = None,
) -> None:
    values = parse_broker_spawn_environment(content)
    expected_identity = {
        "CUBRID": os.fspath(layout.root),
        "CUBRID_CONF_FILE": os.fspath(layout.engine_configuration),
        "CUBRID_BROKER_CONF_FILE": os.fspath(layout.broker_configuration),
        "PATH": os.fspath(layout.executable_directory),
        "LD_LIBRARY_PATH": os.fspath(layout.library_directory),
    }
    unsupported_or_deferred = set(HA_OVERRIDE_NAMES)
    if bundle is not None:
        expected_identity.update({
            "CUBRID_TMP": os.fspath(bundle.cubrid_tmp),
            "CUBRID_DATABASES": os.fspath(bundle.database_registry),
            "CUBRID_CUBRID_PORT_ID": str(bundle.master_port),
            "CUBRID_STORED_PROCEDURE_UDS": "yes",
            "CUBRID_JAVA_STORED_PROCEDURE_UDS": "yes",
            "CUBRID_STORED_PROCEDURE_PORT": "0",
            "CUBRID_JAVA_STORED_PROCEDURE_PORT": "0",
            "CUBRID_STORED_PROCEDURE_DEBUG": "-1",
            "CUBRID_JAVA_STORED_PROCEDURE_DEBUG": "-1",
        })
    else:
        unsupported_or_deferred.update(MANAGED_PARAMETER_OVERRIDE_NAMES)
        unsupported_or_deferred.update(("CUBRID_TMP", "CUBRID_DATABASES"))
    conflicting_name = next(
        (name for name in unsupported_or_deferred if name in values), None
    )
    if conflicting_name is not None:
        raise OperationError(
            "configuration_contradictory",
            "broker spawn environment setting",
            conflicting_name,
            source,
            f"{conflicting_name} cannot override the managed runtime configuration.",
            "Remove the broker spawn override before initialization.",
            observed_value="<redacted>",
        )
    for name, expected in expected_identity.items():
        if name not in values:
            continue
        observed = values[name]
        if name.endswith("_UDS"):
            matches = normalize_boolean(observed) == normalize_boolean(expected)
        elif name.endswith(("_PORT", "_DEBUG")):
            matches = normalize_decimal(observed) == normalize_decimal(expected)
        else:
            matches = observed == expected
        if not matches:
            raise OperationError(
                "configuration_contradictory",
                "broker spawn environment setting",
                name,
                source,
                f"{name} contradicts the managed runtime identity.",
                "Remove the contradictory broker spawn override before initialization.",
                expected_value=expected,
                observed_value="<redacted>",
            )


def capture_broker_spawn_environments(
    broker_content: str,
    layout: InstallationLayout,
    brokers: list[BrokerSpec] | tuple[BrokerAllocation, ...],
    bundle: ResourceBundle | None = None,
) -> list[dict[str, object]]:
    grouped: dict[Path, list[str]] = {}
    source_contents: dict[Path, str] = {}
    for section, path in broker_spawn_environment_selections(
        broker_content, layout.root, brokers
    ):
        content = path.read_text()
        validate_broker_spawn_environment_values(
            content,
            f"cubrid_broker.conf [{section}] SOURCE_ENV",
            layout,
            bundle,
        )
        grouped.setdefault(path, []).append(section)
        source_contents[path] = content
    return [
        {
            "path": os.fspath(path),
            "sha256": text_hash(source_contents[path]),
            "broker_sections": sections,
        }
        for path, sections in sorted(grouped.items(), key=lambda item: os.fspath(item[0]))
    ]


def raise_configuration_drift(
    setting: str,
    source: str,
    expected: str,
    observed: str,
    message: str,
) -> None:
    raise OperationError(
        "configuration_drift",
        "configuration setting",
        setting,
        source,
        message,
        "Rerun initialization while the selected runtime is idle.",
        normalized_value=observed,
        expected_value=expected,
        observed_value=observed,
    )


def validate_pl_configuration(
    engine_content: str,
    database_name: str,
    *,
    initializing: bool,
) -> None:
    uds_value, uds_source = effective_engine_setting(
        engine_content,
        database_name,
        ("stored_procedure_uds", "java_stored_procedure_uds"),
        (
            "CUBRID_STORED_PROCEDURE_UDS",
            "CUBRID_JAVA_STORED_PROCEDURE_UDS",
        ),
        normalize_boolean,
        "yes",
    )
    sections = parse_ini(engine_content)
    legacy_uds_disabled = None
    for section in ("common", f"@{database_name}"):
        legacy_uds = sections.get(section, {}).get("java_stored_procedure_uds")
        if legacy_uds is not None and normalize_boolean(legacy_uds) != "yes":
            legacy_uds_disabled = (section, normalize_boolean(legacy_uds))
            break
    if initializing and legacy_uds_disabled is not None:
        section, observed = legacy_uds_disabled
        raise OperationError(
            "component_unsupported",
            "engine setting",
            "java_stored_procedure_uds",
            f"cubrid.conf [{section}] java_stored_procedure_uds",
            "The legacy PL setting disables Unix-domain sockets.",
            "Set java_stored_procedure_uds=yes or remove the legacy alias.",
            expected_value="yes",
            observed_value=observed,
        )
    if not initializing and uds_value != "yes":
        raise OperationError(
            "component_unsupported",
            "engine setting",
            "stored_procedure_uds",
            uds_source,
            "PL must use Unix-domain sockets in the supported component scope.",
            "Enable stored_procedure_uds and rerun initialization while idle.",
            expected_value="yes",
            observed_value=uds_value,
        )

    for canonical, alias, environment_names, disabled in (
        (
            "stored_procedure_port",
            "java_stored_procedure_port",
            ("CUBRID_STORED_PROCEDURE_PORT", "CUBRID_JAVA_STORED_PROCEDURE_PORT"),
            "0",
        ),
        (
            "stored_procedure_debug",
            "java_stored_procedure_debug",
            ("CUBRID_STORED_PROCEDURE_DEBUG", "CUBRID_JAVA_STORED_PROCEDURE_DEBUG"),
            "-1",
        ),
    ):
        value, source = effective_engine_setting(
            engine_content,
            database_name,
            (canonical, alias),
            environment_names,
            normalize_decimal,
            disabled,
        )
        if value != disabled:
            component = "PL TCP" if canonical.endswith("port") else "PL JDWP/debug"
            next_action = (
                f"Set {canonical}={disabled} before initialization."
                if initializing
                else f"Set {canonical}={disabled} and rerun initialization while idle."
            )
            raise OperationError(
                "component_unsupported",
                "engine setting",
                canonical,
                source,
                f"{component} listeners are outside the supported component scope.",
                next_action,
                expected_value=disabled,
                observed_value=value,
            )


def validate_effective_configuration(
    bundle: ResourceBundle,
    engine_content: str,
    broker_content: str,
    gateway_content: str | None,
) -> None:
    validate_pl_configuration(
        engine_content, bundle.database_name, initializing=False
    )
    for setting, environment_name in (
        ("ha_mode", "CUBRID_HA_MODE"),
        ("ha_mode_for_sa_utils_only", "CUBRID_HA_MODE_FOR_SA_UTILS_ONLY"),
    ):
        value, source = effective_engine_setting(
            engine_content,
            bundle.database_name,
            (setting,),
            (environment_name,),
            normalize_ha_mode,
            "off",
        )
        if value != "off":
            raise OperationError(
                "component_unsupported",
                "engine setting",
                setting,
                source,
                "HA is outside the supported runtime-guard component scope.",
                "Disable HA and rerun initialization while idle.",
                expected_value="off",
                observed_value=value,
            )

    refuse_unsupported_configuration(
        engine_content,
        broker_content,
        gateway_content,
        check_engine_ha=False,
    )
    engine = parse_ini(engine_content)
    services = ",".join(
        token.strip().lower()
        for token in engine.get("service", {}).get("service", "").split(",")
        if token.strip()
    )
    if services != "server,broker":
        raise_configuration_drift(
            "service",
            "cubrid.conf [service] service",
            "server,broker",
            services,
            "The effective service list must contain server and broker in managed order.",
        )
    master_port, master_port_source = effective_engine_setting(
        engine_content,
        bundle.database_name,
        ("cubrid_port_id",),
        ("CUBRID_CUBRID_PORT_ID",),
        normalize_decimal,
        "1523",
    )
    if master_port != str(bundle.master_port):
        raise_configuration_drift(
            "cubrid_port_id",
            master_port_source,
            str(bundle.master_port),
            master_port,
            "The effective engine master port differs from the managed allocation.",
        )

    broker_sections = parse_ini(broker_content)
    current_brokers = broker_inventory(broker_content)
    current_names = [broker.section for broker in current_brokers]
    expected_names = [broker.section for broker in bundle.brokers]
    if current_names != expected_names:
        raise_configuration_drift(
            "enabled brokers",
            "cubrid_broker.conf SERVICE declarations",
            json.dumps(expected_names),
            json.dumps(current_names),
            "The enabled broker set or order differs from the managed resource bundle.",
        )
    master_value = broker_sections.get("broker", {}).get("master_shm_id")
    if master_value is None:
        raise_configuration_drift(
            "MASTER_SHM_ID",
            "cubrid_broker.conf [broker] MASTER_SHM_ID",
            hexadecimal_key(bundle.master_shm_key),
            "missing",
            "The broker master shared-memory key is missing.",
        )
    observed_master_key = parse_broker_shm_key(
        master_value, "MASTER_SHM_ID", "broker"
    )
    if observed_master_key != bundle.master_shm_key:
        raise_configuration_drift(
            "MASTER_SHM_ID",
            "cubrid_broker.conf [broker] MASTER_SHM_ID",
            hexadecimal_key(bundle.master_shm_key),
            hexadecimal_key(observed_master_key),
            "The broker master shared-memory key differs from the managed allocation.",
        )
    for broker in bundle.brokers:
        values = broker_sections[broker.section]
        checks = (
            (
                "BROKER_PORT",
                normalize_decimal(values.get("broker_port", "missing")),
                str(broker.port),
            ),
            (
                "MAX_NUM_APPL_SERVER",
                normalize_decimal(values.get("max_num_appl_server", "40")),
                str(broker.max_appl_servers),
            ),
        )
        for setting, observed, expected in checks:
            if observed != expected:
                raise_configuration_drift(
                    setting,
                    f"cubrid_broker.conf [{broker.section}] {setting}",
                    expected,
                    observed,
                    f"The enabled broker's {setting} differs from its managed allocation.",
                )
        appl_value = values.get("appl_server_shm_id")
        if appl_value is None:
            raise_configuration_drift(
                "APPL_SERVER_SHM_ID",
                f"cubrid_broker.conf [{broker.section}] APPL_SERVER_SHM_ID",
                hexadecimal_key(broker.appl_server_shm_key),
                "missing",
                "The enabled broker's application shared-memory key is missing.",
            )
        observed_appl_key = parse_broker_shm_key(
            appl_value, "APPL_SERVER_SHM_ID", broker.section
        )
        if observed_appl_key != broker.appl_server_shm_key:
            raise_configuration_drift(
                "APPL_SERVER_SHM_ID",
                f"cubrid_broker.conf [{broker.section}] APPL_SERVER_SHM_ID",
                hexadecimal_key(broker.appl_server_shm_key),
                hexadecimal_key(observed_appl_key),
                "The enabled broker's application shared-memory key differs from its managed allocation.",
            )


def expected_effective_configuration(bundle: ResourceBundle) -> dict[str, object]:
    return {
        "engine": {
            "database_section": f"@{bundle.database_name}",
            "service": "server,broker",
            "cubrid_port_id": str(bundle.master_port),
            "stored_procedure_uds": "yes",
            "stored_procedure_port": "0",
            "stored_procedure_debug": "-1",
        },
        "broker": {
            "MASTER_SHM_ID": hexadecimal_key(bundle.master_shm_key),
            "enabled_sections": [
                {
                    "section": broker.section,
                    "BROKER_PORT": str(broker.port),
                    "MAX_NUM_APPL_SERVER": str(broker.max_appl_servers),
                    "APPL_SERVER_SHM_ID": hexadecimal_key(
                        broker.appl_server_shm_key
                    ),
                }
                for broker in bundle.brokers
            ],
        },
    }


def configuration_manifest(
    bundle: ResourceBundle,
    spawn_environments: list[dict[str, object]],
    engine_hash: str | None,
    broker_hash: str | None,
) -> dict[str, object]:
    return {
        "engine": {
            "path": os.fspath(bundle.engine_configuration),
            "sha256": engine_hash,
        },
        "broker": {
            "path": os.fspath(bundle.broker_configuration),
            "sha256": broker_hash,
            "spawn_environments": spawn_environments,
        },
        "effective": expected_effective_configuration(bundle),
    }


def refuse_unsupported_configuration(
    engine_content: str,
    broker_content: str,
    gateway_content: str | None,
    *,
    allow_service_correction: bool = False,
    check_engine_ha: bool = True,
) -> None:
    engine = parse_ini(engine_content)
    service_tokens = {
        token.strip().lower()
        for token in engine.get("service", {}).get("service", "").split(",")
        if token.strip()
    }
    unsupported_services = service_tokens - {"server", "broker"}
    if allow_service_correction:
        unsupported_services -= {"manager"}
    if unsupported_services:
        observed = ",".join(sorted(unsupported_services))
        raise OperationError(
            "component_unsupported",
            "engine setting",
            "service",
            "cubrid.conf [service] service",
            "The service list enables components outside the supported server and broker scope.",
            "Keep service=server,broker, then rerun initialization while idle.",
            expected_value="server,broker",
            observed_value=observed,
        )
    if check_engine_ha:
        unsupported_ha = next(
            (
                (setting, normalize_ha_mode(values[setting]))
                for values in engine.values()
                for setting in ("ha_mode", "ha_mode_for_sa_utils_only")
                if setting in values and normalize_ha_mode(values[setting]) != "off"
            ),
            None,
        )
        if unsupported_ha is not None:
            setting, observed = unsupported_ha
            raise OperationError(
                "component_unsupported", "engine setting", setting, "cubrid.conf",
                "HA is outside the supported runtime-guard component scope.",
                "Disable HA before initializing this worktree runtime.",
                expected_value="off",
                observed_value=observed,
            )
    for section, values in parse_ini(broker_content).items():
        if section.startswith("%") and values.get("service", "ON").upper() == "ON":
            shard_enabled = values.get("shard", "OFF").upper() in (
                "ON",
                "YES",
                "TRUE",
                "1",
            )
            if shard_enabled:
                raise OperationError(
                    "component_unsupported",
                    "broker setting",
                    "SHARD",
                    f"cubrid_broker.conf [{section}] SHARD",
                    "Shard components are outside the supported component scope.",
                    "Disable shard mode before initialization.",
                    expected_value="OFF",
                    observed_value=values.get("shard", "OFF"),
                )
    if gateway_content is not None:
        enabled_gateway = next(
            (
                section
                for section, values in parse_ini(gateway_content).items()
                if section.startswith("%")
                and values.get("service", "ON").upper() == "ON"
            ),
            None,
        )
        if enabled_gateway is not None:
            raise OperationError(
                "component_unsupported",
                "gateway section",
                enabled_gateway,
                "cubrid_gateway.conf",
                "Gateway components are outside the supported component scope.",
                "Disable every gateway section before initialization.",
                expected_value="SERVICE=OFF",
                observed_value="SERVICE=ON",
            )


def refuse_effective_configuration_overrides() -> None:
    selected = next(
        (
            name
            for name in (*HA_OVERRIDE_NAMES, *MANAGED_PARAMETER_OVERRIDE_NAMES)
            if os.environ.get(name)
        ),
        None,
    )
    if selected is not None:
        raise OperationError(
            "effective_configuration_uncertain", "environment override", selected,
            "process environment",
            f"{selected} can contradict the private configuration managed by the runtime guard.",
            f"Unset {selected} before initializing this worktree runtime.",
            expected_value="unset",
            observed_value="<redacted>",
        )


def next_free(allocation_range: tuple[int, int], used: set[int], kind: str) -> int:
    for candidate in range(allocation_range[0], allocation_range[1] + 1):
        if candidate not in used:
            used.add(candidate)
            return candidate
    raise OperationError(
        "allocation_exhausted", kind, f"{allocation_range[0]}-{allocation_range[1]}",
        "configured allocation range", f"No free {kind} remains in the configured range.",
        "Expand the configured range or explicitly deinitialize an unused managed runtime.",
    )


def next_free_application_shm_key(
    allocation_range: tuple[int, int], used: set[int]
) -> tuple[int, int]:
    for candidate in range(allocation_range[0], allocation_range[1] + 1):
        derived = (candidate & 0x00FFFFFF) | 0x51000000
        if candidate in used or derived in used or candidate == derived:
            continue
        used.update((candidate, derived))
        return candidate, derived
    raise OperationError(
        "allocation_exhausted",
        "broker application shared-memory key",
        f"{allocation_range[0]}-{allocation_range[1]}",
        "configured allocation range",
        "No explicit key with a collision-free derived query-replacement key remains in the configured range.",
        "Expand the configured range or explicitly deinitialize an unused managed runtime.",
    )


def add_normalized_claims(
    claims: object,
    ports: set[int],
    keys: set[int],
    paths: set[Path],
    source: str,
) -> None:
    if not isinstance(claims, dict):
        raise OperationError(
            "managed_claims_invalid",
            "managed allocation",
            source,
            source,
            "A retained managed allocation has no normalized claims.",
            "Restore the complete retained allocation before initializing another runtime.",
        )
    tcp_ports = claims.get("tcp_ports")
    system_v_keys = claims.get("system_v_keys")
    claimed_paths = claims.get("paths")
    if (
        not isinstance(tcp_ports, list)
        or any(type(value) is not int for value in tcp_ports)
        or not isinstance(system_v_keys, list)
        or any(type(value) is not int for value in system_v_keys)
        or not isinstance(claimed_paths, list)
        or any(not isinstance(value, str) for value in claimed_paths)
    ):
        raise OperationError(
            "managed_claims_invalid",
            "managed allocation",
            source,
            source,
            "A retained managed allocation contains malformed numeric claims.",
            "Restore the complete retained allocation before initializing another runtime.",
        )
    ports.update(tcp_ports)
    keys.update(system_v_keys)
    paths.update(Path(value) for value in claimed_paths)


def all_claimed_values(
    registry: dict[str, object], selected_id: str, guard_root: Path
) -> tuple[set[int], set[int], set[Path]]:
    ports: set[int] = set()
    keys: set[int] = set()
    paths: set[Path] = set()
    allocations = registry["allocations"]
    assert isinstance(allocations, dict)
    for runtime_identifier, allocation in allocations.items():
        if runtime_identifier == selected_id:
            continue
        add_normalized_claims(
            allocation.get("claims") if isinstance(allocation, dict) else None,
            ports,
            keys,
            paths,
            f"allocation registry entry {runtime_identifier}",
        )
    worktrees_root = guard_root / "worktrees"
    if worktrees_root.exists():
        for runtime_directory in worktrees_root.iterdir():
            if runtime_directory.name == selected_id:
                continue
            manifest_path = runtime_directory / "manifest.json"
            if not manifest_path.exists():
                continue
            metadata = manifest_path.lstat()
            if not is_owner_only_canonical_regular_file(manifest_path, metadata):
                raise OperationError(
                    "managed_claims_invalid",
                    "worktree manifest",
                    manifest_path,
                    "guard state",
                    "A retained worktree manifest is not a canonical owner-only regular file.",
                    "Restore the retained manifest before initializing another runtime.",
                )
            manifest = read_json_file(manifest_path, "worktree_manifest")
            try:
                retained_bundle = ResourceBundle.from_dict(
                    manifest.get("resource_bundle")
                )
            except ValueError as error:
                raise OperationError(
                    "managed_claims_invalid",
                    "worktree manifest",
                    manifest_path,
                    "guard state",
                    f"A retained worktree manifest has an invalid resource bundle: {error}.",
                    "Restore the complete retained manifest before initializing another runtime.",
                ) from error
            retained_runtime_id = manifest.get("worktree_id")
            if (
                not isinstance(retained_runtime_id, str)
                or retained_runtime_id != runtime_directory.name
            ):
                raise OperationError(
                    "managed_claims_invalid",
                    "worktree manifest",
                    manifest_path,
                    "guard state",
                    "A retained worktree manifest has an inconsistent runtime identity.",
                    "Restore the complete retained manifest before initializing another runtime.",
                )
            try:
                validate_resource_bundle(
                    retained_bundle,
                    retained_runtime_id,
                    Path.home(),
                    os.fspath(manifest_path),
                    defer_managed_path_checks=True,
                )
            except OperationError as error:
                raise OperationError(
                    "managed_claims_invalid",
                    "worktree manifest",
                    manifest_path,
                    "guard state",
                    f"A retained worktree manifest has an unsafe or incomplete resource bundle: {error.diagnostic.message}",
                    "Restore the complete retained manifest before initializing another runtime.",
                ) from error
            retained_claims = retained_bundle.claims().to_dict()
            if manifest.get("normalized_claims") != retained_claims:
                raise OperationError(
                    "managed_claims_invalid",
                    "worktree manifest",
                    manifest_path,
                    "guard state",
                    "A retained worktree manifest's normalized claims do not match its complete resource bundle.",
                    "Restore matching retained bundle and claim data before initializing another runtime.",
                )
            add_normalized_claims(
                retained_claims,
                ports,
                keys,
                paths,
                os.fspath(manifest_path),
            )
    return ports, keys, paths


def reject_managed_claim_collisions(
    bundle: ResourceBundle,
    registry: dict[str, object],
    runtime_identifier: str,
    guard_root: Path,
) -> None:
    used_ports, used_keys, used_paths = all_claimed_values(
        registry, runtime_identifier, guard_root
    )
    claims = bundle.claims()
    conflicting_port = next(
        (port for port in claims.tcp_ports if port in used_ports), None
    )
    if conflicting_port is not None:
        raise OperationError(
            "managed_claim_collision",
            "TCP port",
            str(conflicting_port),
            "retained managed claims",
            "The complete resource bundle would reuse a TCP port claimed by another worktree runtime.",
            "Restore disjoint managed claims before retrying initialization.",
        )
    conflicting_key = next(
        (key for key in claims.system_v_keys if key in used_keys), None
    )
    if conflicting_key is not None:
        raise OperationError(
            "managed_claim_collision",
            "System V key",
            hexadecimal_key(conflicting_key),
            "retained managed claims",
            "The complete resource bundle would reuse a System V key claimed by another worktree runtime.",
            "Restore disjoint managed claims before retrying initialization.",
        )
    conflicting_path = next(
        (path for path in claims.paths if path in used_paths), None
    )
    if conflicting_path is not None:
        raise OperationError(
            "managed_path_collision",
            "managed path",
            conflicting_path,
            "retained managed claims",
            "The complete resource bundle would reuse a path claimed by another worktree runtime.",
            "Select a distinct private installation and runtime identity before retrying initialization.",
        )


def private_resource_roots(runtime_identifier: str) -> tuple[Path, Path, Path]:
    home = ensure_safe_root(Path.home(), "HOME")
    short_id = runtime_identifier[:8]
    cubrid_tmp = ensure_safe_root(
        home / ".cub" / "runtime" / short_id / "tmp", "HOME runtime root"
    )
    database_registry = ensure_safe_root(
        home / ".cub" / "db" / short_id / "commondb", "HOME database root"
    )
    return home, cubrid_tmp, database_registry


def generated_socket_paths(
    cubrid_tmp: Path,
    database_name: str,
    master_port: int,
    brokers: list[BrokerSpec],
) -> tuple[tuple[Path, ...], dict[str, tuple[Path, ...]], Path]:
    all_paths: list[Path] = [cubrid_tmp / f"CUBRID{master_port}"]
    paths_by_section: dict[str, tuple[Path, ...]] = {}
    for broker in brokers:
        broker_paths = [cubrid_tmp / f"{broker.name}.B"]
        broker_paths.extend(
            cubrid_tmp / f"{broker.name}.{number}"
            for number in range(1, broker.max_appl_servers + 1)
        )
        paths_by_section[broker.section] = tuple(broker_paths)
        all_paths.extend(broker_paths)
    pl_socket = cubrid_tmp / f"sp_{database_name}.sock"
    all_paths.append(pl_socket)
    return tuple(all_paths), paths_by_section, pl_socket


def create_resource_bundle(
    runtime_identifier: str,
    database_name: str,
    installation: Path,
    brokers: list[BrokerSpec],
    registry: dict[str, object],
    observations: RuntimeObservationSnapshot,
    guard_root: Path,
) -> ResourceBundle:
    used_ports, used_keys, _used_paths = all_claimed_values(
        registry, runtime_identifier, guard_root
    )
    used_ports.update(item["port"] for item in observations.listeners if type(item.get("port")) is int)
    used_keys.update(item["key"] for item in observations.system_v_ipc if type(item.get("key")) is int)
    ranges = allocation_ranges()
    master_port = next_free(ranges.master_ports, used_ports, "master TCP port")
    master_shm_key = next_free(
        ranges.system_v_keys, used_keys, "broker shared-memory key"
    )
    _, cubrid_tmp, database_registry = private_resource_roots(runtime_identifier)
    socket_paths, broker_socket_paths, pl_socket = generated_socket_paths(
        cubrid_tmp, database_name, master_port, brokers
    )
    configured_brokers: list[BrokerAllocation] = []
    for broker in brokers:
        port = next_free(ranges.broker_ports, used_ports, "broker TCP port")
        appl_key, derived = next_free_application_shm_key(
            ranges.system_v_keys, used_keys
        )
        configured_brokers.append(BrokerAllocation(
            section=broker.section,
            name=broker.name,
            max_appl_servers=broker.max_appl_servers,
            port=port,
            appl_server_shm_key=appl_key,
            query_replacement_shm_key=derived,
            socket_paths=broker_socket_paths[broker.section],
        ))
    for socket_path in socket_paths:
        validate_socket_path(socket_path, "generated resource bundle")
    database_base = database_registry
    return ResourceBundle(
        database_name=database_name,
        cubrid_tmp=cubrid_tmp,
        database_registry=database_registry,
        data_root=database_base / "data",
        log_root=database_base / "log",
        lob_root=database_base / "lob",
        master_port=master_port,
        master_shm_key=master_shm_key,
        brokers=tuple(configured_brokers),
        socket_paths=socket_paths,
        pl_socket_path=pl_socket,
        pl_mutable_paths=(
            ("info", installation / "var" / "pl" / f"pl_{database_name}.info"),
            ("installation_tmp", installation / "tmp"),
            ("log_root", installation / "log"),
        ),
        installation_root=installation,
        executable_directory=installation / "bin",
        library_directory=installation / "lib",
        engine_configuration=installation / "conf" / "cubrid.conf",
        broker_configuration=installation / "conf" / "cubrid_broker.conf",
    )


def preflight_resource_paths(
    runtime_identifier: str,
    database_name: str,
    brokers: list[BrokerSpec],
) -> None:
    ranges = allocation_ranges()
    home, cubrid_tmp, database_registry = private_resource_roots(runtime_identifier)
    require_private_directory_chain(home, cubrid_tmp, "HOME runtime root")
    require_private_directory_chain(
        home, database_registry, "HOME database root"
    )
    first_fit_paths, _, _ = generated_socket_paths(
        cubrid_tmp, database_name, ranges.master_ports[0], brokers
    )
    last_fit_paths, _, _ = generated_socket_paths(
        cubrid_tmp, database_name, ranges.master_ports[1], brokers
    )
    for socket_path in (*first_fit_paths, *last_fit_paths):
        validate_socket_path(socket_path, "generated resource bundle")


def validate_resource_bundle(
    bundle: ResourceBundle,
    runtime_identifier: str,
    expected_home: Path,
    source: str,
    defer_managed_path_checks: bool = False,
) -> None:
    """Reject retained state that could redirect mutation or omit a claim."""
    try:
        validate_database_name(bundle.database_name)
        safe_home = ensure_safe_root(expected_home, "HOME")
        short_id = runtime_identifier[:8]
        expected_tmp = safe_home / ".cub" / "runtime" / short_id / "tmp"
        expected_registry = safe_home / ".cub" / "db" / short_id / "commondb"
        expected_storage = (
            expected_registry / "data",
            expected_registry / "log",
            expected_registry / "lob",
        )
        if (
            bundle.cubrid_tmp != expected_tmp
            or bundle.database_registry != expected_registry
            or (bundle.data_root, bundle.log_root, bundle.lob_root) != expected_storage
        ):
            raise ValueError("private runtime and database roots are inconsistent")
        if not defer_managed_path_checks:
            for private_directory in (
                bundle.cubrid_tmp,
                bundle.database_registry,
                bundle.data_root,
                bundle.log_root,
                bundle.lob_root,
            ):
                require_private_directory_chain(
                    safe_home, private_directory, source
                )
        if not 1 <= bundle.master_port <= 65535 or not 1 <= bundle.master_shm_key <= 0x7FFFFFFF:
            raise ValueError("master port or shared-memory key is outside its legal range")
        if not bundle.brokers:
            raise ValueError("at least one enabled broker must be represented")

        expected_sockets: list[Path] = [
            bundle.cubrid_tmp / f"CUBRID{bundle.master_port}"
        ]
        for broker in bundle.brokers:
            if (
                broker.section != f"%{broker.name}"
                or not re.fullmatch(r"[A-Za-z0-9_]+", broker.name)
                or broker.max_appl_servers < 1
                or not 1 <= broker.port <= 65535
                or not 1 <= broker.appl_server_shm_key <= 0x7FFFFFFF
            ):
                raise ValueError("broker identity or numeric allocation is invalid")
            derived = (broker.appl_server_shm_key & 0x00FFFFFF) | 0x51000000
            if broker.query_replacement_shm_key != derived:
                raise ValueError("query-replacement shared-memory key is inconsistent")
            broker_sockets = [bundle.cubrid_tmp / f"{broker.name}.B"]
            broker_sockets.extend(
                bundle.cubrid_tmp / f"{broker.name}.{number}"
                for number in range(1, broker.max_appl_servers + 1)
            )
            if broker.socket_paths != tuple(broker_sockets):
                raise ValueError("broker socket list is incomplete or inconsistent")
            expected_sockets.extend(broker_sockets)
        expected_pl_socket = bundle.cubrid_tmp / f"sp_{bundle.database_name}.sock"
        expected_sockets.append(expected_pl_socket)
        if (
            bundle.pl_socket_path != expected_pl_socket
            or bundle.socket_paths != tuple(expected_sockets)
        ):
            raise ValueError("generated socket list is incomplete or inconsistent")

        ports = [bundle.master_port, *(broker.port for broker in bundle.brokers)]
        keys = [
            bundle.master_shm_key,
            *(broker.appl_server_shm_key for broker in bundle.brokers),
            *(broker.query_replacement_shm_key for broker in bundle.brokers),
        ]
        if len(ports) != len(set(ports)) or len(keys) != len(set(keys)):
            raise ValueError("TCP ports and System V keys must be distinct across roles")

        expected_installation_paths = (
            bundle.installation_root / "bin",
            bundle.installation_root / "lib",
        )
        if (
            bundle.executable_directory,
            bundle.library_directory,
        ) != expected_installation_paths:
            raise ValueError("installation paths are inconsistent")
        configuration_root = bundle.installation_root / "conf"
        for configuration_path in (
            bundle.engine_configuration,
            bundle.broker_configuration,
        ):
            try:
                configuration_path.relative_to(configuration_root)
            except ValueError as error:
                raise ValueError(
                    "configuration paths must remain inside the private installation"
                ) from error
        if any(
            os.pathsep in os.fspath(path)
            for path in (
                bundle.installation_root,
                bundle.executable_directory,
                bundle.library_directory,
            )
        ):
            raise ValueError("installation paths cannot contain the path-list separator")
        expected_mutable = (
            (
                "info",
                bundle.installation_root
                / "var"
                / "pl"
                / f"pl_{bundle.database_name}.info",
            ),
            ("installation_tmp", bundle.installation_root / "tmp"),
            ("log_root", bundle.installation_root / "log"),
        )
        if bundle.pl_mutable_paths != expected_mutable:
            raise ValueError("PL mutable paths are incomplete or inconsistent")

        all_paths = (
            *(path for _, path in bundle.pl_mutable_paths),
            bundle.installation_root,
            bundle.executable_directory,
            bundle.library_directory,
            bundle.engine_configuration,
            bundle.broker_configuration,
        )
        if not defer_managed_path_checks:
            all_paths = (
                bundle.cubrid_tmp,
                bundle.database_registry,
                bundle.data_root,
                bundle.log_root,
                bundle.lob_root,
                *bundle.socket_paths,
                *all_paths,
            )
        for path in all_paths:
            ensure_safe_root(path, source)
        for socket_path in bundle.socket_paths:
            validate_socket_path(socket_path, source)
    except OperationError:
        raise
    except ValueError as error:
        raise OperationError(
            "resource_bundle_invalid",
            "resource bundle",
            source,
            source,
            f"The retained resource bundle is unsafe or incomplete: {error}.",
            "Restore the canonical complete bundle or initialize a new worktree identity.",
        ) from error


def existing_bundle(
    manifest_path: Path,
    runtime_identifier: str,
    selection: RuntimeSelection,
) -> tuple[ResourceBundle, str] | None:
    try:
        metadata = manifest_path.lstat()
    except FileNotFoundError:
        return None
    if not is_owner_only_canonical_regular_file(manifest_path, metadata):
        raise OperationError(
            "path_unsafe", "worktree manifest", manifest_path, "guard state",
            "The retained worktree manifest must be a canonical owner-only regular file.",
            "Restore the manifest owner, mode 0600, and canonical location before retrying.",
        )
    manifest = read_json_file(manifest_path, "worktree_manifest")
    if manifest.get("schema_version") != STATE_SCHEMA_VERSION or manifest.get("worktree_id") != runtime_identifier:
        raise OperationError(
            "manifest_inconsistent", "worktree manifest", manifest_path, "guard state",
            "The existing worktree manifest has an unsupported schema or a different identity.",
            "Restore the manifest associated with this worktree before retrying.",
        )
    if (
        manifest.get("worktree_path") != os.fspath(selection.worktree)
        or manifest.get("git_common_dir") != os.fspath(selection.git_common_dir)
    ):
        raise OperationError(
            "worktree_identity_collision",
            "worktree identity",
            runtime_identifier,
            "retained worktree manifest",
            "The selected stable runtime identity is already associated with another Git worktree.",
            "Remove the copied CUBRID_WORKTREE_ID and initialize this worktree with a new identity.",
            expected_value=os.fspath(selection.worktree),
            observed_value=str(manifest.get("worktree_path")),
        )
    database_name = manifest.get("database_name")
    try:
        bundle = ResourceBundle.from_dict(manifest.get("resource_bundle"))
    except ValueError as error:
        raise OperationError(
            "manifest_incomplete", "worktree manifest", manifest_path, "guard state",
            f"The retained resource bundle is invalid: {error}.",
            "Inspect the retained initialization state before retrying.",
        ) from error
    if not isinstance(database_name, str) or bundle.database_name != database_name:
        raise OperationError(
            "manifest_incomplete", "worktree manifest", manifest_path, "guard state",
            "The existing worktree manifest does not retain a complete allocation.",
            "Inspect the retained initialization state before retrying.",
        )
    validate_resource_bundle(
        bundle,
        runtime_identifier,
        Path.home(),
        "retained worktree manifest resource bundle",
    )
    return bundle, database_name


def write_worktree_identity(worktree: Path, runtime_identifier: str) -> None:
    path = worktree / ".env"
    content = path.read_text() if path.exists() else ""
    lines = content.splitlines(keepends=True)
    matches = [
        index for index, line in enumerate(lines)
        if re.match(r"\s*(?:export\s+)?CUBRID_WORKTREE_ID\b", line)
    ]
    if len(matches) > 1:
        raise OperationError(
            "worktree_identity_invalid", "worktree environment", path, "worktree selection",
            "CUBRID_WORKTREE_ID must appear exactly once.",
            "Keep one valid CUBRID_WORKTREE_ID assignment before retrying.",
        )
    assignment = f"CUBRID_WORKTREE_ID={runtime_identifier}\n"
    if matches:
        lines[matches[0]] = assignment
    else:
        if content and not content.endswith(("\n", "\r")):
            lines.append("\n")
        lines.append(assignment)
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
    atomic_write(path, "".join(lines), mode)


def ready_result(
    command: Literal["init", "validate"],
    selection: RuntimeSelection,
    runtime_identifier: str,
    manifest_path: Path,
    environment_path: Path,
) -> ValidationResult:
    return ValidationResult(
        outcome="ready",
        selection=selection,
        command=command,
        worktree_id=runtime_identifier,
        manifest_path=os.fspath(manifest_path),
        environment_path=os.fspath(environment_path),
    )


def initialize(
    adapter: ObservationAdapter,
    selection: RuntimeSelection,
    database_override: str | None,
) -> tuple[ValidationResult, int]:
    if database_override is not None:
        validate_database_name(database_override)
    refuse_effective_configuration_overrides()
    try:
        selected_id = runtime_id(adapter, selection.worktree)
    except WorktreeIdentityError as error:
        raise OperationError(
            "worktree_identity_invalid", "worktree environment", selection.worktree / ".env",
            "worktree selection", str(error),
            "Keep one valid CUBRID_WORKTREE_ID assignment before retrying.",
        ) from error
    runtime_identifier = selected_id or uuid.uuid4().hex[:16]
    preview_database_name = database_override or default_database_name(
        selection.worktree, runtime_identifier
    )
    validate_database_name(preview_database_name)
    layout = installation_paths()
    installation = layout.root
    engine_path = layout.engine_configuration
    broker_path = layout.broker_configuration
    binary_path = layout.executable_directory
    library_path = layout.library_directory
    installation_document = capture_installation_identity(layout)
    engine_content = engine_path.read_text()
    broker_content = broker_path.read_text()
    gateway_path = installation / "conf" / "cubrid_gateway.conf"
    gateway_content = None
    if gateway_path.exists():
        require_owned_installation_path(
            gateway_path, "file", "gateway configuration"
        )
        gateway_content = gateway_path.read_text()
    validate_pl_configuration(
        engine_content, preview_database_name, initializing=True
    )
    refuse_unsupported_configuration(
        engine_content,
        broker_content,
        gateway_content,
        allow_service_correction=True,
    )
    brokers = broker_inventory(broker_content)
    capture_broker_spawn_environments(
        broker_content,
        layout,
        brokers,
    )
    guard_root = state_root()
    state_home = guard_root.parent
    ensure_safe_root(state_home, "XDG_STATE_HOME")
    require_private_directory_chain(
        state_home, guard_root, "XDG_STATE_HOME"
    )
    registry_path = guard_root / "allocations.json"
    lock_path = guard_root / "registry.lock"
    runtime_directory = guard_root / "worktrees" / runtime_identifier
    manifest_path = runtime_directory / "manifest.json"
    environment_path = runtime_directory / "env.sh"
    ensure_safe_root(Path.home(), "HOME")
    preflight_resource_paths(runtime_identifier, preview_database_name, brokers)
    observations = adapter.inspect_runtime()
    if not observations.complete:
        raise OperationError(
            "observation_incomplete", "runtime observation snapshot", selection.worktree,
            observations.source,
            "Initialization cannot prove that the selected runtime is idle.",
            "Retry when process, socket, listener, and System V IPC observations are complete.",
            "unknown",
            missing_evidence=("complete process, socket, listener, filesystem, configuration, and System V IPC visibility",),
            observation_scope=observations.scope,
        )
    guard_setup_would_mutate = False
    try:
        guard_metadata = guard_root.lstat()
    except FileNotFoundError:
        guard_setup_would_mutate = True
    else:
        if (
            stat.S_ISDIR(guard_metadata.st_mode)
            and guard_metadata.st_uid == os.geteuid()
            and is_canonical_existing_path(guard_root)
        ):
            guard_setup_would_mutate = (
                stat.S_IMODE(guard_metadata.st_mode) != 0o700
                or not lock_path.exists()
            )
    if guard_setup_would_mutate:
        preview_registry = load_registry(registry_path)
        preview_bundle = create_resource_bundle(
            runtime_identifier,
            preview_database_name,
            installation,
            brokers,
            preview_registry,
            observations,
            guard_root,
        ).for_installation(layout)
        require_mutation_safe_ownership(
            adapter,
            observations,
            selection,
            runtime_identifier,
            preview_bundle,
            installation_document,
            broker_content,
            layout,
            engine_content,
        )
    make_private_directory(guard_root)
    lock_descriptor = open_private_lock(lock_path)
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX)
        registry = load_registry(registry_path)
        retained = existing_bundle(manifest_path, runtime_identifier, selection)
        if retained is None:
            database_name = database_override or default_database_name(selection.worktree, runtime_identifier)
            validate_database_name(database_name)
            bundle = create_resource_bundle(
                runtime_identifier,
                database_name,
                installation,
                brokers,
                registry,
                observations,
                guard_root,
            )
            bundle = bundle.for_installation(layout)
        else:
            bundle, database_name = retained
            if database_override is not None and database_override != database_name:
                raise OperationError(
                    "database_name_inconsistent", "database name", database_override, "init --db-name",
                    f"The runtime already owns database identity {database_name!r}.",
                    "Omit --db-name or use the manifest's existing database name.",
                )
            bundle = bundle.for_installation(layout)
        reject_managed_claim_collisions(
            bundle, registry, runtime_identifier, guard_root
        )
        spawn_environments = require_mutation_safe_ownership(
            adapter,
            observations,
            selection,
            runtime_identifier,
            bundle,
            installation_document,
            broker_content,
            layout,
            engine_content,
        )
        claims = bundle.claims().to_dict()
        generation = int(registry["generation"]) + 1
        build_directory = os.environ.get(
            "CUBRID_BUILD_DIR",
            os.fspath(selection.worktree / f"build_preset_{selection.preset}"),
        )
        initializing_manifest: dict[str, object] = {
            "schema_version": STATE_SCHEMA_VERSION,
            "generation": generation,
            "state": "initializing",
            "worktree_id": runtime_identifier,
            "worktree_path": os.fspath(selection.worktree),
            "git_common_dir": os.fspath(selection.git_common_dir),
            "active_preset": selection.preset,
            "build_directory": build_directory,
            "database_name": database_name,
            "resource_bundle": bundle.to_dict(),
            "normalized_claims": claims,
            "installation": installation_document,
            "configurations": configuration_manifest(
                bundle, spawn_environments, None, None
            ),
            "generated_environment": {"path": os.fspath(environment_path), "sha256": None},
        }
        allocations = registry["allocations"]
        assert isinstance(allocations, dict)
        make_private_directory(guard_root / "worktrees")
        make_private_directory(runtime_directory)
        allocations[runtime_identifier] = {
            "generation": generation,
            "state": "initializing",
            "worktree_path": os.fspath(selection.worktree),
            "claims": claims,
        }
        registry["generation"] = generation
        atomic_json(registry_path, registry)
        atomic_json(manifest_path, initializing_manifest)

        for directory in (
            bundle.cubrid_tmp,
            bundle.database_registry,
            bundle.data_root,
            bundle.log_root,
            bundle.lob_root,
            installation / "var" / "pl",
        ):
            make_private_directory(directory)
        engine_managed = {
            "service": {"service": "server,broker"},
            "common": {"cubrid_port_id": str(bundle.master_port), "stored_procedure_uds": "yes"},
        }
        database_section = f"@{database_name}"
        if database_section in parse_ini(engine_content):
            engine_managed[database_section] = {
                "cubrid_port_id": str(bundle.master_port),
                "stored_procedure_uds": "yes",
            }
        broker_managed: dict[str, dict[str, str]] = {
            "broker": {"MASTER_SHM_ID": hexadecimal_key(bundle.master_shm_key)}
        }
        for broker in bundle.brokers:
            broker_managed[broker.section] = {
                "BROKER_PORT": str(broker.port),
                "APPL_SERVER_SHM_ID": hexadecimal_key(broker.appl_server_shm_key),
            }
        atomic_write(engine_path, patch_ini(engine_content, engine_managed), stat.S_IMODE(engine_path.stat().st_mode))
        atomic_write(broker_path, patch_ini(broker_content, broker_managed), stat.S_IMODE(broker_path.stat().st_mode))
        write_worktree_identity(selection.worktree, runtime_identifier)
        environment_content = generated_environment_content(
            selection,
            runtime_identifier,
            build_directory,
            bundle,
        )
        atomic_write(environment_path, environment_content, 0o600)
        initializing_manifest["configurations"] = configuration_manifest(
            bundle,
            spawn_environments,
            text_hash(engine_path.read_text()),
            text_hash(broker_path.read_text()),
        )
        initializing_manifest["generated_environment"] = {
            "path": os.fspath(environment_path),
            "sha256": text_hash(environment_path.read_text()),
        }
        initializing_manifest["state"] = "ready"
        allocations[runtime_identifier] = {
            "generation": generation,
            "state": "ready",
            "worktree_path": os.fspath(selection.worktree),
            "claims": claims,
        }
        atomic_json(manifest_path, initializing_manifest)
        atomic_json(registry_path, registry)
    finally:
        os.close(lock_descriptor)
    return ready_result("init", selection, runtime_identifier, manifest_path, environment_path), 0


def process_owns_socket_inode(process: dict[str, object], inode: int) -> bool:
    descriptors = process.get("fds")
    return isinstance(descriptors, list) and any(
        isinstance(descriptor, dict)
        and descriptor.get("socket_inode") == inode
        for descriptor in descriptors
    )


@dataclass(frozen=True)
class OwnershipAssessment:
    classification: Literal["free", "same-runtime", "conflict", "unknown"]
    kind: str = "runtime resource"
    value: str = ""
    normalized_value: str = ""
    observed_owner: str | None = None
    evidence: tuple[str, ...] = ()
    missing_evidence: tuple[str, ...] = ()
    message: str = ""


def ownership_assessment(
    classification: Literal["same-runtime", "conflict", "unknown"],
    kind: str,
    value: str,
    *,
    normalized_value: str | None = None,
    observed_owner: str | None = None,
    evidence: tuple[str, ...] = (),
    missing_evidence: tuple[str, ...] = (),
    message: str,
) -> OwnershipAssessment:
    return OwnershipAssessment(
        classification,
        kind,
        value,
        value if normalized_value is None else normalized_value,
        observed_owner,
        evidence,
        missing_evidence,
        message,
    )


def classify_process_identity(
    process: dict[str, object],
    snapshot: RuntimeObservationSnapshot,
    bundle: ResourceBundle,
    document: dict[str, object],
) -> tuple[Literal["same-runtime", "conflict", "unknown"], tuple[str, ...], tuple[str, ...], str]:
    pid = process.get("pid")
    owner = f"pid={pid}" if type(pid) is int else "unidentified process"
    if process.get("accessible") is not True:
        return "unknown", (), ("readable process metadata",), owner
    missing = tuple(
        field
        for field in (
            "pid", "start_time", "executable", "libraries", "loaded_files",
            "deleted_libraries", "namespaces", "configuration", "fds",
        )
        if process.get(field) is None
    )
    if missing:
        return "unknown", (), missing, owner
    scope_namespaces = snapshot.scope.get("namespaces")
    if not isinstance(scope_namespaces, dict) or process.get("namespaces") != scope_namespaces:
        return "unknown", ("process namespace view",), ("matching observer namespace view",), owner
    evidence = ("process start time", "process executable", "loaded libraries", "namespace view")
    runtime_id = process.get("managed_runtime_id")
    if isinstance(runtime_id, str) and runtime_id != document.get("worktree_id"):
        return "conflict", evidence + ("managed runtime identity",), (), f"worktree runtime {runtime_id} ({owner})"
    executable = process.get("executable")
    expected_executables = {
        os.fspath(bundle.executable_directory / name)
        for name in REQUIRED_EXECUTABLE_NAMES
    }
    if executable not in expected_executables:
        return "conflict", evidence, (), f"foreign executable {executable!r} ({owner})"
    libraries = process.get("libraries")
    installation = document.get("installation")
    if not isinstance(libraries, list) or not libraries or not isinstance(installation, dict):
        return "unknown", evidence, ("loaded-library identity",), owner
    library_records = installation.get("libraries")
    if not isinstance(library_records, list):
        return "unknown", evidence, ("manifest library identity",), owner
    expected_libraries = {
        record.get("resolved_path", record.get("path"))
        for record in library_records
        if isinstance(record, dict)
    }
    loaded_files = process.get("loaded_files")
    deleted_libraries = process.get("deleted_libraries")
    if not isinstance(loaded_files, list) or not isinstance(deleted_libraries, list):
        return "unknown", evidence, ("complete loaded-file identity",), owner
    if deleted_libraries:
        return "unknown", evidence, ("non-deleted loaded-library identity",), owner
    expected_library_names = {
        Path(path).name for path in expected_libraries if isinstance(path, str)
    }
    foreign_named_libraries = {
        path
        for path in loaded_files
        if isinstance(path, str)
        and Path(path).name in expected_library_names
        and path not in expected_libraries
    }
    if (
        any(library not in expected_libraries for library in libraries)
        or foreign_named_libraries
    ):
        return "conflict", evidence, (), f"foreign loaded libraries ({owner})"
    configuration = process.get("configuration")
    configurations = document.get("configurations")
    if not isinstance(configuration, dict) or not isinstance(configurations, dict):
        return "unknown", evidence, ("effective process configuration",), owner
    if configuration.get("evidence") != "launch-correlated":
        return "unknown", evidence, ("launch-correlated effective configuration",), owner
    engine = configurations.get("engine")
    broker = configurations.get("broker")
    if not isinstance(engine, dict) or not isinstance(broker, dict):
        return "unknown", evidence, ("manifest configuration identity",), owner
    expected_configuration = {
        "installation_root": os.fspath(bundle.installation_root),
        "cubrid_tmp": os.fspath(bundle.cubrid_tmp),
        "database_registry": os.fspath(bundle.database_registry),
        "active_preset": document.get("active_preset"),
        "engine_configuration": engine.get("path"),
        "engine_configuration_sha256": engine.get("sha256"),
        "broker_configuration": broker.get("path"),
        "broker_configuration_sha256": broker.get("sha256"),
    }
    missing_configuration = tuple(
        f"effective configuration {field}"
        for field in expected_configuration
        if field not in configuration
    )
    if missing_configuration:
        return "unknown", evidence, missing_configuration, owner
    if any(configuration[field] != value for field, value in expected_configuration.items()):
        return "unknown", evidence + ("effective process configuration",), ("configuration agreement",), owner
    return "same-runtime", evidence + ("effective process configuration",), (), f"worktree runtime {document.get('worktree_id')} ({owner})"


def classify_live_ownership(
    adapter: ObservationAdapter,
    snapshot: RuntimeObservationSnapshot,
    bundle: ResourceBundle,
    document: dict[str, object],
) -> OwnershipAssessment:
    claims = bundle.claims()
    scope_namespaces = snapshot.scope.get("namespaces")
    expected_network = scope_namespaces.get("network") if isinstance(scope_namespaces, dict) else None
    expected_ipc = scope_namespaces.get("ipc") if isinstance(scope_namespaces, dict) else None
    linked_pids: set[int] = set()
    saw_same_runtime = False
    same_runtime_observation: OwnershipAssessment | None = None

    for listener in snapshot.listeners:
        if listener.get("protocol") != "tcp" or listener.get("port") not in claims.tcp_ports:
            continue
        port = listener.get("port")
        address = listener.get("address")
        value = f"tcp://{address}:{port}"
        inode = listener.get("inode")
        required = tuple(
            field
            for field in ("address", "inode", "namespace", "owner_pid", "owner_start_time")
            if listener.get(field) is None
        )
        if required:
            return ownership_assessment(
                "unknown", "TCP listener", value, missing_evidence=required,
                evidence=("claimed TCP port",),
                message="The claimed listener lacks complete endpoint ownership evidence.",
            )
        if listener.get("namespace") != expected_network:
            return ownership_assessment(
                "unknown", "TCP listener", value,
                evidence=("listener namespace",), missing_evidence=("matching network namespace",),
                message="The listener is observed through a different network namespace view.",
            )
        assert type(inode) is int
        owners = [process for process in snapshot.processes if process_owns_socket_inode(process, inode)]
        if len(owners) != 1:
            return ownership_assessment(
                "unknown", "TCP listener", value,
                evidence=("listener socket inode",), missing_evidence=("unique process file-descriptor owner",),
                message="The listener inode does not resolve to exactly one visible process owner.",
            )
        owner = owners[0]
        if (
            owner.get("pid") != listener.get("owner_pid")
            or owner.get("start_time") != listener.get("owner_start_time")
        ):
            return ownership_assessment(
                "unknown", "TCP listener", value,
                observed_owner=f"pid={listener.get('owner_pid')}",
                evidence=("listener inode", "process file descriptor"),
                missing_evidence=("matching process start identity",),
                message="The listener owner PID was reused or its start identity disagrees.",
            )
        classification, evidence, missing, observed_owner = classify_process_identity(
            owner, snapshot, bundle, document
        )
        if type(owner.get("pid")) is int:
            linked_pids.add(owner["pid"])
        if classification != "same-runtime":
            return ownership_assessment(
                classification, "TCP listener", value, observed_owner=observed_owner,
                evidence=("listener address", "socket inode to file descriptor", *evidence),
                missing_evidence=missing,
                message=(
                    "The claimed listener is positively owned by another runtime."
                    if classification == "conflict"
                    else "The claimed listener owner cannot be identified safely."
                ),
            )
        if address != "0.0.0.0":
            return ownership_assessment(
                "unknown", "TCP listener", value, observed_owner=observed_owner,
                evidence=("listener address", "same-runtime process identity"),
                missing_evidence=("expected wildcard listener address 0.0.0.0",),
                message="The same-runtime process owns a listener at an unexpected address.",
            )
        saw_same_runtime = True
        same_runtime_observation = same_runtime_observation or ownership_assessment(
            "same-runtime", "TCP listener", value,
            observed_owner=observed_owner,
            evidence=("listener address", "socket inode to file descriptor", *evidence),
            message="The claimed listener is positively owned by this worktree runtime.",
        )

    for path in bundle.socket_paths:
        path_value = os.fspath(path)
        records = [record for record in snapshot.sockets if record.get("path") == path_value]
        filesystem = adapter.inspect_file(path)
        if not filesystem.accessible:
            return ownership_assessment(
                "unknown", "Unix socket", path_value,
                missing_evidence=("readable socket filesystem identity",),
                message="Permission denial prevents inspection of the claimed socket pathname.",
            )
        if not records and not filesystem.exists:
            continue
        if not records:
            return ownership_assessment(
                "unknown", "Unix socket", path_value,
                evidence=("filesystem pathname",), missing_evidence=("live Unix socket endpoint",),
                message="A claimed socket pathname exists without a correlated live endpoint.",
            )
        if len(records) != 1 or not filesystem.exists or filesystem.kind != "socket":
            return ownership_assessment(
                "unknown", "Unix socket", path_value,
                evidence=("Unix socket table",), missing_evidence=("matching socket filesystem identity",),
                message="The live Unix endpoint and its filesystem pathname disagree.",
            )
        record = records[0]
        inode = record.get("inode")
        required = tuple(
            field for field in (
                "inode", "namespace", "owner_pid", "owner_start_time",
                "device", "path_inode", "filesystem_identity_correlated",
            )
            if record.get(field) is None
        )
        if required:
            return ownership_assessment(
                "unknown", "Unix socket", path_value,
                evidence=("Unix socket pathname",), missing_evidence=required,
                message="The claimed Unix socket lacks complete ownership evidence.",
            )
        if (
            record.get("namespace") != expected_network
            or record.get("device") != filesystem.device
            or record.get("path_inode") != filesystem.inode
            or record.get("filesystem_identity_correlated") is not True
        ):
            return ownership_assessment(
                "unknown", "Unix socket", path_value,
                evidence=("Unix socket endpoint", "filesystem identity"),
                missing_evidence=("matching namespace and filesystem identity",),
                message="The Unix socket endpoint, namespace, or filesystem identity disagrees.",
            )
        assert type(inode) is int
        owners = [process for process in snapshot.processes if process_owns_socket_inode(process, inode)]
        if len(owners) != 1:
            return ownership_assessment(
                "unknown", "Unix socket", path_value,
                evidence=("Unix socket inode",), missing_evidence=("unique process file-descriptor owner",),
                message="The Unix socket inode does not resolve to one visible owner.",
            )
        owner = owners[0]
        if owner.get("pid") != record.get("owner_pid") or owner.get("start_time") != record.get("owner_start_time"):
            return ownership_assessment(
                "unknown", "Unix socket", path_value,
                evidence=("Unix socket inode", "process file descriptor"),
                missing_evidence=("matching process start identity",),
                message="The Unix socket owner PID or start identity disagrees.",
            )
        classification, evidence, missing, observed_owner = classify_process_identity(owner, snapshot, bundle, document)
        if type(owner.get("pid")) is int:
            linked_pids.add(owner["pid"])
        if classification != "same-runtime":
            return ownership_assessment(
                classification, "Unix socket", path_value, observed_owner=observed_owner,
                evidence=("socket inode to file descriptor", "filesystem identity", *evidence),
                missing_evidence=missing,
                message=("The claimed Unix socket is owned by another runtime." if classification == "conflict" else "The claimed Unix socket owner is unknown."),
            )
        saw_same_runtime = True
        same_runtime_observation = same_runtime_observation or ownership_assessment(
            "same-runtime", "Unix socket", path_value,
            observed_owner=observed_owner,
            evidence=("socket inode to file descriptor", "filesystem identity", *evidence),
            message="The claimed Unix socket is positively owned by this worktree runtime.",
        )

    for segment in snapshot.system_v_ipc:
        if segment.get("key") not in claims.system_v_keys:
            continue
        key = segment.get("key")
        value = hexadecimal_key(key) if type(key) is int else str(key)
        required = tuple(
            field for field in ("shmid", "uid", "cpid", "ctime", "nattch", "namespace")
            if segment.get(field) is None
        )
        if required:
            return ownership_assessment(
                "unknown", "System V shared-memory key", value,
                evidence=("configured System V key",), missing_evidence=required,
                message="The claimed System V segment metadata is incomplete.",
            )
        if segment.get("namespace") != expected_ipc:
            return ownership_assessment(
                "unknown", "System V shared-memory key", value,
                evidence=("System V segment namespace",), missing_evidence=("matching IPC namespace",),
                message="The System V segment is observed in a different IPC namespace.",
            )
        creator_processes = [
            process for process in snapshot.processes
            if process.get("pid") == segment.get("cpid")
        ]
        if len(creator_processes) == 1:
            creator_start_wall_ns = creator_processes[0].get("start_wall_ns")
            if type(creator_start_wall_ns) is not int:
                return ownership_assessment(
                    "unknown", "System V shared-memory key", value,
                    evidence=("System V creator PID",),
                    missing_evidence=("creator process wall-clock start",),
                    message="The System V creator process generation cannot be established.",
                )
            creator_start_second = creator_start_wall_ns // 1_000_000_000
            if creator_start_second > segment["ctime"]:
                return ownership_assessment(
                    "unknown", "System V shared-memory key", value,
                    evidence=("System V creator PID", "process wall-clock start"),
                    missing_evidence=("matching creator process generation",),
                    message="The System V creator PID belongs to a newer process generation.",
                )
            if creator_start_second == segment["ctime"]:
                return ownership_assessment(
                    "unknown", "System V shared-memory key", value,
                    evidence=("System V creator PID", "second-resolution creation time"),
                    missing_evidence=("precise creator process generation",),
                    message="The System V creation timestamp cannot distinguish same-second PID reuse.",
                )
        if segment.get("creator_pid_reused") is True:
            return ownership_assessment(
                "unknown", "System V shared-memory key", value,
                evidence=("System V creator PID", "process wall-clock start"),
                missing_evidence=("matching creator process generation",),
                message="The System V creator PID belongs to a newer process generation.",
            )
        if segment.get("owner_classification") == "unmanaged":
            return ownership_assessment(
                "conflict", "System V shared-memory key", value,
                observed_owner=f"unmanaged segment shmid={segment.get('shmid')} uid={segment.get('uid')}",
                evidence=("System V key", "shmid", "owner UID", "creation time", "attachment count", "IPC namespace", "unmanaged owner classification"),
                message="An unmanaged live System V segment occupies the claimed key.",
            )
        owners = [
            process
            for process in snapshot.processes
            if isinstance(process.get("system_v_keys"), list)
            and key in process["system_v_keys"]
        ]
        if not owners:
            return ownership_assessment(
                "unknown", "System V shared-memory key", value,
                evidence=("System V segment metadata",), missing_evidence=("visible process attachment to the System V key",),
                message="The System V segment cannot be correlated to a visible attached process.",
            )
        creator_start_time = segment.get("process_start_time")
        if creator_start_time is not None and (
            len(creator_processes) != 1
            or creator_processes[0].get("start_time") != creator_start_time
        ):
            return ownership_assessment(
                "unknown", "System V shared-memory key", value,
                evidence=("System V creator PID",), missing_evidence=("matching process start identity",),
                message="The System V creator PID was reused or its start identity disagrees.",
            )
        owner_descriptions: list[str] = []
        segment_evidence: tuple[str, ...] = ()
        for owner in owners:
            classification, evidence, missing, observed_owner = classify_process_identity(
                owner, snapshot, bundle, document
            )
            if type(owner.get("pid")) is int:
                linked_pids.add(owner["pid"])
            if classification != "same-runtime":
                return ownership_assessment(
                    classification, "System V shared-memory key", value, observed_owner=observed_owner,
                    evidence=("System V key metadata", "live process attachment", *evidence), missing_evidence=missing,
                    message=("The claimed System V segment is owned by another runtime." if classification == "conflict" else "The claimed System V segment owner is unknown."),
                )
            owner_descriptions.append(observed_owner)
            segment_evidence = evidence
        saw_same_runtime = True
        same_runtime_observation = same_runtime_observation or ownership_assessment(
            "same-runtime", "System V shared-memory key", value,
            observed_owner=", ".join(owner_descriptions),
            evidence=("System V key metadata", "live process attachment", *segment_evidence),
            message="The claimed System V segment is positively owned by this worktree runtime.",
        )

    expected_executables = {
        os.fspath(bundle.executable_directory / name)
        for name in REQUIRED_EXECUTABLE_NAMES
    }
    expected_configuration_values = {
        os.fspath(bundle.installation_root),
        os.fspath(bundle.cubrid_tmp),
        os.fspath(bundle.database_registry),
    }
    for process in snapshot.processes:
        pid = process.get("pid")
        executable = process.get("executable")
        configuration = process.get("configuration")
        relevant = executable in expected_executables or (
            isinstance(configuration, dict)
            and any(value in expected_configuration_values for value in configuration.values())
        )
        if relevant and pid not in linked_pids:
            return ownership_assessment(
                "unknown", "CUBRID process", f"pid={pid}",
                observed_owner=f"pid={pid}", evidence=("process identity",),
                missing_evidence=("claimed endpoint or System V correlation",),
                message="A CUBRID process is visible without a correlated claimed resource.",
            )
    if saw_same_runtime:
        assert same_runtime_observation is not None
        return same_runtime_observation
    return OwnershipAssessment("free")


def ownership_failure_result(
    selection: RuntimeSelection,
    snapshot: RuntimeObservationSnapshot,
    runtime_id_value: str,
    assessment: OwnershipAssessment,
) -> ValidationResult:
    conflict = assessment.classification == "conflict"
    return invalid_result(
        selection,
        assessment.value,
        "live_ownership_conflict" if conflict else "live_ownership_unknown",
        assessment.message,
        "definitive" if conflict else "unknown",
        affected_kind=assessment.kind,
        source=snapshot.source,
        next_action=(
            "Stop the foreign owner through its normal lifecycle command or select another resource."
            if conflict
            else "Restore complete read access and reconcile the contradictory evidence before retrying."
        ),
        normalized_value=assessment.normalized_value,
        expected_owner=f"worktree runtime {runtime_id_value}",
        observed_owner=assessment.observed_owner,
        evidence=assessment.evidence,
        missing_evidence=assessment.missing_evidence,
        observation_scope=snapshot.scope,
    )


def positive_ownership_report(
    snapshot: RuntimeObservationSnapshot,
    runtime_id_value: str,
    assessment: OwnershipAssessment,
) -> dict[str, object]:
    return {
        "classification": assessment.classification,
        "affected_object": {
            "kind": assessment.kind,
            "value": assessment.value,
        },
        "normalized_value": assessment.normalized_value,
        "expected_owner": f"worktree runtime {runtime_id_value}",
        "observed_owner": assessment.observed_owner,
        "evidence": list(assessment.evidence),
        "missing_evidence": list(assessment.missing_evidence),
        "observation_scope": snapshot.scope,
        "message": assessment.message,
        "next_action": "No action is required; continue using read-only validation before runtime use.",
    }


def ownership_operation_error(
    snapshot: RuntimeObservationSnapshot,
    runtime_id_value: str,
    assessment: OwnershipAssessment,
) -> OperationError:
    conflict = assessment.classification == "conflict"
    live = assessment.classification == "same-runtime"
    return OperationError(
        (
            "runtime_mutation_live"
            if live
            else "live_ownership_conflict"
            if conflict
            else "live_ownership_unknown"
        ),
        assessment.kind,
        assessment.value or runtime_id_value,
        snapshot.source,
        (
            "Mutation is unsafe while the selected worktree runtime owns a live resource."
            if live
            else assessment.message
        ),
        (
            "Stop the selected runtime through normal CUBRID lifecycle commands and retry."
            if live
            else "Stop the foreign owner through its normal lifecycle command or select another resource."
            if conflict
            else "Restore complete read access and reconcile the contradictory evidence before retrying."
        ),
        "definitive" if live or conflict else "unknown",
        normalized_value=assessment.normalized_value or runtime_id_value,
        expected_owner=f"worktree runtime {runtime_id_value}",
        observed_owner=assessment.observed_owner,
        evidence=assessment.evidence,
        missing_evidence=assessment.missing_evidence,
        observation_scope=snapshot.scope,
    )


def require_mutation_safe_ownership(
    adapter: ObservationAdapter,
    observations: RuntimeObservationSnapshot,
    selection: RuntimeSelection,
    runtime_identifier: str,
    bundle: ResourceBundle,
    installation_document: dict[str, object],
    broker_content: str,
    layout: InstallationLayout,
    engine_content: str,
) -> list[dict[str, object]]:
    spawn_environments = capture_broker_spawn_environments(
        broker_content,
        layout,
        bundle.brokers,
        bundle,
    )
    ownership_document: dict[str, object] = {
        "worktree_id": runtime_identifier,
        "active_preset": selection.preset,
        "installation": installation_document,
        "configurations": configuration_manifest(
            bundle,
            spawn_environments,
            text_hash(engine_content),
            text_hash(broker_content),
        ),
    }
    ownership = classify_live_ownership(
        adapter, observations, bundle, ownership_document
    )
    if ownership.classification != "free":
        raise ownership_operation_error(
            observations, runtime_identifier, ownership
        )
    return spawn_environments


def validate(
    adapter: ObservationAdapter,
    selection: RuntimeSelection,
) -> tuple[ValidationResult, int]:
    worktree = selection.worktree
    try:
        selected_runtime_id = runtime_id(adapter, worktree)
    except WorktreeIdentityError as error:
        return invalid_result(
            selection, worktree / ".env", "worktree_identity_invalid",
            str(error), affected_kind="worktree environment",
            source="worktree selection",
            next_action=(
                "Keep exactly one valid CUBRID_WORKTREE_ID in .env, "
                "then retry validation"
            ),
        ), EXIT_INVALID
    if selected_runtime_id is None:
        return uninitialized_result(selection), EXIT_UNINITIALIZED
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    )
    manifest_path = (
        state_home
        / "cubrid-worktree-guard"
        / "worktrees"
        / selected_runtime_id
        / "manifest.json"
    )
    manifest = adapter.inspect_file(manifest_path)
    if not manifest.exists:
        return uninitialized_result(selection), EXIT_UNINITIALIZED

    def reject_manifest(
        code: str,
        message: str,
        evidence_quality: Literal["definitive", "unknown"] = "definitive",
    ) -> tuple[ValidationResult, int]:
        return invalid_result(
            selection,
            manifest_path,
            code,
            message,
            evidence_quality,
            expected_owner=os.geteuid(),
        ), EXIT_INVALID

    if manifest.kind != "file":
        return reject_manifest(
            "manifest_wrong_type", f"Manifest must be a regular file, not {manifest.kind}."
        )
    if manifest.owner != os.geteuid():
        return reject_manifest(
            "manifest_wrong_owner",
            f"Manifest owner is {manifest.owner}; expected {os.geteuid()}.",
        )
    if manifest.mode != 0o600:
        actual_mode = "unknown" if manifest.mode is None else f"{manifest.mode:04o}"
        return reject_manifest(
            "manifest_wrong_mode", f"Manifest mode is {actual_mode}; expected 0600."
        )
    if manifest.canonical is not True:
        return reject_manifest(
            "manifest_path_unsafe", "Manifest path contains an unsafe alias."
        )
    if manifest.content is None:
        return reject_manifest("manifest_unreadable", "Manifest could not be read.", "unknown")
    try:
        document = json.loads(manifest.content)
    except (json.JSONDecodeError, UnicodeError):
        return reject_manifest("manifest_malformed", "Manifest is not valid JSON.")
    if not isinstance(document, dict):
        return reject_manifest("manifest_malformed", "Manifest root must be a JSON object.")
    version = document.get("schema_version")
    if type(version) is not int:
        return reject_manifest(
            "manifest_malformed", "Manifest schema_version must be an integer."
        )
    if version != 1:
        return reject_manifest(
            "manifest_unsupported_version",
            f"Manifest schema version {version} is unsupported; expected version 1.",
        )
    required_types = {
        "generation": int,
        "state": str,
        "worktree_id": str,
        "worktree_path": str,
        "git_common_dir": str,
        "active_preset": str,
        "resource_bundle": dict,
    }
    if any(type(document.get(field)) is not expected for field, expected in required_types.items()):
        return reject_manifest(
            "manifest_malformed",
            "Manifest is missing required state fields or contains fields of the wrong type.",
        )
    if document["generation"] < 1:
        return reject_manifest(
            "manifest_malformed", "Manifest generation must be a positive integer."
        )
    comparisons = (
        (
            document["worktree_id"], selected_runtime_id, "worktree ID",
            "worktree identity", "worktree manifest worktree_id",
            "Make .env and the manifest select the same CUBRID_WORKTREE_ID, then retry.",
        ),
        (
            document["worktree_path"], os.fspath(worktree), "worktree path",
            "worktree path", "worktree manifest worktree_path",
            "Use the manifest from this canonical worktree path, then retry.",
        ),
        (
            document["git_common_dir"], os.fspath(selection.git_common_dir),
            "Git common directory", "Git common directory",
            "worktree manifest git_common_dir",
            "Restore the manifest associated with this Git worktree, then retry.",
        ),
        (
            document["active_preset"], selection.preset, "active preset",
            "active preset", "worktree manifest active_preset",
            "Select the manifest's active preset or keep the worktree build-only.",
        ),
    )
    for actual, expected, label, kind, source, next_action in comparisons:
        if actual != expected:
            diagnostic_expected = actual if label == "active preset" else expected
            diagnostic_observed = expected if label == "active preset" else actual
            return invalid_result(
                selection, diagnostic_observed, "manifest_inconsistent",
                f"Manifest {label} does not match the selected worktree runtime.",
                affected_kind=kind,
                source=source,
                next_action=next_action,
                normalized_value=diagnostic_observed,
                expected_value=diagnostic_expected,
                observed_value=diagnostic_observed,
            ), EXIT_INVALID
    selected_build_directory = os.environ.get("CUBRID_BUILD_DIR")
    recorded_build_directory = document.get("build_directory")
    if recorded_build_directory is not None and not isinstance(
        recorded_build_directory, str
    ):
        return reject_manifest(
            "manifest_malformed", "Manifest build_directory must be a string."
        )
    if (
        recorded_build_directory is not None
        and selected_build_directory is not None
        and selected_build_directory != recorded_build_directory
    ):
        return invalid_result(
            selection,
            selected_build_directory,
            "active_preset_inconsistent",
            "CUBRID_BUILD_DIR does not match the active preset's recorded build directory.",
            affected_kind="build directory",
            source="CUBRID_BUILD_DIR",
            next_action="Select only the manifest's active preset before using the runtime.",
            expected_value=recorded_build_directory,
            observed_value=selected_build_directory,
        ), EXIT_INVALID
    if document["state"] != "ready":
        return reject_manifest("manifest_not_ready", "Manifest transaction state is not ready.")
    if not document["resource_bundle"]:
        return reject_manifest(
            "manifest_incomplete",
            "Manifest does not contain a complete resource bundle.",
        )
    runtime_observations = adapter.inspect_runtime()
    if not runtime_observations.complete:
        return invalid_result(
            selection,
            os.fspath(worktree),
            "observation_incomplete",
            "Runtime process, socket, listener, or System V IPC evidence is incomplete.",
            "unknown",
            affected_kind="runtime observation snapshot",
            source=runtime_observations.source,
            next_action="Retry validation when every runtime observation source is readable.",
            missing_evidence=("complete process, socket, listener, filesystem, configuration, and System V IPC visibility",),
            observation_scope=runtime_observations.scope,
        ), EXIT_INVALID
    database_name = document.get("database_name")
    claims = document.get("normalized_claims")
    installation = document.get("installation")
    configurations = document.get("configurations")
    generated_environment = document.get("generated_environment")
    if (
        not isinstance(database_name, str)
        or not isinstance(claims, dict)
        or not isinstance(installation, dict)
        or not isinstance(configurations, dict)
        or not isinstance(generated_environment, dict)
    ):
        return reject_manifest(
            "manifest_incomplete", "Manifest does not contain a complete resource bundle."
        )
    for kind, environment_name in (
        ("engine", "CUBRID_CONF_FILE"),
        ("broker", "CUBRID_BROKER_CONF_FILE"),
    ):
        record = configurations.get(kind)
        if not isinstance(record, dict) or not isinstance(record.get("path"), str):
            return reject_manifest(
                "manifest_incomplete",
                f"Manifest {kind} configuration identity is incomplete.",
            )
        expected_path = record["path"]
        selected_path = os.environ.get(environment_name)
        if selected_path and selected_path != expected_path:
            return invalid_result(
                selection,
                selected_path,
                "configuration_selection_drift",
                f"{environment_name} selects a different {kind} configuration.",
                affected_kind=f"{kind} configuration",
                source=environment_name,
                next_action=(
                    "Select the manifest configuration or rerun initialization "
                    "while the runtime is idle."
                ),
                expected_value=expected_path,
                observed_value=selected_path,
            ), EXIT_INVALID
    if os.environ.get("CUBRID_HA_CONF_FILE"):
        return invalid_result(
            selection,
            "CUBRID_HA_CONF_FILE",
            "component_unsupported",
            "HA configuration is outside the supported runtime-guard component scope.",
            affected_kind="environment override",
            source="process environment",
            next_action="Unset CUBRID_HA_CONF_FILE and keep HA disabled.",
            expected_value="unset",
            observed_value="set",
        ), EXIT_INVALID
    try:
        bundle = ResourceBundle.from_dict(document["resource_bundle"])
    except (KeyError, ValueError) as error:
        return reject_manifest(
            "manifest_incomplete", f"Manifest resource bundle is malformed: {error}."
        )
    guard_root = state_home / "cubrid-worktree-guard"
    state_home_observation = adapter.inspect_file(state_home)
    if (
        state_home_observation.kind != "directory"
        or state_home_observation.owner != os.geteuid()
        or state_home_observation.mode is None
        or state_home_observation.mode & 0o022
        or state_home_observation.canonical is not True
    ):
        return invalid_result(
            selection,
            state_home,
            "guard_state_directory_unsafe",
            "The selected state root must be a canonical owner-controlled directory.",
            affected_kind="state root",
            source="XDG_STATE_HOME",
            next_action="Restore the state root owner and remove group/other write permission.",
            expected_owner=os.geteuid(),
            expected_value="directory without group/other write permission",
            observed_value=(
                None
                if state_home_observation.mode is None
                else f"mode={state_home_observation.mode:04o}"
            ),
        ), EXIT_INVALID
    for guarded_directory in (
        guard_root,
        guard_root / "worktrees",
        manifest_path.parent,
    ):
        guarded_observation = adapter.inspect_file(guarded_directory)
        if (
            guarded_observation.kind != "directory"
            or guarded_observation.owner != os.geteuid()
            or guarded_observation.mode != 0o700
            or guarded_observation.canonical is not True
        ):
            return invalid_result(
                selection, guarded_directory, "guard_state_directory_unsafe",
                "A guard state directory must be canonical and owner-only.",
                affected_kind="guard state directory", source="guard state",
                next_action="Restore the guard state directory owner and mode 0700.",
                expected_owner=os.geteuid(),
            ), EXIT_INVALID
    lock_path = guard_root / "registry.lock"
    lock_observation = adapter.inspect_file(lock_path)
    if (
        lock_observation.kind != "file"
        or lock_observation.owner != os.geteuid()
        or lock_observation.mode != 0o600
        or lock_observation.canonical is not True
    ):
        return invalid_result(
            selection, lock_path, "allocation_lock_unsafe",
            "The allocation lock must be a canonical owner-only regular file.",
            affected_kind="allocation lock", source="guard state",
            next_action="Restore the allocation lock owner and mode 0600.",
            expected_owner=os.geteuid(),
        ), EXIT_INVALID
    try:
        validate_database_name(database_name)
    except OperationError as error:
        return reject_manifest("manifest_incomplete", error.diagnostic.message)
    if bundle.database_name != database_name:
        return reject_manifest(
            "manifest_incomplete", "Resource bundle database identity does not match the manifest."
        )
    try:
        validate_resource_bundle(
            bundle,
            selected_runtime_id,
            Path.home(),
            "worktree manifest resource bundle",
            defer_managed_path_checks=True,
        )
    except OperationError as error:
        return ValidationResult(
            outcome="invalid", selection=selection, diagnostic=error.diagnostic
        ), EXIT_INVALID
    expected_claims = bundle.claims().to_dict()
    if claims != expected_claims:
        return reject_manifest(
            "manifest_incomplete", "Manifest normalized claims do not match its resource bundle."
        )
    recorded_effective_configuration = configurations.get("effective")
    if (
        recorded_effective_configuration is not None
        and recorded_effective_configuration
        != expected_effective_configuration(bundle)
    ):
        return reject_manifest(
            "manifest_incomplete",
            "Manifest effective configuration does not match its resource bundle.",
        )
    managed_paths = {
        "cubrid_tmp": bundle.cubrid_tmp,
        "database_registry": bundle.database_registry,
        "data_root": bundle.data_root,
        "log_root": bundle.log_root,
        "lob_root": bundle.lob_root,
    }
    for field, path in managed_paths.items():
        observation = adapter.inspect_file(path)
        try:
            require_private_directory_chain(Path.home(), path, f"resource_bundle.{field}")
        except OperationError:
            observation = replace(observation, canonical=False)
        if (
            not path.is_absolute()
            or observation.canonical is not True
            or not observation.exists
            or observation.kind != "directory"
            or observation.owner != os.geteuid()
            or observation.mode != 0o700
        ):
            return invalid_result(
                selection, path, "managed_path_unsafe",
                "A managed runtime path must be an absolute owner-only directory.",
                affected_kind="managed runtime path", source=f"resource_bundle.{field}",
                next_action="Rerun initialization while the selected runtime is idle.",
                expected_owner=os.geteuid(),
            ), EXIT_INVALID
    registry_path = state_home / "cubrid-worktree-guard" / "allocations.json"
    registry_observation = adapter.inspect_file(registry_path)
    if (
        not registry_observation.exists
        or registry_observation.kind != "file"
        or registry_observation.owner != os.geteuid()
        or registry_observation.mode != 0o600
        or registry_observation.content is None
        or registry_observation.canonical is not True
    ):
        return invalid_result(
            selection, registry_path, "allocation_registry_unsafe",
            "The allocation registry must be a readable owner-only regular file.",
            affected_kind="allocation registry", source="guard state",
            next_action="Restore the allocation registry before using this runtime.",
            expected_owner=os.geteuid(),
        ), EXIT_INVALID
    try:
        registry_document = json.loads(registry_observation.content)
        allocation = registry_document["allocations"][selected_runtime_id]
    except (json.JSONDecodeError, KeyError, TypeError):
        return invalid_result(
            selection, registry_path, "allocation_registry_inconsistent",
            "The allocation registry does not retain this manifest's allocation.",
            affected_kind="allocation registry", source="guard state",
            next_action="Restore the matching retained allocation before using this runtime.",
        ), EXIT_INVALID
    if (
        registry_document.get("schema_version") != STATE_SCHEMA_VERSION
        or type(registry_document.get("generation")) is not int
        or registry_document["generation"] < document["generation"]
        or not isinstance(allocation, dict)
        or allocation.get("generation") != document["generation"]
        or allocation.get("state") != "ready"
        or allocation.get("claims") != claims
    ):
        return invalid_result(
            selection, registry_path, "allocation_registry_inconsistent",
            "The allocation registry generation or claims do not match the manifest.",
            affected_kind="allocation registry", source="guard state",
            next_action="Restore matching registry and manifest state before using this runtime.",
        ), EXIT_INVALID
    configuration_contents: dict[str, str] = {}
    configuration_hashes: dict[str, tuple[Path, str, str]] = {}
    for kind in ("engine", "broker"):
        record = configurations.get(kind)
        if not isinstance(record, dict) or not isinstance(record.get("path"), str) or not isinstance(record.get("sha256"), str):
            return reject_manifest("manifest_incomplete", f"Manifest {kind} configuration identity is incomplete.")
        path = Path(record["path"])
        observed = adapter.inspect_file(path)
        if (
            observed.kind != "file"
            or observed.content is None
            or observed.owner != os.geteuid()
            or observed.mode is None
            or observed.mode & 0o022
            or observed.canonical is not True
        ):
            return invalid_result(
                selection, path, "configuration_missing", f"The selected {kind} configuration is missing or unreadable.",
                affected_kind=f"{kind} configuration", source=f"manifest configurations.{kind}",
                next_action="Restore the installation and rerun initialization while idle.",
            ), EXIT_INVALID
        digest = text_hash(observed.content)
        configuration_contents[kind] = observed.content
        configuration_hashes[kind] = (path, record["sha256"], digest)

    gateway_path = bundle.installation_root / "conf" / "cubrid_gateway.conf"
    gateway_observation = adapter.inspect_file(gateway_path)
    gateway_content = None
    if gateway_observation.exists:
        if (
            gateway_observation.kind != "file"
            or gateway_observation.content is None
            or gateway_observation.owner != os.geteuid()
            or gateway_observation.mode is None
            or gateway_observation.mode & 0o022
            or gateway_observation.canonical is not True
        ):
            return invalid_result(
                selection,
                gateway_path,
                "configuration_missing",
                "The gateway configuration cannot be inspected safely.",
                affected_kind="gateway configuration",
                source="CUBRID installation",
                next_action="Restore the private installation configuration before validation.",
            ), EXIT_INVALID
        gateway_content = gateway_observation.content
    try:
        validate_effective_configuration(
            bundle,
            configuration_contents["engine"],
            configuration_contents["broker"],
            gateway_content,
        )
    except OperationError as error:
        return ValidationResult(
            outcome="invalid", selection=selection, diagnostic=error.diagnostic
        ), EXIT_INVALID

    broker_record = configurations["broker"]
    assert isinstance(broker_record, dict)
    spawn_records = broker_record.get("spawn_environments")
    if not isinstance(spawn_records, list):
        return reject_manifest(
            "manifest_incomplete",
            "Manifest broker spawn-environment identity is incomplete.",
        )
    try:
        current_selections = broker_spawn_environment_selections(
            configuration_contents["broker"],
            bundle.installation_root,
            bundle.brokers,
        )
    except OperationError as error:
        return ValidationResult(
            outcome="invalid", selection=selection, diagnostic=error.diagnostic
        ), EXIT_INVALID
    expected_selection_pairs = sorted(
        (record.get("path"), section)
        for record in spawn_records
        if isinstance(record, dict)
        for section in record.get("broker_sections", [])
        if isinstance(section, str)
    )
    observed_selection_pairs = sorted(
        (os.fspath(path), section) for section, path in current_selections
    )
    if expected_selection_pairs != observed_selection_pairs:
        return invalid_result(
            selection,
            "SOURCE_ENV",
            "configuration_drift",
            "The enabled brokers select different spawn-environment sources.",
            affected_kind="broker spawn environment",
            source="cubrid_broker.conf SOURCE_ENV",
            next_action="Rerun initialization while the selected runtime is idle.",
            expected_value=json.dumps(expected_selection_pairs),
            observed_value=json.dumps(observed_selection_pairs),
        ), EXIT_INVALID
    for record in spawn_records:
        if (
            not isinstance(record, dict)
            or not isinstance(record.get("path"), str)
            or not isinstance(record.get("sha256"), str)
            or not isinstance(record.get("broker_sections"), list)
        ):
            return reject_manifest(
                "manifest_incomplete",
                "Manifest broker spawn-environment identity is malformed.",
            )
        source_path = Path(record["path"])
        source_observation = adapter.inspect_file(source_path)
        if (
            source_observation.kind != "file"
            or source_observation.content is None
            or source_observation.owner != os.geteuid()
            or source_observation.mode is None
            or source_observation.mode & 0o022
            or source_observation.canonical is not True
        ):
            return invalid_result(
                selection,
                source_path,
                "configuration_missing",
                "A broker spawn environment is missing or unreadable.",
                affected_kind="broker spawn environment",
                source="manifest configurations.broker.spawn_environments",
                next_action="Restore the installation and rerun initialization while idle.",
            ), EXIT_INVALID
        try:
            validate_broker_spawn_environment_values(
                source_observation.content,
                "broker SOURCE_ENV",
                bundle.installation_layout(),
                bundle,
            )
        except OperationError as error:
            return ValidationResult(
                outcome="invalid", selection=selection, diagnostic=error.diagnostic
            ), EXIT_INVALID
        observed_hash = text_hash(source_observation.content)
        if observed_hash != record["sha256"]:
            return invalid_result(
                selection,
                source_path,
                "configuration_drift",
                "A broker spawn environment changed since initialization.",
                affected_kind="broker spawn environment",
                source="manifest configurations.broker.spawn_environments.sha256",
                next_action="Rerun initialization while the selected runtime is idle.",
                expected_value=record["sha256"],
                observed_value=observed_hash,
            ), EXIT_INVALID

    for kind, (path, expected_hash, digest) in configuration_hashes.items():
        if digest != expected_hash:
            return invalid_result(
                selection, path, "configuration_drift", f"The selected {kind} configuration has changed since initialization.",
                affected_kind=f"{kind} configuration", source=f"manifest configurations.{kind}.sha256",
                next_action="Rerun initialization while the selected runtime is idle.",
                expected_value=expected_hash, observed_value=digest,
            ), EXIT_INVALID
    environment_path = generated_environment.get("path")
    environment_hash = generated_environment.get("sha256")
    if not isinstance(environment_path, str) or not isinstance(environment_hash, str):
        return reject_manifest("manifest_incomplete", "Generated environment identity is incomplete.")
    expected_environment_path = manifest_path.parent / "env.sh"
    if Path(environment_path) != expected_environment_path:
        return invalid_result(
            selection, environment_path, "environment_path_invalid",
            "The generated environment is not beside its worktree manifest.",
            affected_kind="generated environment", source="manifest generated_environment.path",
            next_action="Rerun initialization while the selected runtime is idle.",
            expected_value=os.fspath(expected_environment_path), observed_value=environment_path,
        ), EXIT_INVALID
    environment_observation = adapter.inspect_file(expected_environment_path)
    if (
        environment_observation.kind != "file"
        or environment_observation.owner != os.geteuid()
        or environment_observation.mode != 0o600
        or environment_observation.content is None
        or environment_observation.canonical is not True
    ):
        return invalid_result(
            selection, expected_environment_path, "environment_unsafe",
            "The generated environment must be a readable owner-only regular file.",
            affected_kind="generated environment", source="guard state",
            next_action="Rerun initialization while the selected runtime is idle.",
            expected_owner=os.geteuid(),
        ), EXIT_INVALID
    observed_environment_hash = text_hash(environment_observation.content)
    if isinstance(recorded_build_directory, str):
        expected_environment_content = generated_environment_content(
            selection,
            selected_runtime_id,
            recorded_build_directory,
            bundle,
        )
        expected_content_hash = text_hash(expected_environment_content)
        if environment_observation.content != expected_environment_content:
            return invalid_result(
                selection,
                expected_environment_path,
                "environment_drift",
                "The generated environment is not coherent with the manifest runtime identity.",
                affected_kind="generated environment",
                source="manifest runtime and installation identity",
                next_action="Rerun initialization while the selected runtime is idle.",
                expected_value=expected_content_hash,
                observed_value=observed_environment_hash,
            ), EXIT_INVALID
    if observed_environment_hash != environment_hash:
        return invalid_result(
            selection, expected_environment_path, "environment_drift",
            "The generated environment has changed since initialization.",
            affected_kind="generated environment", source="manifest generated_environment.sha256",
            next_action="Rerun initialization while the selected runtime is idle.",
            expected_value=environment_hash, observed_value=observed_environment_hash,
        ), EXIT_INVALID
    installation_root = installation.get("root")
    if (
        not isinstance(installation_root, str)
        or not Path(installation_root).is_dir()
        or not is_canonical_existing_path(Path(installation_root))
    ):
        return reject_manifest("manifest_incomplete", "Installation identity is missing or unavailable.")
    selected_installation = os.environ.get("CUBRID")
    selected_installation_path = (
        Path(selected_installation) if selected_installation is not None else None
    )
    if (
        selected_installation_path is None
        or not selected_installation_path.is_absolute()
        or os.fspath(selected_installation_path) != installation_root
        or not is_canonical_existing_path(selected_installation_path)
    ):
        return invalid_result(
            selection,
            selected_installation or "CUBRID",
            "installation_inconsistent",
            "CUBRID must canonically select the manifest's private installation.",
            affected_kind="installation",
            source="CUBRID environment",
            next_action="Select the manifest's active preset installation before using the runtime.",
            expected_value=installation_root,
            observed_value=selected_installation,
        ), EXIT_INVALID
    engine_configuration = configurations.get("engine")
    broker_configuration = configurations.get("broker")
    installation_comparisons = (
        (bundle.installation_root, installation.get("root")),
        (bundle.executable_directory, installation.get("bin")),
        (bundle.library_directory, installation.get("lib")),
        (
            bundle.engine_configuration,
            engine_configuration.get("path")
            if isinstance(engine_configuration, dict) else None,
        ),
        (
            bundle.broker_configuration,
            broker_configuration.get("path")
            if isinstance(broker_configuration, dict) else None,
        ),
    )
    if any(os.fspath(actual) != expected for actual, expected in installation_comparisons):
        return reject_manifest(
            "manifest_incomplete",
            "Resource bundle installation identity does not match the manifest identities.",
        )
    executable_records = installation.get("executables")
    library_records = installation.get("libraries")
    if (
        not isinstance(executable_records, list)
        or not executable_records
        or not isinstance(library_records, list)
        or not library_records
    ):
        return reject_manifest(
            "manifest_incomplete", "Installation file identity is incomplete."
        )
    if any(
        not isinstance(record, dict)
        or not isinstance(record.get("path"), str)
        or not isinstance(record.get("sha256"), str)
        for record in (*executable_records, *library_records)
    ):
        return reject_manifest(
            "manifest_incomplete", "Installation file identity is malformed."
        )
    try:
        require_owned_installation_path(
            bundle.executable_directory, "directory", "executable directory"
        )
        require_owned_installation_path(
            bundle.library_directory, "directory", "library directory"
        )
        expected_executables = [
            os.fspath(bundle.executable_directory / name)
            for name in REQUIRED_EXECUTABLE_NAMES
        ]
        expected_libraries = [
            os.fspath(path)
            for path in runtime_library_paths(bundle.library_directory)
        ]
    except (OperationError, OSError):
        return invalid_result(
            selection,
            bundle.installation_root,
            "installation_identity_invalid",
            "The installation executable or library directory is unavailable.",
            affected_kind="installation",
            source="manifest installation identity",
            next_action="Complete the selected preset installation and rerun initialization.",
        ), EXIT_INVALID
    observed_executables = [record["path"] for record in executable_records]
    observed_libraries = [record["path"] for record in library_records]
    if (
        observed_executables != expected_executables
        or observed_libraries != expected_libraries
    ):
        return invalid_result(
            selection,
            bundle.installation_root,
            "installation_identity_invalid",
            "The installation identity does not enumerate the selected executables and libraries exactly once.",
            affected_kind="installation",
            source="manifest installation identity",
            next_action="Rerun initialization while the selected installation is idle.",
            expected_value=json.dumps(
                {"executables": expected_executables, "libraries": expected_libraries},
                sort_keys=True,
            ),
            observed_value=json.dumps(
                {"executables": observed_executables, "libraries": observed_libraries},
                sort_keys=True,
            ),
        ), EXIT_INVALID
    for record in executable_records:
        assert isinstance(record, dict)
        identity_path = Path(record["path"])
        try:
            require_owned_installation_path(identity_path, "file", "installation file")
        except OperationError:
            return invalid_result(
                selection, identity_path, "installation_identity_invalid",
                "A required installation file is missing or unreadable.",
                affected_kind="installation file", source="manifest installation identity",
                next_action="Complete the selected preset installation and rerun initialization.",
            ), EXIT_INVALID
        observed_hash = file_hash(identity_path)
        if observed_hash != record["sha256"]:
            return invalid_result(
                selection, identity_path, "installation_identity_invalid",
                "A required installation file has changed since initialization.",
                affected_kind="installation file", source="manifest installation identity",
                next_action="Rerun initialization after the installation is idle.",
                expected_value=record["sha256"], observed_value=observed_hash,
            ), EXIT_INVALID
    for record in library_records:
        assert isinstance(record, dict)
        identity_path = Path(record["path"])
        try:
            observed_identity = library_file_identity(
                identity_path, bundle.installation_layout()
            )
        except (OSError, OperationError):
            return invalid_result(
                selection, identity_path, "installation_identity_invalid",
                "A required runtime library or its SONAME target is missing or unsafe.",
                affected_kind="installation file", source="manifest installation identity",
                next_action="Complete the selected preset installation and rerun initialization.",
            ), EXIT_INVALID
        expected_resolved_path = record.get("resolved_path", record["path"])
        if (
            observed_identity["resolved_path"] != expected_resolved_path
            or observed_identity["sha256"] != record["sha256"]
        ):
            return invalid_result(
                selection, identity_path, "installation_identity_invalid",
                "A required runtime library identity has changed since initialization.",
                affected_kind="installation file", source="manifest installation identity",
                next_action="Rerun initialization after the installation is idle.",
                expected_value=json.dumps(
                    {
                        "resolved_path": expected_resolved_path,
                        "sha256": record["sha256"],
                    },
                    sort_keys=True,
                ),
                observed_value=json.dumps(
                    {
                        "resolved_path": observed_identity["resolved_path"],
                        "sha256": observed_identity["sha256"],
                    },
                    sort_keys=True,
                ),
            ), EXIT_INVALID
    ownership = classify_live_ownership(
        adapter, runtime_observations, bundle, document
    )
    if ownership.classification in ("conflict", "unknown"):
        return ownership_failure_result(
            selection, runtime_observations, selected_runtime_id, ownership
        ), EXIT_INVALID
    result = ready_result(
        "validate", selection, selected_runtime_id, manifest_path, expected_environment_path
    )
    if ownership.classification == "same-runtime":
        result = replace(
            result,
            live_ownership=positive_ownership_report(
                runtime_observations, selected_runtime_id, ownership
            ),
        )
    return result, 0


def render_human(result: ValidationResult) -> str:
    diagnostic = result.diagnostic
    if diagnostic is None:
        output = (
            f"Outcome: ready\n"
            f"Worktree runtime: {result.worktree_id}\n"
            f"Worktree: {result.selection.worktree}\n"
            f"Active preset: {result.selection.preset}\n"
            f"Manifest: {result.manifest_path}\n"
            f"Environment: {result.environment_path}\n"
            "Kernel reservation: none; later kernel acquisition can still race.\n"
        )
        if result.live_ownership is not None:
            ownership = result.live_ownership
            affected = ownership["affected_object"]
            assert isinstance(affected, dict)
            output += (
                f"Live ownership: {ownership['classification']}\n"
                f"Affected {affected['kind']}: {affected['value']}\n"
                f"Normalized value: {ownership['normalized_value']}\n"
                f"Expected owner: {ownership['expected_owner']}\n"
                f"Observed owner: {ownership['observed_owner']}\n"
                f"Evidence: {', '.join(ownership['evidence'])}\n"
                "Observation scope: "
                + json.dumps(ownership["observation_scope"], sort_keys=True)
                + "\n"
                f"Details: {ownership['message']}\n"
                f"Next action: {ownership['next_action']}\n"
            )
        return output
    affected = diagnostic.affected_object
    lines = [
        f"Outcome: {result.outcome}",
        f"Affected {affected.kind}: {affected.value}",
        f"Normalized value: {diagnostic.normalized_value}",
        f"Source: {diagnostic.source}",
    ]
    if diagnostic.expected_owner is not None:
        lines.append(f"Expected owner: {diagnostic.expected_owner}")
    if diagnostic.observed_owner is not None:
        lines.append(f"Observed owner: {diagnostic.observed_owner}")
    if diagnostic.observed_value is not None:
        lines.append(f"Observed value: {diagnostic.observed_value}")
    if diagnostic.expected_value is not None:
        lines.append(f"Expected value: {diagnostic.expected_value}")
    if diagnostic.evidence:
        lines.append(f"Evidence: {', '.join(diagnostic.evidence)}")
    if diagnostic.missing_evidence:
        lines.append(f"Missing evidence: {', '.join(diagnostic.missing_evidence)}")
    if diagnostic.observation_scope is not None:
        lines.append(
            "Observation scope: "
            + json.dumps(diagnostic.observation_scope, sort_keys=True)
        )
    lines.extend((
        f"Evidence quality: {diagnostic.evidence_quality}",
        f"Details: {diagnostic.message}",
        f"Next action: {diagnostic.next_action}",
    ))
    return "\n".join(lines) + "\n"


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="my-cubrid-runtime")
    subparsers = parser.add_subparsers(dest="command", required=True)
    initialize_parser = subparsers.add_parser("init", help="initialize a worktree runtime")
    validate_parser = subparsers.add_parser("validate", help="validate runtime guard state")
    for command_parser in (initialize_parser, validate_parser):
        command_parser.add_argument("--worktree", help="CUBRID Git worktree (default: current worktree)")
        command_parser.add_argument("--preset", help="active build preset (default: PRESET_MODE)")
        command_parser.add_argument("--json", action="store_true", help="emit structured diagnostics")
    initialize_parser.add_argument("--db-name", help="database identity for a new runtime")
    return parser.parse_args()


def main() -> int:
    arguments = parse_arguments()
    try:
        worktree = resolve_worktree(arguments.worktree)
        git_common_dir = resolve_git_common_dir(worktree)
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        print(f"my-cubrid-runtime: {error}", file=sys.stderr)
        return 2
    preset = arguments.preset or os.environ.get("PRESET_MODE")
    if not preset:
        print("my-cubrid-runtime: --preset or PRESET_MODE is required", file=sys.stderr)
        return 2
    if not PRESET_PATTERN.fullmatch(preset):
        print("my-cubrid-runtime: preset has an invalid value", file=sys.stderr)
        return 2
    selection = RuntimeSelection(worktree, git_common_dir, preset)

    try:
        adapter = observation_adapter()
        if arguments.command == "init":
            result, exit_status = initialize(adapter, selection, arguments.db_name)
        else:
            result, exit_status = validate(adapter, selection)
    except OperationError as error:
        result = ValidationResult(
            outcome="invalid",
            selection=selection,
            diagnostic=error.diagnostic,
            command=arguments.command,
        )
        exit_status = EXIT_INVALID
    except (KeyError, TypeError, ValueError, OSError, json.JSONDecodeError) as error:
        print(f"my-cubrid-runtime: cannot load observation input: {error}", file=sys.stderr)
        return 2
    if arguments.json:
        print(json.dumps(result.to_dict(), sort_keys=True))
    else:
        print(render_human(result), end="")
    return exit_status


if __name__ == "__main__":
    sys.exit(main())
