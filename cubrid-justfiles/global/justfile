# Import generic CUBRID recipes here so they appear without a module prefix.

# List the Git repositories used for CUBRID work.
dir-list:
    my-cubrid-dir list

# Summary of Git Statuses for the repositories
dir-status:
    my-cubrid-dir status

# Fast-forward every CUBRID work repository to its configured upstream.
dir-pull:
    my-cubrid-dir pull

prepare-build:
    "{{ source_directory() }}/../../stow-create.sh"
    just --justfile ./justfile --working-directory . prepare-debug-gcc

# Fuzzily select, checkout, and prepare one pull request awaiting review.
pr-review:
    cubrid-pr-review-worktree --interactive --prepare

# Checkout and prepare every pull request awaiting review, skipping existing worktrees.
pr-review-all:
    cubrid-pr-review-worktree --all --prepare

# Create NEW_BRANCH from BASE_BRANCH in both CUBRID testcase repositories.
tc-branch-create base_branch new_branch:
    cubrid-tc-branch-create.sh "{{base_branch}}" "{{new_branch}}"

# Merge and push the testcase branches associated with CUBRID_PR_URL.
tc-sync cubrid_pr_url:
    cubrid-tc-sync.sh "{{cubrid_pr_url}}"

# Check the current PR's testcase branches contain its feature/<name> baseline.
[no-cd]
tc-base-check *args:
    cubrid-pr-tc-base-check {{args}}

# Check the current PR targets feature/oos-merge and its testcase branches contain it.
[no-cd]
tc-base-check-oos *args:
    cubrid-pr-tc-base-check-oos {{args}}

# Check tc/pr-N of the develop <- FEATURE PR matches FEATURE; offer a fast-forward push.
tc-feature-sync-check feature *args:
    cubrid-feature-tc-sync-check {{args}} "{{feature}}"

# Check tc/pr-N of the develop <- feature/oos-merge PR matches feature/oos-merge.
tc-feature-sync-check-oos *args:
    cubrid-feature-tc-sync-check-oos {{args}}
