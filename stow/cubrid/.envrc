# .envrc

# Check if PRESET_MODE is set; if not, print a warning and set a default value
if [ -z "$PRESET_MODE" ]; then
    echo "#################################################################"
    echo "############### Warning: PRESET_MODE is not set. ################"
    echo "#################################################################"
    export PRESET_MODE="############################# WARNING ############################"
    return
fi

export CURRENT_DIR=${PWD##*/}
export CUBRID="$HOME/.cub/install/$CURRENT_DIR/$PRESET_MODE"
# export CUBRID_DATABASES="$HOME/.cub/db/commondb"
# export CUBRID_DATABASES="$HOME/.cub/db/$CURRENT_DIR/$PRESET_MODE"
# export CUBRID_DATABASES="$HOME/.cub/db/$CURRENT_DIR/release_gcc_avx2"
export CUBRID_DATABASES="$HOME/.cub/db/$CURRENT_DIR/commondb"
CUBRID_BUILD_DIR="$(pwd)/build_preset_$PRESET_MODE"
export CUBRID_BUILD_DIR="$CUBRID_BUILD_DIR"
export PATH="$CUBRID/bin:$PATH"
export LD_LIBRARY_PATH="$CUBRID/cci/lib:$CUBRID/lib:$HOME/CUB3LIB/lib:/usr/local/lib:$LD_LIBRARY_PATH"

ln -sf build_preset_"$PRESET_MODE"/compile_commands.json .

# bison 3.0.5
# export BISON_PATH="$HOME/my-build/bison-3.0.5/bison-install"
# export BISON_PATH="$HOME/temp/bison-install"
export BISON_PATH="$HOME/.local/opt/bison-3.0.5"
export PATH="$BISON_PATH/bin:$PATH"
export LD_LIBRARY_PATH="$BISON_PATH/lib:$LD_LIBRARY_PATH"

# export ANN_BENCHMARKS_CUB_NUM_CAS=1
# export OPENBLAS_NUM_THREADS=8
# export OMP_NUM_THREADS=16

# export CC='ccache gcc'
# export CXX='ccache g++'
# export CCACHE_BASEDIR=$(git rev-parse --show-toplevel)
# export CCACHE_NOHASHDIR=1

echo "Preset Mode: $PRESET_MODE"
echo "Install Dir: $CUBRID"
echo "DB Dir: $CUBRID_DATABASES"
echo "Build Dir: $CUBRID_BUILD_DIR"

export ASAN_OPTIONS=halt_on_error=0:log_path=./asan.log
export LSAN_OPTIONS=halt_on_error=0:log_path=./lsan.log

# CTP (cubrid-testtools)
# CTP_HOME="$HOME/gh/ctp/cubrid-testtools/CTP"
CTP_HOME="$HOME/gh/ctp/run-sql/CTP"
export CTP_HOME
export init_path="$CTP_HOME/shell/init_path"
PATH_add "$CTP_HOME/common/script"
PATH_add "$CTP_HOME/bin"

# Derive JAVA_HOME from mise when Java is managed through its shims.
if [ -z "$JAVA_HOME" ] && has mise; then
    JAVA_HOME="$(mise where java 2>/dev/null || true)"
    export JAVA_HOME
fi
if [ -z "$JAVA_HOME" ]; then
    log_status "JAVA_HOME is not set (e.g. export JAVA_HOME=/usr/lib/jvm/java-1.8.0)"
fi

# Homebrew keeps ncurses keg-only, so expose its development files to GCC.
if has brew; then
    NCURSES_PREFIX="$(brew --prefix ncurses 2>/dev/null || true)"
    if [ -d "$NCURSES_PREFIX/include" ]; then
        case ":${CPATH:-}:" in
            *":$NCURSES_PREFIX/include:"*) ;;
            *) export CPATH="$NCURSES_PREFIX/include${CPATH:+:$CPATH}" ;;
        esac
        case ":${LIBRARY_PATH:-}:" in
            *":$NCURSES_PREFIX/lib:"*) ;;
            *) export LIBRARY_PATH="$NCURSES_PREFIX/lib${LIBRARY_PATH:+:$LIBRARY_PATH}" ;;
        esac
        case ":${PKG_CONFIG_PATH:-}:" in
            *":$NCURSES_PREFIX/lib/pkgconfig:"*) ;;
            *) export PKG_CONFIG_PATH="$NCURSES_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" ;;
        esac
    fi
    unset NCURSES_PREFIX
fi

# ninja above 1.10 understands export CLICOLOR_FORCE=1 and prints color even when piped
# export CLICOLOR_FORCE=1
# export GTEST_COLOR=1
