# .envrc

remove_path_component()
{
    local variable_name="$1"
    local component="$2"
    local current_value="${!variable_name:-}"
    local entry
    local filtered=""
    local IFS=:

    for entry in $current_value; do
        if [ "$entry" != "$component" ]; then
            filtered="${filtered:+$filtered:}$entry"
        fi
    done
    printf -v "$variable_name" '%s' "$filtered"
    export "$variable_name"
}

# A parent shell may have loaded another worktree runtime. Remove only the
# paths identified by that runtime before selecting this worktree.
INHERITED_CUBRID="${CUBRID:-}"
if [ -n "$INHERITED_CUBRID" ]; then
    remove_path_component PATH "$INHERITED_CUBRID/bin"
    remove_path_component LD_LIBRARY_PATH "$INHERITED_CUBRID/cci/lib"
    remove_path_component LD_LIBRARY_PATH "$INHERITED_CUBRID/lib"
fi
unset INHERITED_CUBRID
for runtime_variable in ${!CUBRID@}; do
    unset "$runtime_variable"
done
unset runtime_variable LD_PRELOAD
export CUBRID_RUNTIME_READY=0

if [ -z "${PRESET_MODE:-}" ]; then
    printf 'PRESET_MODE is not set; select a build preset first.\n' >&2
    return 1
fi

export CURRENT_DIR=${PWD##*/}
# An explicit prefix distinguishes source worktrees with the same basename.
BUILD_INSTALL="${CUB_WORKENV_INSTALL:-$HOME/.cub/install/$CURRENT_DIR/$PRESET_MODE}"
WORKENV_CLI="${CUB_WORKENV_CLI:-cub-workenv}"
WORKENV_STATUS=0
if command -v "$WORKENV_CLI" >/dev/null 2>&1; then
    WORKENV_SHELL="$("$WORKENV_CLI" env --worktree "$PWD" --preset "$PRESET_MODE" --install "$BUILD_INSTALL")" || WORKENV_STATUS=$?
    # Cleanup is emitted on both success and failure. Preserve its status.
    eval "$WORKENV_SHELL" || WORKENV_STATUS=$?
else
    printf 'cub-workenv is unavailable; build-only. Install the CLI, build/install, then run cub-workenv init explicitly.\n' >&2
    if [ -e .cub-workenv ]; then WORKENV_STATUS=1; fi
fi
if [ "${CUBRID_RUNTIME_READY:-0}" != 1 ]; then
    export CUBRID="$BUILD_INSTALL"
fi
export CUBRID_BUILD_DIR="$PWD/build_preset_$PRESET_MODE"
unset BUILD_INSTALL WORKENV_CLI WORKENV_SHELL

# bison 3.0.5
# export BISON_PATH="$HOME/my-build/bison-3.0.5/bison-install"
# export BISON_PATH="$HOME/temp/bison-install"
export BISON_PATH="$HOME/.local/opt/bison-3.0.5"
export PATH="$BISON_PATH/bin:$PATH"
export LD_LIBRARY_PATH="$BISON_PATH/lib:$LD_LIBRARY_PATH"

# export ANN_BENCHMARKS_CUB_NUM_CAS=1
# export OPENBLAS_NUM_THREADS=8
# export OMP_NUM_THREADS=16

# export CC='ccache gcc'
# export CXX='ccache g++'
# export CCACHE_BASEDIR=$(git rev-parse --show-toplevel)
# export CCACHE_NOHASHDIR=1

echo "Preset Mode: $PRESET_MODE"
echo "Install Dir: $CUBRID"
if [ "$CUBRID_RUNTIME_READY" = "1" ]; then
    echo "DB Dir: $CUBRID_DATABASES"
else
    echo "Runtime: build-only"
fi
echo "Build Dir: $CUBRID_BUILD_DIR"

export ASAN_OPTIONS=halt_on_error=0:log_path=./asan.log
export LSAN_OPTIONS=halt_on_error=0:log_path=./lsan.log

# CTP (cubrid-testtools)
# CTP_HOME="$HOME/gh/ctp/cubrid-testtools/CTP"
CTP_HOME="$HOME/gh/ctp/run-sql/CTP"
export CTP_HOME
export init_path="$CTP_HOME/shell/init_path"
PATH_add "$CTP_HOME/common/script"
PATH_add "$CTP_HOME/bin"

# Derive JAVA_HOME from mise when Java is managed through its shims.
if [ -z "$JAVA_HOME" ] && has mise; then
    JAVA_HOME="$(mise where java 2>/dev/null || true)"
    export JAVA_HOME
fi
if [ -z "$JAVA_HOME" ]; then
    log_status "JAVA_HOME is not set (e.g. export JAVA_HOME=/usr/lib/jvm/java-1.8.0)"
fi

# Homebrew keeps ncurses keg-only, so expose its development files to GCC.
if has brew; then
    NCURSES_PREFIX="$(brew --prefix ncurses 2>/dev/null || true)"
    if [ -d "$NCURSES_PREFIX/include" ]; then
        case ":${CPATH:-}:" in
            *":$NCURSES_PREFIX/include:"*) ;;
            *) export CPATH="$NCURSES_PREFIX/include${CPATH:+:$CPATH}" ;;
        esac
        case ":${LIBRARY_PATH:-}:" in
            *":$NCURSES_PREFIX/lib:"*) ;;
            *) export LIBRARY_PATH="$NCURSES_PREFIX/lib${LIBRARY_PATH:+:$LIBRARY_PATH}" ;;
        esac
        case ":${PKG_CONFIG_PATH:-}:" in
            *":$NCURSES_PREFIX/lib/pkgconfig:"*) ;;
            *) export PKG_CONFIG_PATH="$NCURSES_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" ;;
        esac
    fi
    unset NCURSES_PREFIX
fi

# ninja above 1.10 understands export CLICOLOR_FORCE=1 and prints color even when piped
# export CLICOLOR_FORCE=1
# export GTEST_COLOR=1

# Keep build and testcase tools available even when runtime loading fails.
return "$WORKENV_STATUS"
