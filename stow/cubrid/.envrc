# .envrc

remove_path_component()
{
    local variable_name="$1"
    local component="$2"
    local current_value="${!variable_name:-}"
    local entry
    local filtered=""
    local IFS=:

    for entry in $current_value; do
        if [ "$entry" != "$component" ]; then
            filtered="${filtered:+$filtered:}$entry"
        fi
    done
    printf -v "$variable_name" '%s' "$filtered"
    export "$variable_name"
}

# A parent shell may have loaded another worktree runtime. Remove only the
# paths identified by that runtime before selecting this worktree.
INHERITED_CUBRID="${CUBRID:-}"
if [ -n "$INHERITED_CUBRID" ]; then
    remove_path_component PATH "$INHERITED_CUBRID/bin"
    remove_path_component LD_LIBRARY_PATH "$INHERITED_CUBRID/cci/lib"
    remove_path_component LD_LIBRARY_PATH "$INHERITED_CUBRID/lib"
fi
unset INHERITED_CUBRID
unset CUBRID_CONF_FILE CUBRID_BROKER_CONF_FILE CUBRID_DATABASES CUBRID_TMP
unset CUBRID_HA_CONF_FILE CUBRID_RUNTIME_READY

if [ -z "${PRESET_MODE:-}" ]; then
    printf 'PRESET_MODE is not set; no CUBRID build or runtime environment was loaded.\n' >&2
    return 1
fi

export CURRENT_DIR=${PWD##*/}
export CUBRID="$HOME/.cub/install/$CURRENT_DIR/$PRESET_MODE"
CUBRID_BUILD_DIR="$(pwd)/build_preset_$PRESET_MODE"
export CUBRID_BUILD_DIR="$CUBRID_BUILD_DIR"
export CUBRID_RUNTIME_READY=0

RUNTIME_GUARD="${MY_CUBRID:-$HOME/my-cubrid}/bin/my-cubrid-runtime"
RUNTIME_REPORT="$("$RUNTIME_GUARD" validate --worktree "$PWD" --preset "$PRESET_MODE" --json 2>&1)"
RUNTIME_STATUS=$?
if [ "$RUNTIME_STATUS" -eq 0 ]; then
    mapfile -t RUNTIME_PATHS < <(
        printf '%s' "$RUNTIME_REPORT" |
            python3 -c 'import base64, json, sys
report = json.load(sys.stdin)
if report.get("outcome") != "ready":
    raise SystemExit("runtime validation did not report ready")
for field in ("manifest_path", "environment_path"):
    value = report.get(field)
    if not isinstance(value, str):
        raise SystemExit(f"runtime validation omitted {field}")
    print(base64.b64encode(value.encode()).decode())'
    ) || return 1
    if [ "${#RUNTIME_PATHS[@]}" -ne 2 ]; then
        printf 'Runtime validation returned incomplete environment metadata.\n' >&2
        return 1
    fi
    RUNTIME_MANIFEST="$(printf '%s' "${RUNTIME_PATHS[0]}" | base64 --decode)"
    RUNTIME_ENVIRONMENT="$(printf '%s' "${RUNTIME_PATHS[1]}" | base64 --decode)"
    if [[ "$RUNTIME_MANIFEST" == *$'\n'* || "$RUNTIME_MANIFEST" == *$'\r'* ||
          "$RUNTIME_ENVIRONMENT" == *$'\n'* || "$RUNTIME_ENVIRONMENT" == *$'\r'* ]]; then
        printf 'Runtime metadata paths must not contain newlines.\n' >&2
        return 1
    fi
    if [ "$RUNTIME_ENVIRONMENT" != "$(dirname -- "$RUNTIME_MANIFEST")/env.sh" ] ||
       [ ! -f "$RUNTIME_ENVIRONMENT" ] || [ -L "$RUNTIME_ENVIRONMENT" ] ||
       [ "$(realpath -e -- "$RUNTIME_ENVIRONMENT" 2>/dev/null)" != "$RUNTIME_ENVIRONMENT" ] ||
       [ "$(stat -Lc '%u' -- "$RUNTIME_ENVIRONMENT" 2>/dev/null)" != "$UID" ] ||
       [ "$(stat -Lc '%a' -- "$RUNTIME_ENVIRONMENT" 2>/dev/null)" != "600" ]; then
        printf 'Validated runtime environment file is not a trusted owner-only regular file: %s\n' \
            "$RUNTIME_ENVIRONMENT" >&2
        return 1
    fi
    # The guard generated this shell assignment file with shell-safe quoting.
    source "$RUNTIME_ENVIRONMENT"
elif [ "$RUNTIME_STATUS" -eq 3 ]; then
    printf 'CUBRID runtime is not initialized; this worktree is build-only. Run a full build to initialize it.\n' >&2
else
    printf '%s\n' "$RUNTIME_REPORT" >&2
    return "$RUNTIME_STATUS"
fi
unset RUNTIME_GUARD RUNTIME_REPORT RUNTIME_STATUS RUNTIME_PATHS
unset RUNTIME_MANIFEST RUNTIME_ENVIRONMENT

ln -sf build_preset_"$PRESET_MODE"/compile_commands.json .

# bison 3.0.5
# export BISON_PATH="$HOME/my-build/bison-3.0.5/bison-install"
# export BISON_PATH="$HOME/temp/bison-install"
export BISON_PATH="$HOME/.local/opt/bison-3.0.5"
export PATH="$BISON_PATH/bin:$PATH"
export LD_LIBRARY_PATH="$BISON_PATH/lib:$LD_LIBRARY_PATH"

# export ANN_BENCHMARKS_CUB_NUM_CAS=1
# export OPENBLAS_NUM_THREADS=8
# export OMP_NUM_THREADS=16

# export CC='ccache gcc'
# export CXX='ccache g++'
# export CCACHE_BASEDIR=$(git rev-parse --show-toplevel)
# export CCACHE_NOHASHDIR=1

echo "Preset Mode: $PRESET_MODE"
echo "Install Dir: $CUBRID"
if [ "$CUBRID_RUNTIME_READY" = "1" ]; then
    echo "DB Dir: $CUBRID_DATABASES"
else
    echo "Runtime: build-only"
fi
echo "Build Dir: $CUBRID_BUILD_DIR"

export ASAN_OPTIONS=halt_on_error=0:log_path=./asan.log
export LSAN_OPTIONS=halt_on_error=0:log_path=./lsan.log

# CTP (cubrid-testtools)
# CTP_HOME="$HOME/gh/ctp/cubrid-testtools/CTP"
CTP_HOME="$HOME/gh/ctp/run-sql/CTP"
export CTP_HOME
export init_path="$CTP_HOME/shell/init_path"
PATH_add "$CTP_HOME/common/script"
PATH_add "$CTP_HOME/bin"

# Derive JAVA_HOME from mise when Java is managed through its shims.
if [ -z "$JAVA_HOME" ] && has mise; then
    JAVA_HOME="$(mise where java 2>/dev/null || true)"
    export JAVA_HOME
fi
if [ -z "$JAVA_HOME" ]; then
    log_status "JAVA_HOME is not set (e.g. export JAVA_HOME=/usr/lib/jvm/java-1.8.0)"
fi

# Homebrew keeps ncurses keg-only, so expose its development files to GCC.
if has brew; then
    NCURSES_PREFIX="$(brew --prefix ncurses 2>/dev/null || true)"
    if [ -d "$NCURSES_PREFIX/include" ]; then
        case ":${CPATH:-}:" in
            *":$NCURSES_PREFIX/include:"*) ;;
            *) export CPATH="$NCURSES_PREFIX/include${CPATH:+:$CPATH}" ;;
        esac
        case ":${LIBRARY_PATH:-}:" in
            *":$NCURSES_PREFIX/lib:"*) ;;
            *) export LIBRARY_PATH="$NCURSES_PREFIX/lib${LIBRARY_PATH:+:$LIBRARY_PATH}" ;;
        esac
        case ":${PKG_CONFIG_PATH:-}:" in
            *":$NCURSES_PREFIX/lib/pkgconfig:"*) ;;
            *) export PKG_CONFIG_PATH="$NCURSES_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" ;;
        esac
    fi
    unset NCURSES_PREFIX
fi

# ninja above 1.10 understands export CLICOLOR_FORCE=1 and prints color even when piped
# export CLICOLOR_FORCE=1
# export GTEST_COLOR=1
