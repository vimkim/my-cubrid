{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "user_default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_preset_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{CUBRID}",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CUBVEC_TEAM_BUILD": "ON",
        "ENABLE_CUBVEC_LOG": "ON",
        "VIMKIM_BUILD": "ON",
        "UNIT_TEST_OOS": "ON",
        "UNIT_TEST_SPAGE": "ON",
        "UNIT_TEST_PAGE_BUFFER": "ON",
        "WITH_CCI": "true",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "user_gcc",
      "hidden": true,
      "inherits": "user_default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_FLAGS": "-fdiagnostics-color=always",
        "CMAKE_CXX_FLAGS": "-fdiagnostics-color=always"
      }
    },
    {
      "name": "user_gcc_debug",
      "hidden": true,
      "inherits": "user_gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "user_clang",
      "hidden": true,
      "inherits": "user_default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "user_no_unit_tests",
      "hidden": true,
      "cacheVariables": {
        "UNIT_TESTS": "OFF",
        "UNIT_TEST_OOS": "OFF",
        "UNIT_TEST_SPAGE": "OFF",
        "UNIT_TEST_PAGE_BUFFER": "OFF"
      }
    },
    {
      "name": "debug_gcc",
      "description": "GCC Debug with full debug information and frame pointers",
      "inherits": "user_gcc_debug",
      "environment": {
        "CC": "gcc -std=gnu17",
        "CXX": "g++ -Wno-error=stringop-overflow"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fdiagnostics-color=always -Wno-template-body -isystem ${sourceDir}/.just/include",
        "CMAKE_C_FLAGS_DEBUG": "-O0 -ggdb3 -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-implicit-function-declaration -fno-omit-frame-pointer -Wno-error=format -Wno-error -Wno-error=maybe-uninitialized -Wno-error=parentheses",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -ggdb3 -fno-omit-frame-pointer -Wno-error=format -Wno-error -Wno-error=maybe-uninitialized -Wno-error=parentheses"
      }
    },
    {
      "name": "release_gcc",
      "description": "GCC RelWithDebInfo with O2 optimization",
      "inherits": "user_gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fdiagnostics-color=always -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-implicit-function-declaration -Wno-error=maybe-uninitialized",
        "CMAKE_CXX_FLAGS": "-fdiagnostics-color=always -Wno-error=maybe-uninitialized",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -ggdb3 -DNDEBUG -finline-functions -Wno-error=mismatched-new-delete -Wno-error=enum-conversion -Wno-error=stringop-truncation -Wno-error=format-overflow= -Wno-error=format= -Wno-error=format-truncation",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -ggdb3 -DNDEBUG -finline-functions -Wno-error=mismatched-new-delete -Wno-error=enum-conversion -Wno-error=stringop-truncation -Wno-error=format-overflow= -Wno-error=format= -Wno-error=format-truncation"
      }
    },
    {
      "name": "asan_debug_gcc",
      "description": "GCC Debug with AddressSanitizer",
      "inherits": "user_gcc_debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-O1 -ggdb3 -fsanitize=address -fno-omit-frame-pointer -fno-optimize-sibling-calls -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-implicit-function-declaration -Wno-error=format -Wno-error -Wno-error=maybe-uninitialized -Wno-error=parentheses",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -ggdb3 -fsanitize=address -fno-omit-frame-pointer -fno-optimize-sibling-calls -Wno-error=format -Wno-error -Wno-error=maybe-uninitialized -Wno-error=parentheses",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "asan_ubsan_debug_gcc",
      "description": "GCC Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "user_gcc_debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-O1 -ggdb3 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -fno-optimize-sibling-calls -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-implicit-function-declaration -Wno-error=format -Wno-error -Wno-error=maybe-uninitialized -Wno-error=parentheses",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -ggdb3 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -fno-optimize-sibling-calls -Wno-error=format -Wno-error -Wno-error=maybe-uninitialized -Wno-error=parentheses",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "debug_gcc_nounit",
      "description": "GCC Debug with all unit test options disabled",
      "inherits": [
        "user_no_unit_tests",
        "debug_gcc"
      ]
    },
    {
      "name": "release_gcc_nounit",
      "description": "GCC RelWithDebInfo with all unit test options disabled",
      "inherits": [
        "user_no_unit_tests",
        "release_gcc"
      ]
    },
    {
      "name": "debug_clang",
      "description": "Clang Debug with full debug information and frame pointers",
      "inherits": "user_clang",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD_LIBRARIES": "-latomic",
        "CMAKE_C_FLAGS": "-fcolor-diagnostics -fno-inline -Xclang -fno-validate-pch -Xclang -fno-pch-timestamp -Werror=unused-result -Wno-non-pod-varargs -Wno-c++11-narrowing -Wno-int-conversion -Wno-implicit-function-declaration -fno-omit-frame-pointer -Wno-inline-new-delete -Wno-unknown-warning-option",
        "CMAKE_CXX_FLAGS": "-fcolor-diagnostics -fno-inline -Xclang -fno-validate-pch -Xclang -fno-pch-timestamp -Werror=unused-result -Wno-non-pod-varargs -Wno-c++11-narrowing -Wno-int-conversion -Wno-implicit-function-declaration -fno-omit-frame-pointer -Wno-inline-new-delete -Wno-unknown-warning-option -fdelayed-template-parsing -isystem ${sourceDir}/.just/include",
        "CMAKE_C_FLAGS_DEBUG": "-O0 -ggdb3 -fdebug-macro -fno-inline",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -ggdb3 -fdebug-macro -fno-inline"
      }
    },
    {
      "name": "debug_clang_bare",
      "description": "Clang Debug with project defaults and no personal compiler flags or feature overrides",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_preset_${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_INSTALL_PREFIX": "$env{CUBRID}"
      }
    },
    {
      "name": "release_clang",
      "description": "Clang RelWithDebInfo with O2 optimization",
      "inherits": "user_clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fcolor-diagnostics -Xclang -fno-validate-pch -Xclang -fno-pch-timestamp -Wno-everything -Wno-non-pod-varargs -Wno-c++11-narrowing -Wno-int-conversion -Wno-implicit-function-declaration -Wno-unused-parameter",
        "CMAKE_CXX_FLAGS": "-fcolor-diagnostics -Xclang -fno-validate-pch -Xclang -fno-pch-timestamp -Wno-everything -Wno-non-pod-varargs -Wno-c++11-narrowing -Wno-int-conversion -Wno-implicit-function-declaration -Wno-unused-parameter -Wno-unused-parameter -fdelayed-template-parsing",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -finline-functions",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -finline-functions"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug_gcc",
      "configurePreset": "debug_gcc"
    },
    {
      "name": "release_gcc",
      "configurePreset": "release_gcc"
    },
    {
      "name": "asan_debug_gcc",
      "configurePreset": "asan_debug_gcc"
    },
    {
      "name": "asan_ubsan_debug_gcc",
      "configurePreset": "asan_ubsan_debug_gcc"
    },
    {
      "name": "debug_gcc_nounit",
      "configurePreset": "debug_gcc_nounit"
    },
    {
      "name": "release_gcc_nounit",
      "configurePreset": "release_gcc_nounit"
    },
    {
      "name": "debug_clang",
      "configurePreset": "debug_clang"
    },
    {
      "name": "debug_clang_bare",
      "configurePreset": "debug_clang_bare"
    },
    {
      "name": "release_clang",
      "configurePreset": "release_clang"
    }
  ]
}
