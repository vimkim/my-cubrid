set default-list
set minimum-version := "1.55.0"
set shell := ["sh", "-cu"]

# Worktree-local recipes live here and may depend on the initialized CUBRID
# development environment. Globally accessible launchers belong in
# cubrid-justfiles.

import '.just/compat.just'

# Preset-aware configure, build, install, and ctest workflows.
mod core '.just/core.just'

# Local database lifecycle, server control, csql, and cubrid.conf workflows.
mod db '.just/db.just'

# Work environment settings, resource allocation reports, and diagnostics.
mod workenv '.just/workenv.just'

# CTP shell-test workflows.
mod ctp '.just/ctp.just'

# Interactive debugger and core workflows.
mod debug '.just/debug.just'

# Formatting and build-tree maintenance workflows.
mod maint '.just/maint.just'

# Profiling and tracing workflows.
mod profile '.just/profile.just'

# GitHub
mod github '.just/github.just'

# Shared Out-of-row Overflow Storage workflows.
mod oos '.just/oos.just'

# Optional ticket or worktree-specific workflows.
mod? local 'local.just'

# Create a sibling worktree and same-named branch from the current HEAD.
worktree name:
    cubrid-worktree-add.sh "{{ name }}" "{{ name }}" HEAD

# Create a sibling worktree with a separately named branch based on an existing ref.
worktree-as name new_branch base:
    cubrid-worktree-add.sh "{{ name }}" "{{ new_branch }}" "{{ base }}"

# Prepare this worktree's personal build environment.
prepare: core::prepare

# Prepare this worktree with the default GCC debug preset.
prepare-debug-gcc: preset-debug-gcc prepare

# Configure the selected CMake preset.
configure: core::configure

# Set any valid CMake configure preset for this worktree.
preset mode: (core::preset-set mode)

# Select the commonly used GCC debug preset.
preset-debug-gcc: (core::preset-set "debug_gcc")

# Select the commonly used GCC release preset.
preset-release-gcc: (core::preset-set "release_gcc")

# Build artifacts and capture the complete log without installing.
build: core::build

# Install existing build artifacts when the installation is idle.
install: core::install

# Build and install; --stop-runtime explicitly stops services before installation.
[positional-arguments]
build-and-install *args:
    just core::build-and-install "$@"

# Configure and build artifacts without installing.
configure-build: core::configure core::build

# Configure, build and install the selected preset.
[positional-arguments]
configure-build-and-install *args: core::configure
    just core::build-and-install "$@"

# Run configured ctest tests while holding the runtime lock.
ctest: core::ctest

# Run the currently configured test suite. This is intentionally ctest-only.
test: core::test

# Build, then run the currently configured test suite.
build-test: core::build-test

# Build, install, then run the currently configured test suite.
build-and-install-test: core::build-and-install-test

# Build first, then wait up to `timeout` seconds for an idle installation and install.
build-and-install-wait timeout='300': (core::build-and-install-wait timeout)

# Wait up to `timeout` seconds for an idle runtime, then install.
install-wait timeout='300': (core::install-wait timeout)

# Show the live owners of the selected build and runtime locks.
locks: core::locks

# Show held coordinator locks in this user's runtime namespace.
locks-all: core::locks-all

# Export the selected lock status and live owners as JSON.
locks-json: core::locks-json

dwb-off:
    "${MY_CUBRID:-$HOME/my-cubrid}/bin/cubrid-build-coordinator.sh" runtime 300 -- ini.sh -s common "${CUBRID_CONF_FILE:-$CUBRID/conf/cubrid.conf}" double_write_buffer_size 0

dwb-get:
    "${MY_CUBRID:-$HOME/my-cubrid}/bin/cubrid-build-coordinator.sh" runtime 300 -- ini.sh -s common "${CUBRID_CONF_FILE:-$CUBRID/conf/cubrid.conf}" double_write_buffer_size

cubrid-pr-status:
    cubrid-pr-status

# Edit the selected installation's cubrid.conf in the terminal.
[no-cd]
[positional-arguments]
cubrid-conf-tui *args:
    cubrid-conf-tui "$@"
