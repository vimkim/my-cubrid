#!/usr/bin/env bash
set -euo pipefail

expected_args=(
  pr list
  --repo CUBRID/CUBRID
  --head topic
  --state open
  --json baseRefName
  --jq '.[0].baseRefName // empty'
)

actual="$(printf '<%s>' "$@")"
expected="$(printf '<%s>' "${expected_args[@]}")"

if [[ "$actual" != "$expected" ]]; then
  printf 'unexpected gh arguments: %s\n' "$actual" >&2
  exit 64
fi

if [[ -n "${FAKE_GH_ERROR:-}" ]]; then
  printf '%s\n' "$FAKE_GH_ERROR" >&2
  exit 1
fi

printf '%s\n' "${FAKE_PR_BASE:-}"
